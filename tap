local skillGroup=addSection("Tapping","Skill Tree","Right")
toggle(skillGroup,"Unlock Affordable Skills","AutoSkills",false)
local skillCfg=config({"Shared","Progression","SkillTreeConfig"})
local skillNodes={}
local function collectSkill(node,depth)
    if depth>5 or type(node)~="table" then return end
    for k,v in pairs(node) do
        if type(v)=="table" then
            if type(v.Name)=="string" then skillNodes[v.Name]=true end
            collectSkill(v,depth+1)
        end
    end
end
collectSkill(skillCfg,0)
Hub.RegisterFeature("AutoSkills",function()
    if not Hub.Flags.AutoSkills then return end
    local d=data()
    local current=getSub(d,"SkillTree","Unlocked") or {}
    for name in pairs(skillNodes) do
        if not alive or not Hub.Flags.AutoSkills then break end
        if current[name]~=true then
            local ok,r=invoke("SkillTreeService","Unlock",{Name=name})
            if ok and type(r)=="table" and r.Success then
                Hub.Counters.Skills=(Hub.Counters.Skills or 0)+1
            end
            task.wait(.35)
        end
    end
end,9)

