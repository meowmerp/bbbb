    Version = VERSION,
    Flags = { AutoTap = false, AutoClicker = false, AutoRebirth = false, TapRate = 8, RebirthEvery = 2 },
    Counters = { Taps = 0, RebirthRequests = 0 },
    Features = {},
    Status = "Starting",
}
env.__TapSimulatorCustomHub = Hub
local function disconnect()
    if not alive then return end
    alive = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    if Hub.Flags.AutoClicker then
        local re = ReplicatedStorage:FindFirstChild("RemoteServices")
        local service = re and re:FindFirstChild("AutoClickService")
        local events = service and service:FindFirstChild("RE")
        local remote = events and events:FindFirstChild("AutoClickRequested")
        if remote then pcall(function() remote:FireServer({ Enabled = false }) end) end
    end
    if Hub.Window then pcall(function() Hub.Window:Destroy() end) end
    Hub.Status = "Stopped"
end
env.__TapSimulatorCustomHubStop = disconnect

local function remote(service, name)
    local root = ReplicatedStorage:FindFirstChild("RemoteServices")
    local svc = root and root:FindFirstChild(service)
    local re = svc and svc:FindFirstChild("RE")
    return re and re:FindFirstChild(name)
end
local function fire(service, name, payload)
    local r = remote(service, name)
    if not r then return false, "Missing " .. service .. "." .. name end
    local ok, err = pcall(function() r:FireServer(payload) end)
    return ok, err
end

-- Optional player-data reader. Unlike writing to a client-side Data table,
-- only the game's legitimate request remotes can change your server data.
local controller
local function data()
    if controller == nil then
        local c = ReplicatedStorage:FindFirstChild("Controllers")
        local core = c and c:FindFirstChild("Core")
        local module = core and core:FindFirstChild("DataController")
        if module then
            local ok, value = pcall(require, module)
            controller = ok and value or false
        else
            return nil
        end
    end
    if not controller then return nil end
    local ok, replica = pcall(function()
        if type(controller.GetReplica) == "function" then return controller:GetReplica() end
        if type(controller.Get) == "function" then return controller:Get() end
    end)
    return ok and replica and replica.Data or nil
end
Hub.Data = data
Hub.Fire = fire
Hub.Remote = remote
local function invoke(service, name, ...)
    local root = ReplicatedStorage:FindFirstChild("RemoteServices")
    local svc = root and root:FindFirstChild(service)
    local rf = svc and svc:FindFirstChild("RF")
    local rem = rf and rf:FindFirstChild(name)
    if not rem then return false, "Missing " .. service .. "." .. name end
    local args = table.pack(...)
    local done, result = false, nil
    task.spawn(function()
        result = table.pack(pcall(function()
            return rem:InvokeServer(table.unpack(args, 1, args.n))
        end))
        done = true
    end)
    local deadline = os.clock() + 8
    while alive and not done and os.clock() < deadline do task.wait(.05) end
    if not done then return false, "timeout" end
    return table.unpack(result, 1, result.n)
end
Hub.Invoke = invoke


