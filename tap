local TAP_SEQUENCE_KEY = "__CustomTapSimulatorSequence"
local sequence = tonumber(env[TAP_SEQUENCE_KEY]) or 0
local nextTap = 0
Hub.RegisterFeature("AutoTap", function()
    if not Hub.Flags.AutoTap then return end
    local now = os.clock()
    if now < nextTap then return end
    nextTap = now + (1 / math.clamp(tonumber(Hub.Flags.TapRate) or 8, 1, 10))
    sequence += 1
    env[TAP_SEQUENCE_KEY] = sequence
    local ok, err = fire("TapService", "TapRequested", { Auto = false, ClientSequence = sequence, Source = "button" })
    if ok then
        Hub.Counters.Taps += 1
        Hub.Status = "Auto tapping"
    else
        Hub.Status = tostring(err)
    end
end, 0.05)

local lastClicker
Hub.RegisterFeature("AutoClicker", function()
    if lastClicker == Hub.Flags.AutoClicker then return end
    local ok, err = fire("AutoClickService", "AutoClickRequested", { Enabled = Hub.Flags.AutoClicker })
    if ok then lastClicker = Hub.Flags.AutoClicker else Hub.Status = tostring(err) end
end, 0.5)

local nextRebirth = 0
Hub.RegisterFeature("AutoRebirth", function()
    if not Hub.Flags.AutoRebirth then return end
    if os.clock() < nextRebirth then return end
    nextRebirth = os.clock() + math.max(1, tonumber(Hub.Flags.RebirthEvery) or 3)
    local ok, err = fire("RebirthService", "RebirthRequested", { Index = 1 })
    if ok then Hub.Counters.RebirthRequests += 1 else Hub.Status = tostring(err) end
end, 0.5)

-- EXTENDED FEATURES: independent implementations using the game's request API.
local function addSection(tab, name, side) return Hub.NewGroup(tab, name, side) end
local function toggle(group, label, flag, enabled) return Hub.AddToggle(group,label,flag,enabled or false) end
local function slider(group, label, flag, minimum, maximum, initial)
    return Hub.AddSlider(group,label,flag,minimum,maximum,1,initial)
end
local function button(group, name, fn)
    group:CreateButton({Name=name,Callback=function()
        local ok,err=pcall(fn)
        if not ok then Hub.Status=tostring(err) warn("[Tap Simulator]",name,err) end
    end})
end
local function getSub(root, ...)
    local t=root
    for _,key in ipairs({...}) do t=type(t)=="table" and t[key] or nil end
    return t
end
local function config(path)
    local node=ReplicatedStorage
    for _,part in ipairs(path) do node=node and node:FindFirstChild(part) end
    if not (node and node:IsA("ModuleScript")) then return nil end
    local ok,res=pcall(require,node)
    return ok and type(res)=="table" and res or nil
end
local function iterateOrder(conf,fallback)
    if type(conf)=="table" and type(conf.Order)=="table" and #conf.Order>0 then return conf.Order end
    return fallback
end
local function requestOk(ok,reply)
    return ok and (type(reply)~="table" or reply.Success~=false)
end

-- General character / movement helpers
local function rootPart()
    local char=player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function goToModel(model)
    local hrp=rootPart()
    if not (hrp and model) then return false end
    local ok,pivot=pcall(function() return model:GetPivot() end)
    if not ok then return false end
    hrp.AssemblyLinearVelocity=Vector3.zero
    hrp.CFrame=CFrame.new(pivot.Position+Vector3.new(0,0,5),pivot.Position)
    return true
end

