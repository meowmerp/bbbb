-- Load existing mob list
if HAS_READ and HAS_WRITE and isfile(MOB_FILE) then
    local ok, data = pcall(readfile, MOB_FILE)
    if ok and type(data) == "string" then
        for line in data:gmatch("[^\r\n]+") do
            if line ~= "" then
                knownMobs[line] = true
                knownMobsCount = knownMobsCount + 1
            end
        end
        print(string.format("[FarmAssist] Loaded %d mobs from %s", knownMobsCount, MOB_FILE))
    end
end

local function isBlacklistedName(name)
    for _, n in ipairs(PROP_BLACKLIST) do
        if name == n then return true end
    end
    return false
end

local function saveMobName(name)
    if not name or name == "" or name == "none" then return end
    if isBlacklistedName(name) then return end
    if knownMobs[name] then return end

    knownMobs[name] = true
    knownMobsCount = knownMobsCount + 1
    lastMobSeen = name

    if not HAS_WRITE then
        print("[MOB SAVED-INTERNAL] " .. name .. " (executor cannot write files)")
        return
    end

    local wroteOk = false

    if HAS_APPEND and HAS_READ and isfile(MOB_FILE) then
        wroteOk = pcall(appendfile, MOB_FILE, name .. "\n")
    end

    if not wroteOk then
        wroteOk = pcall(function()
            local names = {}
            for m in pairs(knownMobs) do names[#names + 1] = m end
            table.sort(names)
            writefile(MOB_FILE, table.concat(names, "\n") .. "\n")
        end)
    end

    if wroteOk then
        print("[MOB SAVED] " .. name)
    else
        warn("[MOB SAVED-INTERNAL] " .. name .. " (file write failed)")
    end
end

local function extractMobName(line)
    local name = line:match("nearest enemy:%s*([%w_%-]+)")
    if not name then
        name = line:match("nearest enemy%s+([%w_%-]+)")
    end
    return name
end

