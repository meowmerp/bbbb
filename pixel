function UI.multi(box, name, flag, options)
    box:CreateDropdown({
        Name = name,
        Options = options,
        MultipleOptions = true,
        CurrentOption = table.clone(Flags[flag]),
        Flag = flag,
        Callback = function(option)
            Flags[flag] = listOf(option)
        end,
    })
end

