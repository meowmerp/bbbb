local FarmAssist = { active = false, stop = nil }
function FarmAssist.start()
    if FarmAssist.active or unloaded then return end
    FarmAssist.active = true
    local LogService = game:GetService("LogService")
    local lp = LocalPlayer
    -- Fall Freeze (original v2 values, unchanged)
    local FALL_SPEED   = -40
    local MOVE_RELEASE = 6
    local SETTLE_AFTER = 2.5
    local RETRY_AFTER  = 5
    local RAY_UP       = 80
    local RAY_DOWN     = 400
    local FREEZE_LOG_LINES = 5
    -- Fallback: if settleOnFloor gets no hit for this many tries in a row,
    -- teleport to the last mob we saw (exact position, no offset).
    local FALLBACK_AFTER_TRIES = 5
    local FALLBACK_MAX_AGE     = 60
    
    -- Activity Log
    local TELEPORT_DIST = 12
    local STUCK_SECONDS = 10
    local STUCK_MOVE    = 1
    local LOG_BUFFER_MAX = 1000
    local MOB_FILE       = "mob_list.txt"
    local IGNORE = {
        "render_class_body_particles",
        "Stack Begin",
        "Stack End",
        "will be suppressed",
    }
    
    -- Auto-recover
    local AUTO_RECOVER            = true
    local STUCK_TELEPORT_RANGE    = 50
    local STUCK_TELEPORT_MAXDIST  = 2000
    local STUCK_TELEPORT_COOLDOWN = 15
    local STARTUP_GRACE           = 30
    local RECOVER_LOG_SILENCE     = 6
    local GOODPOS_MIN_DIST        = 100
    local GOODPOS_MAX_AGE         = 120
    local PROP_BLACKLIST = {
        "morvik_intro_human",
    }
    
    -- File I/O capability check
    local HAS_READ   = (type(readfile) == "function") and (type(isfile) == "function")
    local HAS_WRITE  = (type(writefile) == "function")
    local HAS_APPEND = (type(appendfile) == "function")
    
    -- STATE
    local killed = false
    
    local freezeEnabled = true
    local anchored, lastPos, frozenAt = false, nil, 0
    local catches, settles = 0, 0
    local freezeLines = {}
    local failedSettleTries = 0
    
    local logRunning     = true
    local logBuffer      = {}
    local logT0          = os.clock()
    local logLineCount   = 0
    local logTotalLines  = 0
    local logWrittenLines = 0
    
    local knownMobs      = {}
    local knownMobsCount = 0
    
    local lastAutoRecover  = 0
    local autoRecovers     = 0
    local lastGoodPos      = nil
    local lastGoodTime     = 0
    local lastActivityTime = os.clock()
    
    -- Last mob we were near, used as a fallback if settleOnFloor gets no hit.
    local lastMobPos  = nil
    local lastMobTime = 0
    
    local wLastPos, wLastMoveCheckPos, wLastMoveTime = nil, nil, os.clock()
    local wLastStuckLog = 0
    
    local conns = {}
    
    if not HAS_WRITE then
        -- File output unavailable; keep mob names in memory.
    end
    
    -- Load existing mob list
    if HAS_READ and HAS_WRITE and isfile(MOB_FILE) then
        local ok, data = pcall(readfile, MOB_FILE)
        if ok and type(data) == "string" then
            for line in data:gmatch("[^\r\n]+") do
                if line ~= "" then
                    knownMobs[line] = true
                    knownMobsCount = knownMobsCount + 1
                end
            end
            -- Mob list loaded silently.
        end
    end
    
    local function isBlacklistedName(name)
        for _, n in ipairs(PROP_BLACKLIST) do
            if name == n then return true end
        end
        return false
    end
    
    local function saveMobName(name)
        if not name or name == "" or name == "none" then return end
        if isBlacklistedName(name) then return end
        if knownMobs[name] then return end
    
        knownMobs[name] = true
        knownMobsCount = knownMobsCount + 1
    
        if not HAS_WRITE then
            -- Retain the mob name in knownMobs without console output.
            return
        end
    
        local wroteOk = false
    
        if HAS_APPEND and HAS_READ and isfile(MOB_FILE) then
            wroteOk = pcall(appendfile, MOB_FILE, name .. "\n")
        end
    
        if not wroteOk then
            wroteOk = pcall(function()
                local names = {}
                for m in pairs(knownMobs) do names[#names + 1] = m end
                table.sort(names)
                writefile(MOB_FILE, table.concat(names, "\n") .. "\n")
            end)
        end
    
        -- Mob name is retained internally, and persisted when file I/O succeeds.
    end
    
    local function extractMobName(line)
        local name = line:match("nearest enemy:%s*([%w_%-]+)")
        if not name then
            name = line:match("nearest enemy%s+([%w_%-]+)")
        end
        return name
    end
    
    local function getRoot()
        local c = lp.Character
        return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end
    
    local function fmtV(v)
        return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
    end
    
    local function pushFreezeLog(msg)
        freezeLines[#freezeLines + 1] = string.format("%s %s", os.date("%H:%M:%S"), msg)
        while #freezeLines > FREEZE_LOG_LINES do table.remove(freezeLines, 1) end
        -- Keep fall events in the internal ring buffer, not executor output.
    end
    
    local function isBlacklisted(model)
        if not model then return true end
        for _, n in ipairs(PROP_BLACKLIST) do
            if model.Name == n then return true end
        end
        return false
    end
    
    -- FALL FREEZE LOGIC (original raycast, fallback added)
    local function release(r)
        if r then r.Anchored = false end
        anchored = false
        failedSettleTries = 0
    end
    
    local function settleOnFloor(r)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { lp.Character }
        local origin = r.Position + Vector3.new(0, RAY_UP, 0)
        local hit = workspace:Raycast(origin, Vector3.new(0, -(RAY_UP + RAY_DOWN), 0), params)
        if hit then
            r.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3.2, 0)) * (r.CFrame - r.CFrame.Position)
            r.AssemblyLinearVelocity = Vector3.zero
            settles = settles + 1
            failedSettleTries = 0
            pushFreezeLog(string.format("floor: %s y=%.1f", hit.Instance.Name, hit.Position.Y))
            return true
        end
    
        failedSettleTries = failedSettleTries + 1
    
        if failedSettleTries >= FALLBACK_AFTER_TRIES then
            if lastMobPos and (os.clock() - lastMobTime) < FALLBACK_MAX_AGE then
                r.CFrame = CFrame.new(lastMobPos)
                r.AssemblyLinearVelocity = Vector3.zero
                settles = settles + 1
                failedSettleTries = 0
                pushFreezeLog(string.format(
                    "no floor after %d tries -> teleported to last mob %s (%.0fs ago)",
                    FALLBACK_AFTER_TRIES, fmtV(lastMobPos), os.clock() - lastMobTime))
                return true
            else
                pushFreezeLog(string.format(
                    "no floor after %d tries, but no recent mob to fall back to",
                    failedSettleTries))
                return false
            end
        end
    
        pushFreezeLog(string.format("no floor under you, staying frozen (try %d/%d)",
            failedSettleTries, FALLBACK_AFTER_TRIES))
        return false
    end
    
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if killed or not freezeEnabled then return end
        local r = getRoot()
        if not r then
            anchored, lastPos = false, nil
            return
        end
    
        local pos = r.Position
        if anchored then
            if lastPos and (pos - lastPos).Magnitude > MOVE_RELEASE then
                release(r)
                pushFreezeLog("released (farm moved you)")
            elseif os.clock() - frozenAt >= SETTLE_AFTER then
                if settleOnFloor(r) then
                    release(r)
                else
                    frozenAt = os.clock() + RETRY_AFTER
                end
            end
        elseif r.AssemblyLinearVelocity.Y < FALL_SPEED then
            r.AssemblyLinearVelocity = Vector3.zero
            r.Anchored = true
            anchored = true
            frozenAt = os.clock()
            failedSettleTries = 0
            catches = catches + 1
            pushFreezeLog(string.format("caught fall #%d at y=%.1f", catches, pos.Y))
        end
        lastPos = r.Position
    end)
    
    conns[#conns + 1] = lp.CharacterAdded:Connect(function()
        anchored, lastPos = false, nil
        failedSettleTries = 0
        pushFreezeLog("character respawned")
    end)
    
    -- ACTIVITY LOG LOGIC
    local NON_ACTIVITY_TAGS = { ["STUCK?"] = true, ["RECOVER"] = true, ["INFO"] = true }
    
    local function logLine(tag, msg)
        local line = string.format("[%7.2f] [%s] %s", os.clock() - logT0, tag, msg)
        -- Store activity in the internal buffer/file without printing.
    
        logTotalLines = logTotalLines + 1
        logBuffer[#logBuffer + 1] = line
        while #logBuffer > LOG_BUFFER_MAX do
            table.remove(logBuffer, 1)
        end
    
        logLineCount = logLineCount + 1
        if not NON_ACTIVITY_TAGS[tag] then
            lastActivityTime = os.clock()
        end
    
        local mobName = extractMobName(line)
        if mobName then saveMobName(mobName) end
    end
    
    local function flushLog()
        if not HAS_WRITE then return end
        pcall(function()
            if HAS_APPEND and isfile("activity_log.txt") and logTotalLines > logWrittenLines then
                local firstInBuffer = logTotalLines - #logBuffer + 1
                local fromIdx = (logWrittenLines + 1) - firstInBuffer + 1
                if fromIdx < 1 then fromIdx = 1 end
                if fromIdx <= #logBuffer then
                    local chunk = {}
                    for i = fromIdx, #logBuffer do
                        chunk[#chunk + 1] = logBuffer[i]
                    end
                    appendfile("activity_log.txt", table.concat(chunk, "\n") .. "\n")
                end
                logWrittenLines = logTotalLines
            else
                writefile("activity_log.txt", table.concat(logBuffer, "\n"))
            end
        end)
    end
    
    local enemyCache, lastScan = {}, 0
    local function scanEnemies()
        if os.clock() - lastScan < 1.5 then return enemyCache end
        lastScan = os.clock()
        local list = {}
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") and d.Health > 0 then
                local model = d.Parent
                if model and model ~= lp.Character
                    and not Players:GetPlayerFromCharacter(model) then
                    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if root then list[#list + 1] = { model = model, hum = d, root = root } end
                end
            end
        end
        enemyCache = list
        return list
    end
    
    local function nearestEnemy(pos)
        local best, bestD
        for _, e in ipairs(scanEnemies()) do
            if e.root and e.root.Parent then
                local d = (e.root.Position - pos).Magnitude
                if not bestD or d < bestD then best, bestD = e, d end
            end
        end
        return best, bestD
    end
    
    local function nearestValidMob(pos)
        local best, bestD
        for _, e in ipairs(scanEnemies()) do
            if e.root and e.root.Parent and not isBlacklisted(e.model) then
                local d = (e.root.Position - pos).Magnitude
                if not bestD or d < bestD then best, bestD = e, d end
            end
        end
        return best, bestD
    end
    
    conns[#conns + 1] = LogService.MessageOut:Connect(function(msg, mtype)
        if killed or not logRunning then return end
        if mtype == Enum.MessageType.MessageOutput
            or mtype == Enum.MessageType.MessageInfo then return end
        for _, s in ipairs(IGNORE) do
            if msg:find(s, 1, true) then return end
        end
        logLine(mtype == Enum.MessageType.MessageError and "ERROR" or "WARN", msg)
    end)
    
    conns[#conns + 1] = RunService.Heartbeat:Connect(function()
        if killed or not logRunning then return end
        local root, hum = getRoot()
        if not root then
            wLastPos = nil
            return
        end
    
        local pos = root.Position

        -- AutoFarm and Farm Assist share target state. When AutoFarm has no
        -- enemies for several seconds, return to its last confirmed combat
        -- position instead of assuming that standing still means stuck.
        local now = os.clock()
        local noTargetFor = Game.noEnemySince and (now - Game.noEnemySince) or 0
        if Flags.AutoFarm and not Game.goal and not Game.crate
            and not Game.gatherPos and not Game.retreating
            and not root.Anchored and hum and hum.Health > 0
            and noTargetFor >= 8
            and now - lastAutoRecover >= STUCK_TELEPORT_COOLDOWN
            and Game.lastFarmCFrame and Game.lastFarmSeenAt
            and now - Game.lastFarmSeenAt <= 180 then
            local saved = Game.lastFarmCFrame
            if (pos - saved.Position).Magnitude >= 8 then
                root.CFrame = saved
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                lastAutoRecover = now
                autoRecovers = autoRecovers + 1
                wLastPos = saved.Position
                wLastMoveCheckPos = saved.Position
                wLastMoveTime = now
                logLine("RECOVER", string.format(
                    "AutoFarm found no targets for %.0fs -> returned to saved farming position %s | attempt #%d",
                    noTargetFor, fmtV(saved.Position), autoRecovers))
                -- Allow combat to rescan before another recovery attempt.
                Game.noEnemySince = now
                return
            else
                -- Already near the saved location; don't spam teleports.
                Game.noEnemySince = now
            end
        end
        if Game.goal and Game.holding then
            lastActivityTime = os.clock()
        end
    
        if wLastPos and (pos - wLastPos).Magnitude >= TELEPORT_DIST then
            local e, d = nearestEnemy(pos)
            logLine("TELEPORT", string.format("%s -> %s (%.0f studs) | nearest enemy: %s (%.1f away)",
                fmtV(wLastPos), fmtV(pos), (pos - wLastPos).Magnitude,
                e and e.model.Name or "none", d or 0))
        end
        wLastPos = pos
    
        local gm, gd = nearestValidMob(pos)
        if gm and gd < GOODPOS_MIN_DIST then
            lastGoodPos  = pos
            lastGoodTime = os.clock()
        end
    
        -- Remember the last mob we were fighting, for the freeze fallback.
        if gm and gd and gd < 40 then
            lastMobPos  = gm.root.Position
            lastMobTime = os.clock()
        end
    
        if not wLastMoveCheckPos or (pos - wLastMoveCheckPos).Magnitude > STUCK_MOVE then
            wLastMoveCheckPos, wLastMoveTime = pos, os.clock()
        elseif os.clock() - wLastMoveTime >= STUCK_SECONDS
            and os.clock() - wLastStuckLog > 5
            and os.clock() - lastActivityTime >= RECOVER_LOG_SILENCE then
            wLastStuckLog = os.clock()
    
            local e, d = nearestEnemy(pos)
            local info = string.format(
                "not moving for %ds | pos %s | state %s | anchored %s | WalkSpeed %s | health %s",
                STUCK_SECONDS, fmtV(pos),
                hum and tostring(hum:GetState()) or "?",
                tostring(root.Anchored),
                hum and tostring(hum.WalkSpeed) or "?",
                hum and string.format("%.0f/%.0f", hum.Health, hum.MaxHealth) or "?")
            if e then
                info = info .. string.format(" | nearest enemy %s %.1f studs away, hp %.0f, parent %s",
                    e.model.Name, d, e.hum.Health,
                    e.model.Parent and e.model.Parent.Name or "nil")
            else
                info = info .. " | NO living enemies found in workspace"
            end
            logLine("STUCK?", info)
    
            if AUTO_RECOVER and not Flags.AutoFarm then
                local sinceStart = os.clock() - logT0
                local sinceLast  = os.clock() - lastAutoRecover
    
                if sinceStart < STARTUP_GRACE then
                    logLine("RECOVER", string.format(
                        "skipped (startup grace, %.1fs left)", STARTUP_GRACE - sinceStart))
                elseif sinceLast < STUCK_TELEPORT_COOLDOWN then
                    logLine("RECOVER", string.format(
                        "skipped (cooldown, %.1fs left)", STUCK_TELEPORT_COOLDOWN - sinceLast))
                else
                    local mob, mobDist = nearestValidMob(pos)
                    if not mob then
                        if lastGoodPos and (os.clock() - lastGoodTime) < GOODPOS_MAX_AGE then
                            root.CFrame = CFrame.new(lastGoodPos + Vector3.new(0, 3, 0))
                            root.AssemblyLinearVelocity = Vector3.zero
                            lastAutoRecover = os.clock()
                            autoRecovers = autoRecovers + 1
                            logLine("RECOVER", string.format(
                                "no mobs nearby -> returned to last good spot %s (%.0fs ago) | attempt #%d",
                                fmtV(lastGoodPos), os.clock() - lastGoodTime, autoRecovers))
                        else
                            logLine("RECOVER", "no valid mob and no recent good position")
                        end
                    elseif mobDist > STUCK_TELEPORT_MAXDIST then
                        logLine("RECOVER", string.format(
                            "skipped (nearest valid mob %s too far: %.0f > %d)",
                            mob.model.Name, mobDist, STUCK_TELEPORT_MAXDIST))
                    else
                        local mobPos = mob.root.Position
                        local dir = Vector3.new(pos.X - mobPos.X, 0, pos.Z - mobPos.Z)
                        if dir.Magnitude < 0.1 then
                            dir = Vector3.new(1, 0, 0)
                        else
                            dir = dir.Unit
                        end
                        local targetPos = Vector3.new(
                            mobPos.X + dir.X * STUCK_TELEPORT_RANGE,
                            mobPos.Y + 3,
                            mobPos.Z + dir.Z * STUCK_TELEPORT_RANGE)
                        root.CFrame = CFrame.new(targetPos)
                        root.AssemblyLinearVelocity = Vector3.zero
                        lastAutoRecover = os.clock()
                        autoRecovers = autoRecovers + 1
                        logLine("RECOVER", string.format(
                            "teleported to %s from %s (%.0f studs, target %s) | attempt #%d",
                            fmtV(targetPos), mob.model.Name, mobDist,
                            mob.model.Name, autoRecovers))
                    end
                end
            end
        end
    end)
    
    local function watchChar(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        conns[#conns + 1] = hum.StateChanged:Connect(function(_, new)
            if not killed and logRunning then logLine("STATE", tostring(new)) end
        end)
        conns[#conns + 1] = hum.Died:Connect(function()
            if not killed and logRunning then logLine("EVENT", "You died") end
        end)
    end
    if lp.Character then task.spawn(watchChar, lp.Character) end
    conns[#conns + 1] = lp.CharacterAdded:Connect(function(c)
        if logRunning then logLine("EVENT", "Character respawned") end
        task.spawn(watchChar, c)
    end)
    
    task.spawn(function()
        while not killed do
            task.wait(5)
            if killed then break end
            flushLog()
        end
    end)
    

    local function stop()
        if killed then return end
        killed = true
        freezeEnabled = false
        logRunning = false
        release(getRoot())
        for _, conn in ipairs(conns) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(conns)
        flushLog()
        FarmAssist.active = false
        FarmAssist.stop = nil
        -- Disabled silently.
    end
    FarmAssist.stop = stop
    -- Enabled silently.
end

function FarmAssist.set(enabled)
    if enabled then
        FarmAssist.start()
    elseif FarmAssist.stop then
        FarmAssist.stop()
    end
end

local function unloadScript()
    if unloaded then
        return
    end
    pcall(function()
        for _, key in ipairs(FEATURE_KEYS) do
            Flags[key] = false
        end
        stopCombat()
        Fish.set(false)
        Esp.clear()
        HitboxEsp.clear()
        Shell.setWalkSpeedEnabled(false)
        Shell.setInfJump(false)
        Shell.setNoClip(false)
        Shell.setInstantProximityPrompt(false)
        Shell.setFly(false)
        Shell.setNoGameplayPaused(false)
        Shell.setAutoReconnect(false)
        Shell.setDisable3D(false)
        Shell.setFpsBoost(false)
        Shell.setAntiAfk(false)
    end)
    FarmAssist.set(false)
    unloaded = true
    table.clear(workers)
    for _, conn in ipairs(connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(connections)
    if Window then
        local window = Window
        Window = nil
        pcall(function()
            window:Destroy()
        end)
    end
    local env = type(getgenv) == "function" and getgenv() or nil
    if env and env[NAMESPACE] == unloadScript then
        env[NAMESPACE] = nil
    end
end

if type(getgenv) == "function" then
    getgenv()[NAMESPACE] = unloadScript
end

