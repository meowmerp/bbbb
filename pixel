local Fish: any = { at = 0, rodAt = 0, findAt = 0 }

function Fish.mods()
    if not Fish.intents then
        Fish.intents = require(Src.client.fishing_intents)
        Fish.config = require(Src.configs.fishing_config)
        Fish.stash = require(Src.stash_capacity_util)
    end
    return Fish.intents
end

function Fish.findState()
    if Fish.state then
        return Fish.state
    end
    local list = Fish.candidates
    if list then
        for _, v in ipairs(list) do
            if v.phase ~= "idle" then
                Fish.state = v
                Fish.candidates = nil
                return v
            end
        end
    end
    if not list or os.clock() >= Fish.findAt then
        Fish.findAt = os.clock() + 5
        list = {}
        for _, v in ipairs(getgc(true)) do
            if type(v) == "table" and rawget(v, "bubble_index") ~= nil and rawget(v, "toast_signature") ~= nil and rawget(v, "fill_direction") ~= nil then
                if v.phase ~= "idle" then
                    Fish.state = v
                    Fish.candidates = nil
                    return v
                end
                table.insert(list, v)
            end
        end
        Fish.candidates = list
    end
    if #list == 1 then
        Fish.state = list[1]
        Fish.candidates = nil
        return list[1]
    end
    return list[1] and { phase = "idle", auto = false } or nil
end

function Fish.step()
    if not Ecs.ready() then
        return
    end
    local me = Ecs.me()
    if not me or Ecs.has(me, G.C.Dead) then
        Game.fishStatus = "Waiting for character"
        return
    end
    local intents = Fish.mods()
    local now = os.clock()
    if not Ecs.has(me, G.C.RodHeld) then
        if Flags.FishAutoRod and now - Fish.rodAt > 3 then
            Fish.rodAt = now
            G.net.toggle_rod.fire(now)
        end
        Game.fishStatus = "Hold your rod"
        return
    end
    local s = Fish.findState()
    if not s then
        Game.fishStatus = "Fishing state not found"
        return
    end
    local data = Ecs.get(me, G.C.Fishing)
    if s.phase == "idle" and data and Fish.stash.is_full(data) then
        if s.auto then
            intents.auto_off:Fire(now)
        end
        Game.fishStatus = "Stash full"
        return
    end
    if Flags.FishMode == "Game Auto" then
        if not s.auto and now - Fish.at >= 1 then
            Fish.at = now
            intents.auto_on:Fire(now)
        end
        Game.fishStatus = "Game auto: " .. tostring(s.phase)
        return
    end
    if s.auto then
        intents.auto_off:Fire(now)
    end
    local phase = s.phase
    Game.fishStatus = tostring(phase)
    if phase == "idle" then
        if now < (s.error_until or 0) then
            Game.fishStatus = "Cast denied (stash full or bad spot)"
            return
        end
        if now - Fish.at >= Flags.FishCastDelay then
            Fish.at = now
            Fish.casts = (Fish.casts or 0) + 1
            if Fish.casts > 3 then
                Fish.casts = 0
                Fish.state = nil
            end
            Fish.charging = true
            G.input.attack:Fire(now)
        end
    elseif phase == "charging" then
        Fish.casts = 0
        local rod = data and Fish.config.rods[data.equipped_rod]
        local range = rod and rod.range or 25
        if Fish.charging and (s.charge_distance or 0) >= range * Flags.FishCastPower / 100 then
            Fish.charging = false
            G.input.attack_up:Fire(now)
        end
        if s.valid == false then
            Game.fishStatus = "Face water to cast"
        end
    elseif phase == "bubbles" then
        if not s.holding then
            if (s.progress or 0) <= 0 and now - Fish.at >= 0.15 then
                Fish.at = now
                intents.bubble_down:Fire(now)
            end
        elseif s.fill_direction == 1 and s.direction_changes == 0 and s.progress >= 0.93 then
            intents.bubble_up:Fire(now)
        end
    elseif phase == "reel" then
        if now - Fish.at >= Flags.FishReelDelay then
            Fish.at = now
            intents.reel_press:Fire(now)
        end
    else
        Fish.charging = false
    end
end

function Fish.set(enabled)
    if Fish.conn then
        Fish.conn:Disconnect()
        Fish.conn = nil
    end
    if enabled then
        Fish.conn = track(RunService.RenderStepped:Connect(function()
            local ok, err = pcall(Fish.step)
            if not ok then
                warn("[PixelBlade] AutoFish: " .. tostring(err))
            end
        end))
    else
        local s = Fish.state
        if s and s.auto and Fish.intents then
            pcall(function()
                Fish.intents.auto_off:Fire(os.clock())
            end)
        end
        if Fish.charging then
            Fish.charging = false
            pcall(function()
                G.input.attack_up:Fire(os.clock())
            end)
        end
        Game.fishStatus = "Idle"
    end
end

