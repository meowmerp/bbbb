local function readFlag(name, default)
    local entry = Library and Library.Flags and Library.Flags[name]
    if entry == nil then
        return default
    end
    if type(entry) == "table" then
        if type(entry.Get) == "function" then
            local ok, value = pcall(entry.Get, entry)
            if ok then
                return value
            end
        end
        if entry.Value ~= nil then
            return entry.Value
        end
        return default
    end
    return entry
end

local function firstOption(option)
    if typeof(option) == "table" then
        return option[1]
    end
    return option
end

local function listOf(value)
    local out = {}
    if type(value) == "table" then
        for _, v in ipairs(value) do
            table.insert(out, v)
        end
    end
    return out
end

local function getRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if humanoid and humanoid.Health <= 0 then
        return nil, nil
    end
    return humanoid, root
end

local function startWorker(key, interval, step)
    local token = {}
    workers[key] = token
    task.spawn(function()
        while workers[key] == token and not unloaded do
            local ok, err = pcall(step)
            if not ok then
                warn("[PixelBlade] " .. key .. ": " .. tostring(err))
            end
            task.wait(interval)
        end
    end)
end

local function stopWorker(key)
    workers[key] = nil
end

local function setWorker(key, enabled, interval, step)
    if enabled then
        if not workers[key] then
            startWorker(key, interval, step)
        end
    else
        stopWorker(key)
    end
end

local Ecs: any = {}

function Ecs.find()
    local world, state
    for _, v in ipairs(getgc(true)) do
        if type(v) == "table" then
            if not state and rawget(v, "local_player_entity") ~= nil and rawget(v, "replicator") ~= nil then
                state = v
            elseif not world and type(rawget(v, "archetypes")) == "table" and rawget(v, "entity_index") ~= nil then
                world = v
            end
            if world and state then
                break
            end
        end
    end
    Ecs.world, Ecs.state = world, state
    return world ~= nil and state ~= nil
end

function Ecs.ready()
    if Ecs.world and Ecs.state then
        return true
    end
    if Ecs.nextFind and os.clock() < Ecs.nextFind then
        return false
    end
    Ecs.nextFind = os.clock() + 5
    return Ecs.find()
end

function Ecs.get(entity, component)
    local ok, value = pcall(Ecs.world.get, Ecs.world, entity, component)
    return ok and value or nil
end

function Ecs.has(entity, component)
    local ok, value = pcall(Ecs.world.has, Ecs.world, entity, component)
    return ok and value == true
end

function Ecs.me()
    return Ecs.state and Ecs.state.local_player_entity
end

function Ecs.each(tagComponent, fn)
    local ok, err = pcall(function()
        for entity, model in Ecs.world:query(G.C.Model):with(tagComponent) do
            if fn(entity, model) == false then
                break
            end
        end
    end)
    if not ok then
        warn("[PixelBlade] query: " .. tostring(err))
    end
end

local function alive(entity, model)
    if typeof(model) ~= "Instance" or not model.Parent then
        return false
    end
    local health = Ecs.get(entity, G.C.Health)
    if not health or (tonumber(health.value) or 0) <= 0 then
        return false
    end
    return not (Ecs.has(entity, G.C.Dead) or Ecs.has(entity, G.C.Station))
end

local function modelRoot(model)
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Primary") or model:FindFirstChildWhichIsA("BasePart")
end

local function hpPercent()
    local me = Ecs.me()
    local health = me and Ecs.get(me, G.C.Health)
    if health and tonumber(health.max) and health.max > 0 then
        return health.value / health.max * 100
    end
    local humanoid = select(1, getRoot())
    if humanoid and humanoid.MaxHealth > 0 then
        return humanoid.Health / humanoid.MaxHealth * 100
    end
    return 100
end

local function friendly(entity)
    if Ecs.has(entity, G.C.Friendly) or Ecs.has(entity, G.C.RaisedDead) then
        return true
    end
    local ok, owner = pcall(Ecs.world.target, Ecs.world, entity, G.C.SummonedBy)
    return ok and owner ~= nil and Ecs.has(owner, G.C.Player)
end

local function aliveEnemies()
    local list = {}
    Ecs.each(G.C.Enemy, function(entity, model)
        if alive(entity, model) and not friendly(entity) then
            local part = modelRoot(model)
            if part then
                table.insert(list, { entity = entity, model = model, part = part })
            end
        end
    end)
    return list
end

function Game.shielder(enemies, rootPos)
    local best, bestDist
    for _, enemy in ipairs(enemies) do
        local ok, healer = pcall(Ecs.world.target, Ecs.world, enemy.entity, G.C.HealTetheredBy)
        if ok and healer and healer ~= enemy.entity then
            local model = Ecs.get(healer, G.C.Model)
            if alive(healer, model) and not friendly(healer) then
                local part = modelRoot(model)
                if part then
                    local dist = (part.Position - rootPos).Magnitude
                    if not best or dist < bestDist then
                        best, bestDist = { entity = healer, model = model, part = part, shielding = enemy.model }, dist
                    end
                end
            end
        end
    end
    return best
end

function Game.treeGather()
    local ok, raid = pcall(Ecs.world.get, Ecs.world, G.C.RaidState, G.C.RaidState)
    local gather = ok and raid and raid.gather
    if type(gather) == "table" and typeof(gather.position) == "Vector3" then
        return gather
    end
    return nil
end

function Game.raidTree()
    local map = workspace:FindFirstChild("map")
    local tree = map and map:FindFirstChild("crystal_tree")
    local hurtbox = tree and tree:FindFirstChild("hurtbox")
    local trunk = hurtbox and hurtbox:FindFirstChild("trunk")
    return trunk and trunk:IsA("BasePart") and trunk or nil
end

local function nearestEnemy(rootPos)
    local best, bestDist, bestBoss
    local enemies = aliveEnemies()
    local tree = Flags.TreeMobsFirst and Game.raidTree()
    if tree then
        rootPos = tree.Position
    end
    if Flags.KillShieldersFirst then
        local shielder = Game.shielder(enemies, rootPos)
        if shielder then
            return shielder
        end
    end
    for _, enemy in ipairs(enemies) do
        local isBoss = Flags.PrioritizeBoss and Ecs.has(enemy.entity, G.C.BOSS)
        local dist = (enemy.part.Position - rootPos).Magnitude
        if not best or (isBoss and not bestBoss) or (isBoss == bestBoss and dist < bestDist) then
            best, bestDist, bestBoss = enemy, dist, isBoss
        end
    end
    return best
end

local function isCrateName(name)
    if name:match("^crate_") or name:match("^barrel_") then
        return true
    end
    return Flags.IncludeChests and name:match("^chest_") ~= nil
end

local function nearestCrate(rootPos)
    local best, bestDist
    local now = os.clock()
    Ecs.each(G.C.Breakable, function(entity, model)
        if isCrateName(model.Name) and alive(entity, model) and not (Game.crateSkip[entity] and Game.crateSkip[entity] > now) then
            local part = modelRoot(model)
            if part then
                local dist = (part.Position - rootPos).Magnitude
                if not best or dist < bestDist then
                    best, bestDist = { entity = entity, model = model, part = part }, dist
                end
            end
        end
    end)
    return best
end

