local function poseAround(targetPart, dt, mode, dist, speed)
    local pos = targetPart.Position
    if mode == "Below" then
        local at = pos - Vector3.new(0, dist, 0)
        return CFrame.lookAt(at, pos, Vector3.zAxis)
    elseif mode == "Front" or mode == "Behind" then
        local at = (targetPart.CFrame * CFrame.new(0, 0, mode == "Front" and -dist or dist)).Position
        return CFrame.lookAt(at, Vector3.new(pos.X, at.Y, pos.Z))
    elseif mode == "Orbit" then
        Game.orbitAngle = (Game.orbitAngle + speed * dt) % (math.pi * 2)
        local at = pos + Vector3.new(math.cos(Game.orbitAngle) * dist, 0, math.sin(Game.orbitAngle) * dist)
        return CFrame.lookAt(at, pos)
    end
    local at = pos + Vector3.new(0, dist, 0)
    return CFrame.lookAt(at, pos, Vector3.zAxis)
end

local function onHeartbeat(dt)
    if unloaded then
        return
    end
    local _, root = getRoot()
    if not root then
        return
    end
    local cf
    if Game.gatherPos then
        cf = CFrame.new(Game.gatherPos + Vector3.new(0, 3, 0))
    elseif Game.retreating and Game.retreatPoint then
        cf = CFrame.new(Game.retreatPoint)
    elseif Game.goal and Game.goal.part and Game.goal.part.Parent then
        local goal = Game.goal
        local isBoss = goal.entity ~= nil and Ecs.world ~= nil and Ecs.has(goal.entity, G.C.BOSS)
        if isBoss then
            cf = poseAround(goal.part, dt, Flags.BossPosition, Flags.BossDistance, Flags.BossOrbitSpeed) + Vector3.new(0, Flags.BossHeightOffset, 0)
        else
            cf = poseAround(goal.part, dt, Flags.FarmPosition, Flags.FarmDistance, Flags.OrbitSpeed) + Vector3.new(0, Flags.HeightOffset, 0)
        end
    end
    if cf then
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function retreatPointFrom(rootPos)
    local enemies = aliveEnemies()
    local sum, count = Vector3.zero, 0
    for _, enemy in ipairs(enemies) do
        if (enemy.part.Position - rootPos).Magnitude < 200 then
            sum += enemy.part.Position
            count += 1
        end
    end
    if count == 0 then
        return rootPos + Vector3.new(0, 30, 0)
    end
    local away = rootPos - sum / count
    away = Vector3.new(away.X, 0, away.Z)
    if away.Magnitude < 1 then
        away = Vector3.new(1, 0, 0)
    end
    return rootPos + away.Unit * 70 + Vector3.new(0, 30, 0)
end

local function fireSkill(slot, target)
    local me = Ecs.me()
    if not me or Ecs.has(me, G.C.Dead) or Ecs.has(me, G.C.Stun) then
        return
    end
    local weapon = Ecs.get(me, G.C.EquippedWeapon)
    if not weapon then
        return
    end
    local weaponDef = Ecs.get(weapon, G.C.Weapon)
    local skill = weaponDef and weaponDef.skills and weaponDef.skills[slot]
    if not skill then
        return
    end
    local activation = slot == 1 and G.ActivationType.SkillOne or G.ActivationType.SkillTwo
    if skill.aiming then
        if Ecs.has(weapon, G.C.Activated) or Ecs.has(weapon, G.C.Attack) then
            return
        end
        return (pcall(function()
            Ecs.world:remove(weapon, G.C.SkillAiming)
            Ecs.world:set(weapon, G.C.Activated, {
                timestamp = os.clock(),
                inner = { activation_type = activation, aim_position = target.part.Position },
            })
        end))
    end
    local signal = slot == 1 and G.input.skill_one or G.input.skill_two
    return (pcall(signal.Fire, signal, os.clock()))
end

function Game.stepCombat()
    if not Ecs.ready() then
        Game.status = "Waiting for game"
        return
    end
    local _, root = getRoot()
    if not root then
        Game.goal = nil
        setHold(false)
        Game.status = "Waiting for character"
        return
    end

    local gather = Flags.AutoTreeMove and Game.treeGather() or nil
    Game.gatherPos = gather and gather.position or nil
    if gather then
        Game.goal = nil
        setHold(false)
        Game.status = string.format("Moving to tree %s/%s", tostring(gather.present), tostring(gather.required))
        return
    end

    if Flags.AutoRetreat then
        local hp = hpPercent()
        if Game.retreating and hp >= Flags.ResumeHp then
            Game.retreating = false
            Game.retreatPoint = nil
        elseif not Game.retreating and hp <= Flags.RetreatHp then
            Game.retreating = true
            Game.retreatPoint = retreatPointFrom(root.Position)
        end
    elseif Game.retreating then
        Game.retreating = false
        Game.retreatPoint = nil
    end
    if Game.retreating then
        Game.goal = nil
        setHold(false)
        Game.status = string.format("Retreating (%d%% HP)", math.floor(hpPercent()))
        return
    end

    local target = Flags.AutoFarm and nearestEnemy(root.Position) or nil
    if target then
        Game.noEnemySince = nil
        -- Share the most recent confirmed farming location with Farm Assist.
        -- Only record positions close to an actual living AutoFarm target.
        if (root.Position - target.part.Position).Magnitude <= 100 and not root.Anchored then
            Game.lastFarmCFrame = root.CFrame
            Game.lastFarmSeenAt = os.clock()
        end
        Game.goal = target
        Game.crate = nil
        setHold(true)
        Game.status = target.shielding and ("Breaking shield on " .. target.shielding.Name) or ("Farming " .. target.model.Name)
        if Flags.AutoSkills and os.clock() - Game.lastSkill >= Flags.SkillInterval then
            for _ = 1, 2 do
                Game.nextSkill = Game.nextSkill == 1 and 2 or 1
                local slot = Game.nextSkill
                if (slot == 1 and Flags.SkillOne or slot == 2 and Flags.SkillTwo) and fireSkill(slot, target) then
                    Game.lastSkill = os.clock()
                    break
                end
            end
        end
        return
    end

    if Flags.AutoCrates then
        local crate = Game.crate
        if crate and (not alive(crate.entity, crate.model) or os.clock() - Game.crateStart > 4) then
            if alive(crate.entity, crate.model) then
                Game.crateSkip[crate.entity] = os.clock() + 10
            end
            crate = nil
        end
        if not crate then
            crate = nearestCrate(root.Position)
            Game.crateStart = os.clock()
        end
        Game.crate = crate
        if crate then
            Game.goal = crate
            setHold(true)
            Game.status = "Breaking " .. crate.model.Name
            return
        end
    end

    Game.goal = nil
    Game.crate = nil
    setHold(false)
    if Flags.AutoFarm then
        Game.noEnemySince = Game.noEnemySince or os.clock()
        Game.status = "No enemies found"
    else
        Game.noEnemySince = nil
        Game.status = "Idle"
    end
end

local function normalize(text)
    return string.lower((tostring(text):gsub("[%s_%-]", "")))
end

local function cardStars(card)
    if card.item_type == "Weapon" then
        local attrs = G.weaponAttrs[card.id]
        return attrs and STAR_VALUE[attrs.stars] or 0
    end
    local attrs = G.armorAttrs[card.id]
    return attrs and tonumber(attrs.stars) or 0
end

local function cardScore(card)
    local preferred = 0
    for word in string.gmatch(Flags.PreferredItems, "[^,]+") do
        local key = normalize(word)
        if key ~= "" and string.find(normalize(card.id), key, 1, true) then
            preferred = 1
            break
        end
    end
    local rank = #Flags.RarityOrder + 1
    for i, rarity in ipairs(Flags.RarityOrder) do
        if rarity == card.rarity then
            rank = i
            break
        end
    end
    local typeMatch = (Flags.PreferType == "Any" or Flags.PreferType == card.item_type) and 1 or 0
    local stars = cardStars(card)
    if Flags.CardTiebreak == "Stars" then
        return { preferred, stars, -rank, typeMatch }
    end
    return { preferred, -rank, typeMatch, stars }
end

local function better(a, b)
    for i = 1, #a do
        if a[i] ~= b[i] then
            return a[i] > b[i]
        end
    end
    return false
end

function Game.stepBanners()
    local me = Ecs.me()
    local offer = me and not Ecs.has(me, G.C.Dead) and Ecs.get(me, G.C.Banners)
    local ids = {}
    if type(offer) == "table" then
        for _, id in pairs(offer) do
            table.insert(ids, tostring(id))
        end
    end
    if #ids == 0 then
        Game.bannerSig = nil
        return
    end
    table.sort(ids)
    local sig = table.concat(ids, "|")
    if Game.bannerSig == sig and os.clock() - Game.bannerSeenAt < 1.5 then
        return
    end
    Game.bannerSig = sig
    Game.bannerSeenAt = os.clock()
    local best, bestRank
    for _, id in ipairs(ids) do
        local rank = table.find(Flags.BannerOrder, (id:gsub("(%l)(%u)", "%1 %2"))) or 99
        if not best or rank < bestRank then
            best, bestRank = id, rank
        end
    end
    G.net.select_banner.fire(best)
    Game.stats.banners += 1
end

function Game.stepCards()
    if not Ecs.ready() then
        return
    end
    Game.stepBanners()
    local pick = Ecs.get(G.C.CharmPick, G.C.CharmPick)
    if not pick or pick.resolved or type(pick.offers) ~= "table" then
        Game.cardSig = nil
        return
    end
    local offer = pick.offers[tostring(LocalPlayer.UserId)]
    if not offer or offer.picked or type(offer.cards) ~= "table" then
        return
    end
    local parts = { tostring(offer.charm_id), tostring(offer.charm_rarity) }
    for _, card in pairs(offer.cards) do
        table.insert(parts, tostring(card.id) .. ":" .. tostring(card.rarity))
    end
    local sig = table.concat(parts, "|")
    if Game.cardSig == sig and os.clock() - Game.cardSeenAt < 1.5 then
        return
    end
    Game.cardSig = sig
    Game.cardSeenAt = os.clock()
    local bestIndex, bestScore
    for index, card in pairs(offer.cards) do
        local score = cardScore(card)
        if not bestScore or better(score, bestScore) then
            bestIndex, bestScore = index, score
        end
    end
    if bestIndex then
        G.net.pick_charm_card.fire(bestIndex)
        Game.stats.cards += 1
    end
end

local function bestCharmKey(charms)
    local bestKey, bestRank, bestRarity
    for key, entry in pairs(charms) do
        if type(entry) == "table" and (tonumber(entry.count) or 0) > 0 then
            local rank = table.find(Flags.CharmOrder, entry.id) or 99
            local rarityRank = table.find(RARITY_LIST, entry.rarity) or 99
            if not bestKey or rank < bestRank or (rank == bestRank and rarityRank < bestRarity) then
                bestKey, bestRank, bestRarity = key, rank, rarityRank
            end
        end
    end
    return bestKey
end

function Game.stepCharm()
    if not Ecs.ready() or os.clock() - Game.charmAt < 3 then
        return
    end
    local me = Ecs.me()
    if not me then
        return
    end
    local equipped = Ecs.get(me, G.C.EquippedCharm)
    if equipped and equipped.reserved then
        return
    end
    local dealer
    Ecs.each(G.C.CharmDealer, function(_, model)
        if typeof(model) == "Instance" and model.Parent then
            dealer = model
            return false
        end
        return nil
    end)
    if not dealer then
        return
    end
    local fishing = Ecs.get(me, G.C.Fishing)
    local key = fishing and type(fishing.charms) == "table" and bestCharmKey(fishing.charms)
    if not key then
        return
    end
    Game.charmAt = os.clock()
    local _, root = getRoot()
    if root and not Game.retreating then
        local pivot = dealer:GetPivot()
        root.CFrame = pivot * CFrame.new(0, 0, -5)
        task.wait(0.3)
    end
    if unloaded or not Flags.AutoCharm then
        return
    end
    G.net.equip_charm.fire(key)
    Game.stats.charms += 1
end

function Game.stepRetry()
    if not Ecs.ready() then
        return
    end
    local vote = Ecs.get(G.C.RunVote, G.C.RunVote)
    if not vote or vote.resolved then
        Game.voteSeenAt = 0
        return
    end
    if Game.voteSeenAt == 0 then
        Game.voteSeenAt = os.clock()
        return
    end
    local choice = vote.kind == "RaidContinue" and "Stay" or "Replay"
    if Flags.AutoLeave then
        choice = "Leave"
    elseif not Flags.AutoRetry then
        return
    end
    local mine = type(vote.votes) == "table" and vote.votes[tostring(LocalPlayer.UserId)]
    if mine == choice or os.clock() - Game.voteSeenAt < 1 or os.clock() - Game.voteFiredAt < 2 then
        return
    end
    Game.voteFiredAt = os.clock()
    G.net.run_end_vote.fire(choice)
    Game.stats.retries += 1
end

function Game.stepMisc()
    if not Ecs.ready() then
        return
    end
    local me = Ecs.me()
    local now = os.clock()
    if Flags.AutoGiveUp and me and Ecs.has(me, G.C.Dead) and Ecs.has(me, G.C.ReviveTimer) and now - (Game.giveUpAt or 0) > 3 then
        Game.giveUpAt = now
        G.net.give_up.fire()
    end
    if Flags.AutoSkipCutscene and now - (Game.skipAt or 0) > 1 then
        local active = false
        pcall(function()
            for _ in Ecs.world:query(G.C.Cutscene) do
                active = true
                break
            end
        end)
        if active and G.cutsceneState.is_holding_player(Ecs.world, Ecs.state) then
            Game.skipAt = now
            G.net.skip_cutscene.fire()
        end
    end
end

local Runs: any = { list = {}, file = "OuroborosHub/PixelBlade_runs.json" }
local RESULT_NAMES = { Replay = "Replayed", Leave = "Left", Stay = "Stayed" }

function Runs.load()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return
    end
    local ok, data = pcall(function()
        return isfile(Runs.file) and HttpService:JSONDecode(readfile(Runs.file)) or nil
    end)
    if ok and type(data) == "table" then
        Runs.list = data
    end
end

function Runs.save()
    if type(writefile) ~= "function" then
        return
    end
    pcall(function()
        if type(isfolder) == "function" and not isfolder("OuroborosHub") then
            makefolder("OuroborosHub")
        end
        writefile(Runs.file, HttpService:JSONEncode(Runs.list))
    end)
end

function Runs.chests()
    local loot = Ecs.get(Ecs.me(), G.C.Loot)
    local total = 0
    if type(loot) == "table" then
        for _, count in pairs(loot) do
            total += tonumber(count) or 0
        end
    end
    return total
end

function Runs.publish()
    if Runs.table then
        pcall(Runs.table.SetRows, Runs.table, Runs.list)
    end
end

function Runs.step()
    if not Ecs.ready() or not Ecs.me() then
        return
    end
    local place = Ecs.get(G.C.Place, G.C.Place)
    if not place or place.id == "Lobby" or place.id == "RaidLobby" then
        Runs.current = nil
        return
    end
    local vote = Ecs.get(G.C.RunVote, G.C.RunVote)
    local run = Runs.current
    if not run then
        if vote then
            return
        end
        local world = table.find(WORLDS, place.id)
        Runs.current = {
            name = (world and ("W" .. world) or tostring(place.id)) .. " " .. tostring(place.difficulty or ""),
            started = os.clock(),
            chests = Runs.chests(),
        }
        return
    end
    if not vote then
        if run.row then
            Runs.current = nil
        end
        return
    end
    if not run.row then
        local seconds = math.floor(os.clock() - run.started)
        run.row = {
            Ended = os.date("%H:%M"),
            Run = run.name,
            Time = string.format("%d:%02d", seconds // 60, seconds % 60),
            Chests = math.max(Runs.chests() - run.chests, 0),
            Result = "Ended",
        }
        table.insert(Runs.list, 1, run.row)
        while #Runs.list > 25 do
            table.remove(Runs.list)
        end
        Runs.save()
        Runs.publish()
    end
    local mine = type(vote.votes) == "table" and vote.votes[tostring(LocalPlayer.UserId)]
    local result = mine and RESULT_NAMES[mine] or mine
    if result and run.row.Result ~= result then
        run.row.Result = result
        run.row.Chests = math.max(Runs.chests() - run.chests, run.row.Chests)
        Runs.save()
        Runs.publish()
    end
end

local Lobby: any = { at = {} }

function Lobby.inLobby()
    local place = Ecs.get(G.C.Place, G.C.Place)
    return place ~= nil and place.id == "Lobby"
end

function Lobby.ready(key, seconds)
    if not Ecs.ready() or not Lobby.inLobby() then
        return false
    end
    local now = os.clock()
    if Lobby.at[key] and now - Lobby.at[key] < seconds then
        return false
    end
    Lobby.at[key] = now
    return true
end

function Lobby.coins()
    local coins = Ecs.get(Ecs.me(), G.C.Coins)
    return coins and tonumber(coins.value) or 0
end

function Lobby.serverEntity(entity)
    local ok, id = pcall(Ecs.state.replicator.get_server_entity, Ecs.state.replicator, entity)
    return ok and id or nil
end

function Lobby.stepJoin()
    if Flags.AutoRaid or not Lobby.ready("join", 12) then
        return
    end
    local unlocks = Ecs.get(Ecs.me(), G.C.WorldUnlocks)
    local world, difficulty = Flags.JoinWorld, Flags.JoinDifficulty
    if world == "Bootcamp" then
        difficulty = "Normal"
    end
    local worldUnlocks = type(unlocks) == "table" and unlocks[world]
    if not (type(worldUnlocks) == "table" and worldUnlocks[difficulty]) then
        Game.lobbyStatus = "Join: " .. world .. " " .. difficulty .. " is locked"
        return
    end
    Game.lobbyStatus = "Joining " .. world .. " " .. difficulty
    G.net.create_play_session.fire(world, difficulty, world == "Bootcamp" and 1 or Flags.JoinPlayers)
end

function Lobby.stepStart()
    if not Ecs.ready() or os.clock() - (Lobby.at.start or 0) < 3 then
        return
    end
    pcall(function()
        for _, session in Ecs.world:query(G.C.PadSession) do
            if type(session) == "table" and session.owner_user_id == LocalPlayer.UserId and session.phase == "Open" then
                Lobby.at.start = os.clock()
                G.net.start_pad_session.fire()
                Game.lobbyStatus = "Starting run"
                break
            end
        end
    end)
end

function Lobby.stepRaid()
    if not Ecs.ready() then
        return
    end
    local place = Ecs.get(G.C.Place, G.C.Place)
    local id = place and place.id
    if (id == "Lobby" or id == "RaidLobby") and os.clock() - (Lobby.at.raid or 0) >= 10 then
        Lobby.at.raid = os.clock()
        G.net.auto_join_raid.fire()
        Game.lobbyStatus = id == "Lobby" and "Going to raid lobby" or "Joining raid"
    end
end

function Lobby.stepQuests()
    if not Lobby.ready("quests", 4) then
        return
    end
    local me = Ecs.me()
    local quests = Ecs.get(me, G.C.Quests)
    if type(quests) ~= "table" then
        return
    end
    local places = G.completedUtil.reached_places(Ecs.world, me)
    local level = Ecs.get(me, G.C.PlayerLevel) or 1
    local lines = Ecs.get(me, G.C.QuestLines)
    local clydeGone = G.completedUtil.is_clyde_gone(Ecs.world, me)
    for _, npc in ipairs(G.npcConfig.npcs) do
        if npc.giver then
            local ok, actions = pcall(G.questUtil.talk_actions, quests, npc.giver, places, level, lines, G.clydeUtil.stand_ins(npc.giver, clydeGone))
            Lobby.npcSkip = Lobby.npcSkip or {}
            local skipUntil = Lobby.npcSkip[npc.id] or 0
            if ok and os.clock() >= skipUntil and (#actions.accepts > 0 or #actions.grants > 0 or #actions.credits > 0) then
                Lobby.npcSkip[npc.id] = os.clock() + 60
                local model = workspace:FindFirstChild("npc_" .. npc.id)
                local prompt = model and model:FindFirstChild("talk", true)
                local _, root = getRoot()
                if model and prompt and root and type(fireproximityprompt) == "function" then
                    Game.lobbyStatus = "Quest: " .. npc.id
                    root.CFrame = model:GetPivot() * CFrame.new(0, 0, -4)
                    task.wait(0.4)
                    pcall(fireproximityprompt, prompt)
                    task.wait(1.2)
                    if unloaded or not Flags.AutoQuests then
                        return
                    end
                    G.net.accept_quest.fire(npc.id)
                    task.wait(1)
                    return
                end
            end
        end
    end
end

function Lobby.stepShop()
    if not Lobby.ready("shop", 3) then
        return
    end
    local shop = Ecs.get(Ecs.me(), G.C.DailyShop)
    if type(shop) ~= "table" then
        return
    end
    local daily = G.shopConfig.daily
    local passes = Ecs.get(Ecs.me(), G.C.Gamepasses) or {}
    local rarities = {}
    for _, r in ipairs(Flags.ShopRarities) do
        rarities[r] = true
    end
    for index, row in pairs(shop.order or {}) do
        if rarities[row.rarity] and not (index == daily.vip_slot_index and not passes.VIP) then
            local bought = (shop.items and shop.items[row.id]) or 0
            local cost = daily.buy_cost[row.rarity] or math.huge
            if bought < (daily.available_buys[row.rarity] or 0) and Lobby.coins() >= cost then
                G.net.buy_daily.fire(row.id)
                Game.lobbyStatus = "Bought " .. tostring(row.id)
                return
            end
        end
    end
    for _, id in ipairs(Flags.ShopChests) do
        local claimed = shop.chests and shop.chests[id]
        if claimed ~= nil and claimed < 1 then
            local cost = daily.chest_cost[id] or 0
            local memberOk = cost > 0 or (G.groupUtil and G.groupUtil.is_member() == true)
            if memberOk and Lobby.coins() >= cost then
                G.net.buy_daily.fire(id)
                Game.lobbyStatus = "Bought " .. id
                return
            end
        end
    end
end

function Lobby.stepPotions()
    if not Lobby.ready("potions", 2) then
        return
    end
    local owned = Ecs.get(Ecs.me(), G.C.OwnedPotions) or {}
    for _, id in ipairs(Flags.BuyPotions) do
        local def = G.potionConfig[id]
        if def and (owned[id] or 0) < Flags.PotionTarget and Lobby.coins() >= (def.cost or math.huge) then
            G.net.buy_potion.fire(id)
            Game.lobbyStatus = "Bought " .. id
            return
        end
    end
end

function Lobby.stepEquip()
    if not Lobby.ready("equip", 5) then
        return
    end
    for _, tab in ipairs({ "Weapons", "Armor" }) do
        local ok, list = pcall(G.armoryGui.collect_owned, Ecs.world, Ecs.me(), tab)
        local best = ok and list[1]
        if best and not Ecs.has(best.entity, G.C.Equipped) then
            local id = Lobby.serverEntity(best.entity)
            if id then
                G.net.equip_item.fire(id)
                Game.lobbyStatus = "Equipped " .. tostring(best.name)
                task.wait(0.5)
            end
        end
    end
end

function Lobby.stepUpgrade()
    if not Lobby.ready("upgrade", 1.5) then
        return
    end
    local rarities = {}
    for _, r in ipairs(Flags.UpgradeRarities) do
        rarities[r] = true
    end
    for _, tab in ipairs({ "Weapons", "Armor" }) do
        local ok, list = pcall(G.armoryGui.collect_owned, Ecs.world, Ecs.me(), tab)
        for _, item in ipairs(ok and list or {}) do
            local allowed = rarities[item.rarity] and (not Flags.UpgradeEquippedOnly or Ecs.has(item.entity, G.C.Equipped))
            if allowed then
                local okReq, req = pcall(G.upgrade.get_upgrade_requirement, Ecs.world, item.entity)
                if okReq and req and req.can_upgrade and not req.maxed and Lobby.coins() - (req.needed_coins or 0) >= Flags.UpgradeReserve then
                    local id = Lobby.serverEntity(item.entity)
                    if id then
                        G.net.upgrade_item.fire(id)
                        Game.lobbyStatus = "Upgraded " .. tostring(item.name)
                        return
                    end
                end
            end
        end
    end
end

function Lobby.stepChests()
    if not Lobby.ready("chests", 3) then
        return
    end
    local loot = Ecs.get(Ecs.me(), G.C.Loot)
    if type(loot) ~= "table" then
        return
    end
    local all = #Flags.OpenChests == 0
    for id, count in pairs(loot) do
        if (tonumber(count) or 0) > 0 and (all or table.find(Flags.OpenChests, id)) then
            G.net.open_chest.fire(id, math.min(count, 1000))
            Game.lobbyStatus = "Opened " .. id .. " x" .. tostring(count)
            return
        end
    end
end

function Lobby.stepClass()
    if not Lobby.ready("class", 3.5) then
        return
    end
    local me = Ecs.me()
    local current = G.classUtil.get_class_id(Ecs.world, me)
    if current and table.find(Flags.ClassTargets, current) then
        Game.lobbyStatus = "Class: got " .. current
        return
    end
    if #Flags.ClassTargets == 0 then
        Game.lobbyStatus = "Class: pick target classes"
        return
    end
    local dice = Ecs.get(me, G.C.Dice)
    if not dice or (tonumber(dice.value) or 0) < 1 then
        Game.lobbyStatus = "Class: out of rolls"
        return
    end
    G.net.roll_class.fire(os.clock())
    Game.lobbyStatus = "Class: rolled (had " .. tostring(current) .. ")"
end

function Game.stepPotion()
    if not Ecs.ready() then
        return
    end
    local me = Ecs.me()
    if not me or Ecs.has(me, G.C.Dead) or hpPercent() > Flags.PotionHp then
        return
    end
    local slots = Ecs.get(me, G.C.Potions)
    local owned = Ecs.get(me, G.C.OwnedPotions)
    if type(slots) ~= "table" or type(owned) ~= "table" then
        return
    end
    local now = os.clock()
    for i, slot in ipairs(slots) do
        if Game.potionUses[i] ~= nil and Game.potionUses[i] ~= slot.uses then
            Game.potionFired[i] = now
        end
        Game.potionUses[i] = slot.uses
    end
    for i, slot in ipairs(slots) do
        local def = slot.id and G.potionConfig[slot.id]
        if def and (tonumber(owned[slot.id]) or 0) > 0 and now - (Game.potionFired[i] or -math.huge) >= (tonumber(def.cooldown) or 1) + 0.5 then
            for _, effect in ipairs(def.effects or {}) do
                if effect.type == G.PotionEffectType.Heal then
                    Game.potionFired[i] = now
                    pcall(G.input.use_potion.Fire, G.input.use_potion, i)
                    return
                end
            end
        end
    end
end

local HitboxEsp: any = { parts = {} }

function HitboxEsp.clear()
    if HitboxEsp.conn then
        HitboxEsp.conn:Disconnect()
        HitboxEsp.conn = nil
    end
    for entity, part in pairs(HitboxEsp.parts) do
        pcall(part.Destroy, part)
        HitboxEsp.parts[entity] = nil
    end
    if HitboxEsp.folder then
        pcall(HitboxEsp.folder.Destroy, HitboxEsp.folder)
        HitboxEsp.folder = nil
    end
end

function HitboxEsp.render()
    if unloaded or not Flags.HitboxEsp or not Ecs.ready() then
        return
    end
    if not HitboxEsp.folder or not HitboxEsp.folder.Parent then
        HitboxEsp.folder = Instance.new("Folder")
        HitboxEsp.folder.Name = "OuroHitboxes"
        HitboxEsp.folder.Parent = workspace
    end
    local Shape = G.HitboxShape
    local seen = {}
    local ok, err = pcall(function()
        for entity, hitbox in Ecs.world:query(G.C.Hitbox):without(G.C.Dead) do
            local inner = hitbox.inner
            local cf = inner and G.inherit(Ecs.world, entity, G.C.Transform)
            if cf then
                if hitbox.offset then
                    cf = cf * hitbox.offset
                end
                local size
                if inner.shape == Shape.Sphere then
                    size = Vector3.one * inner.radius * 2
                elseif inner.shape == Shape.Cylinder then
                    size = Vector3.new(inner.height, inner.radius * 2, inner.radius * 2)
                    cf = cf * CFrame.Angles(0, 0, math.pi / 2)
                elseif inner.shape == Shape.Block then
                    size = inner.size
                end
                if size then
                    seen[entity] = true
                    local part = HitboxEsp.parts[entity]
                    if not part or not part.Parent then
                        part = Instance.new("Part")
                        part.Name = "Hitbox"
                        part.Anchored = true
                        part.CanCollide = false
                        part.CanQuery = false
                        part.CanTouch = false
                        part.CastShadow = false
                        part.Material = Enum.Material.ForceField
                        part.Shape = inner.shape == Shape.Sphere and Enum.PartType.Ball or inner.shape == Shape.Cylinder and Enum.PartType.Cylinder or Enum.PartType.Block
                        part.Color = G.findAncestor(Ecs.world, entity, G.C.Enemy) and Color3.fromRGB(255, 50, 60) or Color3.fromRGB(70, 200, 255)
                        part.Parent = HitboxEsp.folder
                        HitboxEsp.parts[entity] = part
                    end
                    part.Size = size
                    part.CFrame = cf
                end
            end
        end
    end)
    if not ok and not HitboxEsp.warned then
        HitboxEsp.warned = true
        warn("[PixelBlade] hitbox esp: " .. tostring(err))
    end
    for entity, part in pairs(HitboxEsp.parts) do
        if not seen[entity] then
            pcall(part.Destroy, part)
            HitboxEsp.parts[entity] = nil
        end
    end
end

function HitboxEsp.set(enabled)
    if enabled then
        HitboxEsp.conn = HitboxEsp.conn or track(RunService.RenderStepped:Connect(HitboxEsp.render))
    else
        HitboxEsp.clear()
    end
end

local Esp = { items = {} }

function Esp.remove(model)
    local item = Esp.items[model]
    if item then
        pcall(item.highlight.Destroy, item.highlight)
        pcall(item.billboard.Destroy, item.billboard)
        Esp.items[model] = nil
    end
end

function Esp.clear()
    for model in pairs(Esp.items) do
        Esp.remove(model)
    end
end

function Esp.step()
    if not Ecs.ready() then
        return
    end
    local _, root = getRoot()
    local seen = {}
    for _, enemy in ipairs(aliveEnemies()) do
        local model = enemy.model
        seen[model] = true
        local item = Esp.items[model]
        if not item then
            local highlight = Instance.new("Highlight")
            highlight.FillColor = Color3.fromRGB(255, 70, 90)
            highlight.FillTransparency = 0.6
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Adornee = model
            highlight.Parent = model
            local billboard = Instance.new("BillboardGui")
            billboard.Size = UDim2.fromOffset(160, 36)
            billboard.StudsOffset = Vector3.new(0, 3.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Adornee = enemy.part
            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Size = UDim2.fromScale(1, 1)
            label.Font = Enum.Font.GothamBold
            label.TextSize = 13
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeTransparency = 0.4
            label.Parent = billboard
            billboard.Parent = model
            item = { highlight = highlight, billboard = billboard, label = label }
            Esp.items[model] = item
        end
        local info = Ecs.get(enemy.entity, G.C.Enemy)
        local health = Ecs.get(enemy.entity, G.C.Health)
        local name = info and info.id and tostring(info.id):gsub("(%l)(%u)", "%1 %2") or model.Name
        local text = name
        if health then
            text ..= string.format("\n%d / %d HP", math.floor(health.value), math.floor(health.max))
        end
        if root then
            text ..= string.format("  [%dm]", math.floor((enemy.part.Position - root.Position).Magnitude))
        end
        item.label.Text = text
    end
    for model in pairs(Esp.items) do
        if not seen[model] then
            Esp.remove(model)
        end
    end
end

