local function stepDaily()
    if not inLobby() then
        return
    end
    local today = math.floor(workspace:GetServerTimeNow() / 86400)
    if (tonumber(LocalPlayer:GetAttribute("DailyDay")) or 0) >= today then
        return
    end
    local booth = workspace.Lobby:FindFirstChild("RewardBooth")
    local zone = booth and booth:FindFirstChild("DailyReward") and booth.DailyReward:FindFirstChild("Zone")
    if not zone then
        return
    end
    withLock(function()
        local _, root = getRoot()
        local back = root and root.CFrame
        Game.status = "Claiming daily"
        local started = os.clock()
        while os.clock() - started < 6 and not unloaded and (tonumber(LocalPlayer:GetAttribute("DailyDay")) or 0) < today do
            teleport(zone.Position + Vector3.new(0, 3, 0))
            task.wait(0.3)
        end
        if (tonumber(LocalPlayer:GetAttribute("DailyDay")) or 0) >= today then
            notify("Daily reward claimed", "Success")
        end
        local _, r = getRoot()
        if r and back then
            r.CFrame = back
        end
        Game.status = "Idle"
    end)
end

