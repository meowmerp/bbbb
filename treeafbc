local function initializeGUI()

-- GUI library loaded from the requested GitHub source.
local UI_SOURCE_URL = "https://raw.githubusercontent.com/meowmerp/bbbb/main/gui"
local function loadGuiLibrary()
    if type(loadstring) ~= "function" then
        error("GUI loader requires loadstring", 0)
    end
    print("[Deforestation] Startup: downloading GUI library")
    local source = game:HttpGet(UI_SOURCE_URL)
    if type(source) ~= "string" or source == "" then
        error("GUI library download returned empty content", 0)
    end
    print("[Deforestation] Startup: compiling GUI library (" .. tostring(#source) .. " bytes)")
    local compiled, compileError = loadstring(source, "=DeforestationGUI")
    if not compiled then
        error("GUI library compilation failed: " .. tostring(compileError), 0)
    end
    print("[Deforestation] Startup: executing GUI library")
    local runOk, result = xpcall(compiled, function(err)
        local trace = (debug and type(debug.traceback) == "function")
            and debug.traceback(tostring(err), 2) or tostring(err)
        return trace
    end)
    if not runOk then
        error("Downloaded GUI library failed while executing: " .. tostring(result), 0)
    end
    return result
end

