local function startWorker(key, interval, step)
    if workers[key] then
        return
    end
    workers[key] = true
    task.spawn(function()
        while workers[key] and not unloaded do
            if (Game.bossPhase or Game.finalSequence) and BOSS_PAUSED_WORKERS[key] then
                task.wait(interval)
                continue
            end
            local ok, err = pcall(step)
            if not ok then
                warn("[Deforestation] " .. key .. ": " .. tostring(err))
            end
            task.wait(interval)
        end
        workers[key] = nil
    end)
end

local function stopWorker(key)
    workers[key] = false
end

local function setWorker(key, enabled, interval, step)
    if enabled then
        startWorker(key, interval, step)
    else
        stopWorker(key)
    end
end

