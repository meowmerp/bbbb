local function saveLabel(entry)
    local felled = math.floor(tonumber(entry.Felled) or 0)
    return string.format("%s %s - %d trees (%s)", tostring(entry.Map or "Forest"), tostring(entry.Difficulty or "?"), felled, tostring(entry.Key))
end

local function onSaves(_, list)
    if type(list) ~= "table" then
        return
    end
    table.clear(Lobby.saves)
    for _, entry in ipairs(list) do
        if type(entry) == "table" and entry.Key then
            table.insert(Lobby.saves, { label = saveLabel(entry), key = entry.Key })
        end
    end
    if Lobby.onSavesChanged then
        Lobby.onSavesChanged()
    end
end

local function refreshSaves()
    if not inLobby() or Lobby.joining then
        return false
    end
    return withLock(function()
        Game.status = "Reading saved runs"
        local padId = enterPad()
        if padId then
            task.wait(1.5)
        end
        leavePad(padId)
        Game.status = "Idle"
        return padId ~= nil
    end)
end

local function joinRun(saveKey)
    if not inLobby() or Lobby.joining then
        return false
    end
    return withLock(function()
        Lobby.joining = true
        Game.status = saveKey and "Loading saved run" or "Creating run"
        local padId = enterPad()
        local ok, result = false, nil
        if padId then
            if saveKey then
                ok, result = pcall(LobbyRemotes.LoadParty.InvokeServer, LobbyRemotes.LoadParty, padId, saveKey)
            else
                local diff = Flags.Difficulty
                if difficultyWins(diff) > playerWins() then
                    diff = "NORMAL"
                end
                local size = math.clamp(math.floor(tonumber(Flags.PartySize) or 1), 1, LobbyConfig and LobbyConfig.MaxParty or 4)
                ok, result = pcall(LobbyRemotes.CreateParty.InvokeServer, LobbyRemotes.CreateParty, padId, diff, size, "Forest")
            end
        end
        local success = ok and type(result) == "table" and result.Ok == true
        if success then
            Game.status = "Waiting for teleport"
            local gui = LocalPlayer.PlayerGui:FindFirstChild("LobbyParty")
            if gui then
                gui.Enabled = false
            end
        else
            Game.status = "Join failed: " .. tostring(type(result) == "table" and result.Why or result)
            leavePad(padId)
            Lobby.joining = false
        end
        return success
    end)
end

