-- Read the top-right area label, not boss health bars or objective text.
local function visibleHudLabel(node)
    if not (node:IsA("TextLabel") or node:IsA("TextButton")) then return false end
    local ancestor = node
    while ancestor and ancestor ~= game do
        if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
        if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return false end
        ancestor = ancestor.Parent
    end
    return true
end

local function cleanAreaHudText(value)
    return tostring(value or ""):gsub("<[^>]->", ""):gsub("&nbsp;", " "):gsub("\194\160", " ")
end

local function areaProgress(text)
    text = cleanAreaHudText(text):lower()
    return tonumber(text:match("(%d+%.?%d*)%s*%%%s*cleared")
        or text:match("(%d+%.?%d*)%s*%%"))
end

local function normalizeZoneLabel(value)
    return tostring(value or ""):lower():gsub("[^%w]", "")
end

local detectedZoneDropdown = nil
local settingZoneFromDetection = false
local function detectCurrentZone()
    if not Flags.AutoDetectZone then return end
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    local cam = workspace.CurrentCamera
    local size = cam and cam.ViewportSize or Vector2.new(1920,1080)
    for _, node in ipairs(gui:GetDescendants()) do
        if visibleHudLabel(node) then
            local pos = node.AbsolutePosition
            if pos.X >= size.X * 0.52 and pos.Y < size.Y * 0.32 then
                local raw = cleanAreaHudText(node.Text)
                local stripped = raw:match("^%s*(.-)%s+[Aa][Rr][Ee][Aa]%s*%d+%s*/%s*%d+") or raw
                local name = normalizeZoneLabel(stripped)
                for _, key in ipairs(zoneOrder()) do
                    if name ~= "" and (name == normalizeZoneLabel(key) or name == normalizeZoneLabel(zoneLabel(key))) then
                        if Flags.Zone ~= key then
                            Flags.Zone = key
                            table.clear(Game.badTrees)
                            -- Keep the GUI dropdown in sync when the library supports setting a value.
                            if detectedZoneDropdown then
                                settingZoneFromDetection = true
                                pcall(function()
                                    if type(detectedZoneDropdown.Set) == "function" then
                                        detectedZoneDropdown:Set({zoneLabel(key)})
                                    elseif type(detectedZoneDropdown.SetValue) == "function" then
                                        detectedZoneDropdown:SetValue(zoneLabel(key))
                                    end
                                end)
                                settingZoneFromDetection = false
                            end
                        end
                        return
                    end
                end
            end
        end
    end
end

-- Observe the cleared-area HUD and active boss health bar only.
-- This does not attack, move toward, or interact with bosses.
local function readBossProgress()
    local state = { cleared = false, progress = nil, marker = nil, name = nil, hp = nil, timerVisible = false }
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not gui then return state end
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1920,1080)
    local labels = {}
    for _, node in ipairs(gui:GetDescendants()) do
        if visibleHudLabel(node) then
            local text = cleanAreaHudText(node.Text)
            local pos = node.AbsolutePosition
            -- The normal day/night HUD displays a countdown such as "4m 46s".
            -- Check visible upper-screen text, independently from the boss HP bar.
            local timerText = text:lower():gsub("%s+", " ")
            if pos.Y <= viewport.Y * 0.28
                and (timerText:match("%d+%s*m%s*%d+%s*s")
                    or timerText:match("%d+%s*m%s*$")
                    or timerText:match("%d+%s*s%s*$")) then
                state.timerVisible = true
            end
            if pos.X >= viewport.X * 0.50 and pos.Y <= viewport.Y * 0.35 then
                local pct = areaProgress(text)
                if pct then
                    state.progress = pct
                    state.cleared = pct >= 99.9
                end
                local area, total = text:lower():match("area%s*(%d+)%s*/%s*(%d+)")
                if area and total then state.marker = area .. "/" .. total end
            end
            if pos.Y <= viewport.Y * 0.24 then
                table.insert(labels, { node = node, text = text, pos = pos, size = node.AbsoluteSize })
            end
        end
    end
    local best = math.huge
    for _, healthLabel in ipairs(labels) do
        local a, b = healthLabel.text:match("^%s*([%d,%.]+)%s*/%s*([%d,%.]+)%s*$")
        local hp, maximum = tonumber(a and a:gsub(",", "")), tonumber(b and b:gsub(",", ""))
        if hp and maximum and maximum >= 20 and hp >= 0 and hp <= maximum then
            for _, nameLabel in ipairs(labels) do
                if nameLabel ~= healthLabel then
                    local name = nameLabel.text:match("^%s*(.-)%s*$") or ""
                    local lower = name:lower()
                    local gap = healthLabel.pos.Y - (nameLabel.pos.Y + nameLabel.size.Y)
                    local dx = math.abs((healthLabel.pos.X + healthLabel.size.X/2) - (nameLabel.pos.X + nameLabel.size.X/2))
                    if #name >= 3 and #name <= 32 and name:match("^[%a][%a%s%-']+$")
                        and not lower:find("clear", 1, true) and not lower:find("wake", 1, true)
                        and not lower:find("area", 1, true) and not lower:find("chopping", 1, true)
                        and gap >= -4 and gap <= 48 and dx <= 220 then
                        local score = math.abs(gap) + dx * 0.15
                        if score < best then
                            best = score
                            state.name, state.hp = name, hp
                        end
                    end
                end
            end
        end
    end
    return state
end


-- Working standalone Boss Test v7: rig verification, tracking and attack style.
local function getPlayerRootForBoss() return getRoot() end
local BossV7 = (function()
    local player = LocalPlayer
    local function getRoot() return select(2, getPlayerRootForBoss()) end
local Game = {areaBossName = nil}
local LocalPlayer = player
local function normalizedName(value)
    return string.gsub(string.lower(tostring(value or "")), "[^%w]", "")
end
local function modelHealth(model)
    if not model or not model.Parent then return 0 end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then return humanoid.Health end
    local hp = tonumber(model:GetAttribute("HP"))
    if hp == nil then hp = tonumber(model:GetAttribute("Health")) end
    if hp == nil then
        local value = model:FindFirstChild("HP") or model:FindFirstChild("Health")
        if value and (value:IsA("NumberValue") or value:IsA("IntValue")) then hp = value.Value end
    end
    return hp
end
-- Only actual character rigs qualify as boss targets. Never fall back to an
-- arbitrary BasePart (that was making map structures into attack targets).
local function modelRootPart(model)
    if not model or not model:IsA("Model") then return nil end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or (humanoid and humanoid.RootPart)
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
    if root and root:IsA("BasePart") then return root end
    -- Custom non-Humanoid bosses must expose a direct, identifiable root
    -- and actual health data, rather than borrowing a building's PrimaryPart.
    local hp = modelHealth(model)
    if hp ~= nil and hp > 0 and model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
        return model.PrimaryPart
    end
    return nil
end

local function isBossRig(model)
    if not model or not model:IsA("Model") or model == player.Character then return false end
    local n = normalizedName(model.Name)
    for _, token in ipairs({"shed", "cabin", "house", "building", "hut", "shop", "garage", "station", "barn", "decor", "healthbar", "billboard", "nameplate"}) do
        if n:find(token, 1, true) then return false end
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health > 0 and modelRootPart(model) ~= nil end
    return modelHealth(model) ~= nil and modelHealth(model) > 0 and modelRootPart(model) ~= nil
end

local function findActiveBoss(preferredName)
        preferredName = preferredName or Game.areaBossName
        local preferred = normalizedName(preferredName)
        local preferredCore = string.gsub(preferred, "^the", "")
        local playerRoot = getRoot()
        local bestModel, bestScore = nil, -math.huge

        -- Do not let short nested-model names such as "Old" or UI models such
        -- as "OldBarkbackHealthBar" masquerade as the live boss. Only accept a
        -- name that exactly matches the HUD name or contains the full HUD name.
        local function matchesPreferred(value)
            local normalized = normalizedName(value)
            if normalized == "" or preferred == "" then return false, 0 end
            if normalized == preferred or (preferredCore ~= "" and normalized == preferredCore) then
                return true, 2
            end
            if #preferred >= 6 and #normalized >= #preferred
                and string.find(normalized, preferred, 1, true) ~= nil then
                return true, 1
            end
            if #preferredCore >= 6 and #normalized >= #preferredCore
                and string.find(normalized, preferredCore, 1, true) ~= nil then
                return true, 1
            end
            return false, 0
        end

        local function isUiOrEffectModel(value)
            local n = normalizedName(value)
            for _, token in ipairs({ "healthbar", "bossbar", "healthui", "billboard", "nameplate", "nametag", "indicator", "displaygui", "effect", "vfx" }) do
                if string.find(n, token, 1, true) ~= nil then return true end
            end
            return false
        end

        local function explicitRigRoot(model)
            local humanoid = model:FindFirstChildOfClass("Humanoid")
                or model:FindFirstChildWhichIsA("Humanoid", true)
            local root = model:FindFirstChild("HumanoidRootPart", true)
                or model:FindFirstChild("RootPart", true)
                or model:FindFirstChild("PrimaryPart", true)
                or model:FindFirstChild("UpperTorso", true)
                or model:FindFirstChild("Torso", true)
                or model.PrimaryPart
                or (humanoid and humanoid.RootPart)
            if root and root:IsA("BasePart") then return root, humanoid end
            return nil, humanoid
        end

        local function consider(model, kind, strength)
            if not model or not model:IsA("Model") or model == LocalPlayer.Character
                or not model.Parent or isUiOrEffectModel(model.Name) then
                return
            end
            local targetRoot, humanoid = explicitRigRoot(model)
            -- A real NPC rig should expose either a Humanoid or a stable named
            -- root part. Do not use the first arbitrary BasePart in a building,
            -- accessory, or HUD model as a teleport destination.
            if not targetRoot or not isBossRig(model) then return end
            local hp = modelHealth(model)
            if hp ~= nil and hp <= 0 then return end
            local distance = playerRoot and (targetRoot.Position - playerRoot.Position).Magnitude or 1000
            local score = strength - distance
            if humanoid then score += 2500 end
            if targetRoot.Name == "HumanoidRootPart" or targetRoot.Name == "RootPart" then score += 1000 end
            local boxOk, _, boxSize = pcall(function() return model:GetBoundingBox() end)
            if boxOk and boxSize and typeof(boxSize) == "Vector3" then
                -- Only a tiny tie-breaker: huge buildings should never beat a rig match.
                score += math.min(boxSize.Magnitude, 80) * 0.1
            end
            if score > bestScore then
                bestModel, bestScore = model, score
            end
        end

        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("Model") then
                local candidate = normalizedName(inst.Name)
                local namedMatch, nameStrength = matchesPreferred(candidate)
                local displayMatch = false
                local displayStrength = 0
                local genericMatch = string.find(candidate, "boss", 1, true) ~= nil
                    or string.find(candidate, "barkback", 1, true) ~= nil

                local function inspectDisplay(value)
                    if value == nil then return end
                    local display = normalizedName(value)
                    local match, strength = matchesPreferred(display)
                    if match then
                        displayMatch = true
                        displayStrength = math.max(displayStrength, strength)
                    end
                    if string.find(display, "boss", 1, true) ~= nil
                        or string.find(display, "barkback", 1, true) ~= nil then
                        genericMatch = true
                    end
                end
                for _, attributeName in ipairs({ "DisplayName", "BossName", "NPCType", "MobType", "EnemyType", "MonsterType" }) do
                    inspectDisplay(inst:GetAttribute(attributeName))
                end
                local hum = inst:FindFirstChildOfClass("Humanoid")
                    or inst:FindFirstChildWhichIsA("Humanoid", true)
                if hum and hum.DisplayName and hum.DisplayName ~= "" then
                    inspectDisplay(hum.DisplayName)
                end

                if namedMatch then
                    consider(inst, "name", nameStrength == 2 and 20000 or 16000)
                elseif displayMatch then
                    consider(inst, "display", displayStrength == 2 and 18000 or 15000)
                elseif genericMatch and preferred == "" then
                    -- Only use generic Boss/Barkback names when the HUD has not
                    -- supplied an identifying name. If it has, substring-only
                    -- generic matches tend to hit unrelated props and nameplates.
                    consider(inst, "generic", 6000)
                elseif genericMatch and (hum ~= nil) then
                    -- A properly-rigged generic BossNPC is a fallback when the
                    -- HUD gives a specific name that the rig does not expose.
                    consider(inst, "generic-rig", 5500)
                end
            elseif (inst:IsA("TextLabel") or inst:IsA("TextButton")) and preferred ~= "" then
                -- World-space boss name tags often live under the model rather
                -- than using the same name. Follow the tag upward and accept the
                -- nearest ancestor that is genuinely an NPC rig, never a shed or
                -- arbitrary map model that merely contains the label.
                local labelMatch = matchesPreferred(inst.Text)
                if labelMatch then
                    local ancestor = inst.Parent
                    while ancestor and ancestor ~= workspace do
                        if ancestor:IsA("Model") and ancestor ~= LocalPlayer.Character then
                            local rootPart, humanoid = explicitRigRoot(ancestor)
                            if humanoid and rootPart and isBossRig(ancestor) and not isUiOrEffectModel(ancestor.Name) then
                                consider(ancestor, "world-name-tag", 17000)
                                break
                            end
                        end
                        ancestor = ancestor.Parent
                    end
                end
            end
        end

        return bestModel
    end

-- Boss positioning derived from the user's working script: stable approach in front of the boss.
local approachDirection
local function placeAtBossWeakpoint(boss)
    local playerRoot = getRoot()
    local targetRoot = modelRootPart(boss)
    if not playerRoot or not targetRoot then return false end
    local ok, boxCf, boxSize = pcall(function() return boss:GetBoundingBox() end)
    if not ok then boxCf, boxSize = targetRoot.CFrame, targetRoot.Size end
    if not approachDirection then
        local look = targetRoot.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        approachDirection = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
    end
    local frontDistance = 3.5 -- Nighttime-style melee range; original uses 15 for gun fire.
    local bossFeetY = boxCf.Position.Y - boxSize.Y * 0.5
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local rootToFeet = (hum and hum.HipHeight or 2) + playerRoot.Size.Y * 0.5
    local destination = Vector3.new(
        boxCf.Position.X + approachDirection.X * frontDistance,
        bossFeetY + rootToFeet + 0.5,
        boxCf.Position.Z + approachDirection.Z * frontDistance
    )
    local aimHeight = math.clamp(boxSize.Y * 0.19, 1.5, 5)
    local aimPoint = boxCf.Position - Vector3.new(0, boxSize.Y * 0.5 - aimHeight, 0)
        - boxCf.RightVector * (boxSize.X * 0.22)
    local flatAim = Vector3.new(aimPoint.X, destination.Y, aimPoint.Z)
    playerRoot.AssemblyLinearVelocity = Vector3.zero
    playerRoot.CFrame = CFrame.lookAt(destination, flatAim)
    return true
end

