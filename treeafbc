do
    local ok, loaded = pcall(function() return game:IsLoaded() end)
    if not ok then
        warn("[Deforestation] Startup: game:IsLoaded() failed: " .. tostring(loaded))
    elseif not loaded then
        local waitOk, waitErr = pcall(function() game.Loaded:Wait() end)
        if not waitOk then
            warn("[Deforestation] Startup: game.Loaded:Wait() failed: " .. tostring(waitErr))
        end
    end
end

