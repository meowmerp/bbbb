local bossTarget = nil
local bossNextScan = 0
local bossLastPosition = 0
local bossNextAttack = 0
local bossCombatRunning = false
local function bossCombatStep()
    if unloaded or not Flags.AutoChop or not Game.bossPhase or Game.bossDefeated or Game.finalSequence then return end
    if bossCombatRunning then return end
    bossCombatRunning = true
    local ok, err = pcall(function()
        local state = readBossProgress()
        if state.marker and Game.bossAreaKey ~= tostring(Flags.Zone) .. "|" .. state.marker then return end
        -- A 0 HP HUD can still need a final hit/animation. Do not end here.
        -- Completion is confirmed by the vanished boss HUD and returned cycle timer.
        if state.name and Game.bossName and normalizeZoneLabel(state.name) ~= normalizeZoneLabel(Game.bossName) then
            bossTarget = nil
            bossNextScan = 0
            Game.bossName = state.name
        end
        if not Game.bossName then
            Game.status = "Area cleared; waiting for boss bar"
            return
        end
        if bossTarget and (not bossTarget.Parent or not BossV7.root(bossTarget)) then
            bossTarget = nil
        end
        if not bossTarget and os.clock() >= bossNextScan then
            bossNextScan = os.clock() + 3
            bossTarget = BossV7.find(Game.bossName)
        end
        if not bossTarget then
            Game.status = "Boss detected; waiting for verified NPC"
            return
        end
        local targetRoot = BossV7.root(bossTarget)
        -- The model was validated when first acquired. Retain that lock if
        -- its health reaches zero while the boss bar is still onscreen.
        if not targetRoot then
            bossTarget = nil
            return
        end
        Game.status = "Boss combat: " .. tostring(bossTarget.Name)
        if os.clock() - bossLastPosition >= 0.3 then
            bossLastPosition = os.clock()
            BossV7.position(bossTarget)
        end
        if os.clock() >= bossNextAttack then
            bossNextAttack = os.clock() + 0.30
            BossV7.attack()
        end
    end)
    bossCombatRunning = false
    if not ok then
        Game.status = "Boss combat error: " .. tostring(err)
        if not Game.bossErrorAt or os.clock() - Game.bossErrorAt >= 8 then
            Game.bossErrorAt = os.clock()
            warn("[Deforestation] Boss combat: " .. tostring(err))
        end
    end
end

-- End-of-run objective: a checkmark next to Golden Aspens in the upper-right HUD.
-- Also accept the checkmark as a neighboring label in the same HUD row.
local function goldenAspensCheckVisible()
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not gui then return false end
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
    local labels = {}
    -- The end-of-area records are in the top-right portion of the game HUD.
    -- They may consist of several TextLabels and an ImageLabel checkmark.
    for _, node in ipairs(gui:GetDescendants()) do
        if (node:IsA("TextLabel") or node:IsA("TextButton")) and visibleHudLabel(node) then
            local pos = node.AbsolutePosition
            if pos.X >= viewport.X * 0.35 and pos.Y <= viewport.Y * 0.48 then
                local content = cleanAreaHudText(node.Text):lower()
                if content ~= "" then
                    table.insert(labels, {
                        text = content,
                        x = pos.X, y = pos.Y,
                        parent = node.Parent,
                    })
                end
            end
        end
    end
    local function completedMark(text)
        return text:find("✓", 1, true) ~= nil
            or text:find("✔", 1, true) ~= nil
            or text:find("☑", 1, true) ~= nil
            or text:find("✅", 1, true) ~= nil
            or text:find("√", 1, true) ~= nil
    end
    local function hasRunTime(text)
        -- Completed-area record examples: 1:21:00 and -1:54:27.
        -- Unlike the current-area countdown, these appear on the same
        -- horizontal row as the zone name.
        return text:match("%d+:%d%d:%d%d") ~= nil
    end
    for _, label in ipairs(labels) do
        if label.text:find("golden%s*aspens") then
            -- The zone title at the top of the HUD is not a completion signal.
            -- Look for either a checkmark or a completed-run time in its row.
            if completedMark(label.text) or hasRunTime(label.text) then
                return true
            end
            for _, other in ipairs(labels) do
                if other ~= label
                    and math.abs(other.y - label.y) <= 22
                    and math.abs(other.x - label.x) <= 320
                    and (completedMark(other.text) or hasRunTime(other.text)) then
                    return true
                end
            end
        end
    end
    return false
end

local function beginFinalBusinessman(reason)
    if Game.finalSequence or Game.finalDone then return end
    local _, previousRoot = getRoot()
    if previousRoot then Game.finalReturnCFrame = previousRoot.CFrame end
    Game.finalSequence = true
    Game.bossPhase = true -- immediately pause ongoing farming, pickup and selling
    Game.goldenAspensChecked = true
    Game.finalStartedAt = os.clock()
    Game.finalStage = "FindBusinessman"
    Game.finalNextAction = 0
    Game.status = "Golden Aspens cleared; visiting Businessman"
    print("[Deforestation] " .. reason .. "; starting Businessman interaction")
end

local function monitorBossAndAdvance()
    if not Flags.AutoChop and not Flags.AutoSell and not Flags.AutoPickup then return end
    local zone = Flags.Zone
    local state = readBossProgress()
    -- The final-area checkmark is authoritative: begin the Businessman flow
    -- even when the boss HUD or regular day/night timer has disappeared.
    if not Game.finalSequence and not Game.finalDone and not Game.finalRejected
        and Game.bossDefeated
        and (zone == "GoldenAspens" or state.marker == "8/8" or Game.bossAreaMarker == "8/8" or Game.sellAreaNumber == 8)
        and goldenAspensCheckVisible() then
        beginFinalBusinessman("Golden Aspens checkmark detected")
        return
    end
    -- Area number is authoritative for log selling when the top-right HUD is present.
    -- Keep the last number while the HUD temporarily disappears for boss animations.
    if state.marker then
        local currentArea = tonumber(state.marker:match("^(%d+)/"))
        if currentArea then Game.sellAreaNumber = currentArea end
    end
    if not Flags.AutoChop then return end
    if Game.finalSequence then return end
    -- A disappearing area label during the defeat animation is not a new area.
    local areaKey = tostring(zone) .. "|" .. tostring(state.marker or (Game.bossPhase and Game.bossAreaMarker) or "")
    if Game.bossAreaKey ~= areaKey then
        Game.bossAreaKey = areaKey
        Game.bossSeen, Game.bossDefeated, Game.bossCleared = false, false, false
        Game.bossPhase = false
        Game.bossAreaMarker = state.marker
        Game.bossEndConfirmedAt = nil
        bossTarget = nil
        bossNextScan = 0
        Game.bossName = nil
        Game.bossBaselineUnlock = tonumber(workspace:GetAttribute("AreasUnlocked")) or 1
    end
    -- A genuine 100% top-right progress label is required before boss handling.
    if state.progress ~= nil and state.cleared then Game.bossCleared = true end
    if not Game.bossCleared then return end
    if Game.finalRejected and state.cleared and state.name then
        Game.finalRejected = false
        print("[Deforestation] Confirmed new Golden Aspens boss encounter")
    end
    if state.name then
        Game.bossPhase = true -- 100% + a spawned boss bar; pause the farming/day-night cycle
        if not Game.bossSeen or Game.bossName ~= state.name then
            Game.bossName = state.name
            print("[Deforestation] Boss detected: " .. state.name .. "; switching to Boss Test v7 combat")
        end
        Game.bossSeen = true
    end
    local unlocked = tonumber(workspace:GetAttribute("AreasUnlocked")) or 1
    -- Do not trust 0 HP or a zone-unlock attribute by themselves. The boss
    -- bar must vanish AND the normal day/night timer must be visible again.
    if Game.bossPhase and Game.bossSeen and state.name == nil and state.timerVisible then
        Game.bossEndConfirmedAt = Game.bossEndConfirmedAt or os.clock()
        if os.clock() - Game.bossEndConfirmedAt >= 0.6 then
            Game.bossDefeated = true
        end
    else
        Game.bossEndConfirmedAt = nil
    end
    if not Game.bossDefeated then
        if Game.bossPhase then
            if state.hp ~= nil and state.hp <= 0 then
                Game.status = "Boss at 0 HP; attacking until bar disappears and timer returns"
            elseif state.name == nil then
                Game.status = "Boss bar gone; waiting for day/night timer"
            else
                Game.status = Game.status:find("Boss combat", 1, true) and Game.status or "Area cleared; boss combat active"
            end
        else
            Game.status = "Area cleared; waiting for boss to spawn"
        end
        return
    end
    -- The last boss ends the forest run; finish at the Businessman instead
    -- of trying to advance beyond Golden Aspens.
    if not Game.finalRejected and (zone == "GoldenAspens" or Game.bossAreaMarker == "8/8" or state.marker == "8/8") then
        beginFinalBusinessman("Golden Aspens boss defeat confirmed")
        return
    end
    if not Flags.AutoAdvanceZone then
        Game.status = "Boss defeated; auto advance disabled"
        return
    end
    local order, index = zoneOrder(), zoneIndex(zone)
    if not index then return end
    for i = index + 1, #order do
        if zoneUnlocked(order[i]) then
            local nextZone = order[i]
            Flags.Zone = nextZone
            table.clear(Game.badTrees)
            Game.bossAreaKey = nil
            Game.bossPhase = false
            Game.bossEndConfirmedAt = nil
            bossTarget = nil
            Game.bossSeen, Game.bossDefeated, Game.bossCleared = false, false, false
            Game.bossName = nil
            Game.bossBaselineUnlock = unlocked
            if detectedZoneDropdown then
                settingZoneFromDetection = true
                pcall(function()
                    if type(detectedZoneDropdown.Set) == "function" then
                        detectedZoneDropdown:Set({zoneLabel(nextZone)})
                    elseif type(detectedZoneDropdown.SetValue) == "function" then
                        detectedZoneDropdown:SetValue(zoneLabel(nextZone))
                    end
                end)
                settingZoneFromDetection = false
            end
            Game.status = "Advanced to " .. zoneLabel(nextZone)
            print("[Deforestation] Boss defeated; advanced to " .. zoneLabel(nextZone))
            return
        end
    end
    Game.status = "Boss defeated; waiting for next zone unlock"
end

-- Final Golden Aspens interaction.  The businessman position shown in the
-- user's screenshot is a fallback, not a guarantee of where the NPC is.
local BUSINESSMAN_FALLBACK = Vector3.new(330.1, 3.2, 181.9)
local finalNpcScanAt = 0

local function visibleFinalGui(node)
    if not node or not node:IsA("GuiObject") then return false end
    local current = node
    while current do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        current = current.Parent
    end
    return true
end

local finalLastDialogueSnapshot = nil
local function logBusinessmanDialogue()
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    local entries = {}
    local seen = {}
    for _, node in ipairs(gui:GetDescendants()) do
        if (node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox"))
            and visibleFinalGui(node) then
            local inDialogue = false
            local cursor = node
            while cursor and cursor ~= gui do
                local name = cursor.Name:lower()
                if name:find("dialog", 1, true) or name:find("conversation", 1, true) then
                    inDialogue = true
                    break
                end
                cursor = cursor.Parent
            end
            if inDialogue then
                local content = tostring(node.Text or ""):gsub("<[^>]->", "")
                    :gsub("%s+", " "):match("^%s*(.-)%s*$")
                if content and content ~= "" and not seen[content] then
                    seen[content] = true
                    table.insert(entries, (node:IsA("TextButton") and "[CHOICE] " or "")
                        .. content:sub(1, 220))
                end
            end
        end
    end
    if #entries == 0 then return end
    local maxEntries = math.min(#entries, 20)
    local snapshot = table.concat(entries, " | ", 1, maxEntries)
    if snapshot ~= finalLastDialogueSnapshot then
        finalLastDialogueSnapshot = snapshot
        print("[Deforestation][Businessman dialogue] " .. snapshot)
    end
end

local function finalGuiState()
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local state = {won = false, unfinished = false, returnButton = nil, dialogueVisible = false, nextButton = nil}
    if not gui then return state end
    local labels = {}
    local buttons = {}
    for _, node in ipairs(gui:GetDescendants()) do
        if (node:IsA("TextLabel") or node:IsA("TextButton")) and visibleFinalGui(node) then
            local content = tostring(node.Text or ""):lower():gsub("<[^>]->", "")
            table.insert(labels, {node = node, text = content})
            if node:IsA("TextButton") then
                table.insert(buttons, {button = node, text = content})
            end
            local ancestry = node
            while ancestry and ancestry ~= gui do
                local name = ancestry.Name:lower()
                if name:find("dialog", 1, true) or name:find("conversation", 1, true) then
                    state.dialogueVisible = true
                    break
                end
                ancestry = ancestry.Parent
            end
        elseif node:IsA("ImageButton") and visibleFinalGui(node) then
            table.insert(buttons, {button = node, text = node.Name:lower()})
        end
    end
    for _, label in ipairs(labels) do
        if label.text:find("forest cleared", 1, true) then state.won = true end
        if label.text:find("go finish your job first", 1, true) then
            state.unfinished = true
        end
    end
    for _, item in ipairs(buttons) do
        local t = item.text:gsub("^%s+", ""):gsub("%s+$", "")
        if t:find("return to lobby", 1, true) or t:find("returntolobby", 1, true) then
            state.returnButton = item.button
        elseif t == "continue" or t == "next" or t == "okay" or t == "ok" or t == "yes"
            or t == "finish" or t == "thanks" or t == "thank you" or t == "goodbye"
            or t == "proceed" or t == "..." or t == "[next]" then
            state.nextButton = state.nextButton or item.button
        end
    end
    -- Victory UI often puts the visible caption in a TextLabel inside an
    -- ImageButton. The TextLabel itself is not the clickable surface.
    if state.won and not state.returnButton then
        for _, entry in ipairs(labels) do
            local normalized = entry.text:gsub("%s+", " ")
            if normalized:find("return to lobby", 1, true) then
                local ancestor = entry.node
                while ancestor and ancestor ~= gui do
                    if ancestor:IsA("GuiButton") and visibleFinalGui(ancestor) then
                        state.returnButton = ancestor
                        break
                    end
                    ancestor = ancestor.Parent
                end
                if not state.returnButton then
                    -- Some games place the caption beside a GuiButton rather
                    -- than beneath it. Match a visible button occupying the
                    -- same on-screen rectangle as the caption.
                    local center = entry.node.AbsolutePosition + entry.node.AbsoluteSize * 0.5
                    for _, item in ipairs(buttons) do
                        local button = item.button
                        local topLeft, size = button.AbsolutePosition, button.AbsoluteSize
                        if size.X > 20 and size.Y > 15
                            and center.X >= topLeft.X and center.X <= topLeft.X + size.X
                            and center.Y >= topLeft.Y and center.Y <= topLeft.Y + size.Y then
                            state.returnButton = button
                            break
                        end
                    end
                end
                if state.returnButton then break end
            end
        end
    end
    return state
end

local function pressFinalInteract()
    local ok = pcall(function()
        local input = game:GetService("VirtualInputManager")
        input:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.08)
        input:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    if not ok and type(keypress) == "function" and type(keyrelease) == "function" then
        pcall(function()
            keypress(0x45)
            task.wait(0.08)
            keyrelease(0x45)
        end)
    end
end

local function clickFinalButton(button)
    if not button or not visibleFinalGui(button) or button.AbsoluteSize.Magnitude < 5 then return false end
    local at = button.AbsolutePosition + button.AbsoluteSize * 0.5
    local ok = pcall(function()
        local input = game:GetService("VirtualInputManager")
        input:SendMouseButtonEvent(math.floor(at.X), math.floor(at.Y), 0, true, game, 0)
        task.wait(0.06)
        input:SendMouseButtonEvent(math.floor(at.X), math.floor(at.Y), 0, false, game, 0)
    end)
    return ok
end

local function locateBusinessman()
    if Game.finalTarget and Game.finalTarget.Parent then
        return Game.finalTarget
    end
    if os.clock() < finalNpcScanAt then return nil end
    finalNpcScanAt = os.clock() + 3
    local best, dist = nil, math.huge
    for _, node in ipairs(workspace:GetDescendants()) do
        if (node:IsA("Model") or node:IsA("BasePart"))
            and node.Name:lower():find("businessman", 1, true) then
            local point
            if node:IsA("BasePart") then point = node.Position
            elseif node.PrimaryPart then point = node.PrimaryPart.Position
            else
                local ok, pivot = pcall(function() return node:GetPivot() end)
                if ok then point = pivot.Position end
            end
            if point then
                local d = (point - BUSINESSMAN_FALLBACK).Magnitude
                if d < dist then best, dist = node, d end
            end
        end
    end
    Game.finalTarget = best
    return best
end

local function finalBusinessmanStep()
    if unloaded or not Game.finalSequence or Game.finalDone then return end
    local now = os.clock()
    local ui = finalGuiState()
    -- The NPC can reject an incomplete run despite an apparent completion row.
    -- Handle that before dialogue auto-advance or further E presses.
    if ui.unfinished and not ui.won then
        Game.finalRejected = true
        Game.finalSequence = false
        Game.finalDone = false
        Game.goldenAspensChecked = false
        Game.finalStage = nil
        Game.finalTarget = nil
        Game.finalTalkAttempts = 0
        Game.finalNextAction = 0
        Game.bossPhase = false
        Game.bossCleared = false
        Game.bossDefeated = false
        Game.bossSeen = false
        Game.bossName = nil
        Game.bossAreaKey = nil
        Game.bossAreaMarker = nil
        Game.bossEndConfirmedAt = nil
        bossTarget = nil
        bossNextScan = 0
        Flags.Zone = "GoldenAspens"
        if detectedZoneDropdown then
            settingZoneFromDetection = true
            pcall(function()
                if type(detectedZoneDropdown.Set) == "function" then
                    detectedZoneDropdown:Set({zoneLabel("GoldenAspens")})
                elseif type(detectedZoneDropdown.SetValue) == "function" then
                    detectedZoneDropdown:SetValue(zoneLabel("GoldenAspens"))
                end
            end)
            settingZoneFromDetection = false
        end
        table.clear(Game.badTrees)
        Game.treeSearchStep = 0
        Game.treeSearchAnchor = nil
        Game.treeSearchNextAt = 0
        Game.treeSearchZone = nil
        Game.treeSearchLastArea = nil
        Game.status = "Businessman rejected: returning to Golden Aspens trees"
        print("[Deforestation] Businessman: Go finish your job first; returning to Golden Aspens trees")
        local _, root = getRoot()
        local folder = workspace:FindFirstChild("Map")
        folder = folder and folder:FindFirstChild("Trees")
        local destination = nil
        if folder then
            for _, tree in ipairs(folder:GetChildren()) do
                local trunk = tree:FindFirstChild("TrunkBase")
                if tree:GetAttribute("Biome") == "GoldenAspens"
                    and trunk and trunk:IsA("BasePart")
                    and (tonumber(tree:GetAttribute("HP")) or 0) > 0 then
                    destination = CFrame.new(trunk.Position + Vector3.new(4, 3, 0))
                    break
                end
            end
        end
        destination = destination or Game.finalReturnCFrame
        if root and destination then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = destination
            Game.treeSearchAnchor = root.Position
        else
            Game.status = "Golden Aspens unfinished; searching for trees"
        end
        Game.finalReturnCFrame = nil
        return
    end
    -- Hide our overlay as soon as the results screen appears, so it cannot
    -- obscure/intercept the game's Return to Lobby button.
    if ui.won and not Game.finalGuiHidden then
        Game.finalGuiHidden = true
        if Window then
            local hidden, err = pcall(function() Window:Toggle(false) end)
            if not hidden then warn("[Deforestation] Could not hide window: " .. tostring(err)) end
        end
        print("[Deforestation] Forest Cleared screen detected; hiding Deforestation GUI")
    end
    -- The end-of-run screen is authoritative, even if the NPC interaction
    -- has already advanced beyond a visible dialogue panel.
    if ui.won and ui.returnButton then
        Game.finalStage = "ReturnToLobby"
        Game.status = "Forest cleared! Selecting Return to Lobby"
        if now >= Game.finalNextAction then
            Game.finalNextAction = now + 2
            if clickFinalButton(ui.returnButton) then
                Game.finalReturnClickedAt = now
                Game.status = "Return to Lobby clicked; awaiting transition"
                print("[Deforestation] Clicked Return to Lobby; waiting for game transition")
            else
                Game.status = "Forest cleared; waiting to click Return to Lobby"
            end
        end
        return
    end
    if ui.won then
        Game.status = "Forest cleared; waiting for Return to Lobby button"
        return
    end
    if ui.dialogueVisible then
        logBusinessmanDialogue()
        Game.finalStage = "Dialogue"
        Game.status = "Businessman dialogue: advancing"
        if now >= Game.finalNextAction then
            Game.finalNextAction = now + 1.2
            if ui.nextButton then
                clickFinalButton(ui.nextButton)
            else
                -- Games using E-to-advance dialogue may expose no TextButton.
                pressFinalInteract()
            end
        end
        return
    end
    local npc = locateBusinessman()
    local destination = BUSINESSMAN_FALLBACK
    if npc then
        if npc:IsA("BasePart") then destination = npc.Position
        else
            local ok, pivot = pcall(function() return npc:GetPivot() end)
            if ok then destination = pivot.Position end
        end
    end
    local _, root = getRoot()
    if not root then
        Game.status = "Waiting for character before Businessman interaction"
        return
    end
    if (root.Position - destination).Magnitude > 11 then
        -- Stand near the NPC rather than inside the NPC model.
        Game.status = "Moving to Businessman"
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(destination + Vector3.new(0, 3, 5))
        Game.finalNextAction = now + 0.8
        return
    end
    Game.status = "Businessman: pressing E / waiting for dialogue"
    if now >= Game.finalNextAction then
        Game.finalNextAction = now + 2
        Game.finalTalkAttempts += 1
        local nearbyPrompt
        for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 16)) do
            for _, node in ipairs(part:GetDescendants()) do
                if node:IsA("ProximityPrompt") and node.Enabled then
                    local text = (node.ActionText .. " " .. node.ObjectText):lower()
                    if text:find("talk", 1, true) or text:find("businessman", 1, true) then
                        nearbyPrompt = node
                        break
                    end
                end
            end
            if nearbyPrompt then break end
        end
        if nearbyPrompt and type(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, nearbyPrompt)
        else
            pressFinalInteract()
        end
        if Game.finalTalkAttempts >= 8 then
            Game.status = "Waiting for Businessman dialogue; check interaction"
        end
    end
end

local function detectCycle()
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if gui then
        local cam = workspace.CurrentCamera
        local height = cam and cam.ViewportSize.Y or 1080
        for _, node in ipairs(gui:GetDescendants()) do
            if visibleHudLabel(node) and node.AbsolutePosition.Y < height * 0.20 then
                local text = tostring(node.Text or ""):lower():gsub("[^%a ]", " ")
                text = text:gsub("^%s+", ""):gsub("%s+$", "")
                if text == "day" or text == "daytime" then return "Day" end
                if text == "dusk" or text == "dusktime" then return "Dusk" end
                if text == "night" or text == "nighttime" then return "Night" end
                if text == "dawn" or text == "dawntime" then return "Dawn" end
            end
        end
    end
    local t = Lighting.ClockTime
    if t >= 6 and t < 18 then return "Day" end
    if t >= 18 and t < 19 then return "Dusk" end
    if t >= 5 and t < 6 then return "Dawn" end
    return "Night"
end

local NIGHT_MOB_TOKENS = {"sprout", "biter", "thief", "monster", "minion"}
local function liveNightMob(model)
    if not model or not model:IsA("Model") or not model.Parent or model == LocalPlayer.Character then return false end
    local name = normalizeZoneLabel(model.Name)
    for _, attr in ipairs({"MobType", "MonsterType", "EnemyType", "NPCType", "DisplayName"}) do
        name ..= normalizeZoneLabel(model:GetAttribute(attr))
    end
    -- Do not select bosses, including area bosses without a humanoid.
    if name:find("boss", 1, true) or name:find("barkback", 1, true)
        or name:find("king", 1, true) or name:find("goldenaspens", 1, true) then return false end
    local identified = false
    for _, token in ipairs(NIGHT_MOB_TOKENS) do
        if name:find(token, 1, true) then
            identified = true
            break
        end
    end
    if not identified then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    local hp = tonumber(model:GetAttribute("HP") or model:GetAttribute("Health"))
    if hp and hp <= 0 then return false end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        or model:FindFirstChild("RootPart") or model:FindFirstChild("Torso")
    return root and root:IsA("BasePart") and root or nil
end

local function nearestNightMob(maxDist)
    local _, root = getRoot()
    if not root then return nil end
    local closest, distance = nil, maxDist
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("Model") then
            local mobRoot = liveNightMob(inst)
            if mobRoot then
                local d = (root.Position - mobRoot.Position).Magnitude
                if d < distance then closest, distance = inst, d end
            end
        end
    end
    return closest
end

local function clickNightAttack()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    local cam = workspace.CurrentCamera
    local size = cam and cam.ViewportSize or Vector2.new(1600, 900)
    local x, y = math.floor(size.X / 2), math.floor(size.Y / 2)
    local ok = pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    if not ok and type(mouse1click) == "function" then pcall(mouse1click) end
end

local function fightNightMob(mob)
    local _, root = getRoot()
    if not root then return end
    local original = root.CFrame
    local started, lastAdjust = os.clock(), 0
    local approach = 1
    Game.status = "Fighting nighttime mob"
    -- A brief local encounter, not a boss fight or a map-wide kill aura.
    while not unloaded and Flags.AutoChop and Flags.AutoFightMobs and not Game.bossPhase
        and Game.dayNight == "Night" and os.clock() - started < 12 do
        local mobRoot = liveNightMob(mob)
        local _, playerRoot = getRoot()
        if not mobRoot or not playerRoot then break end
        if (mobRoot.Position - playerRoot.Position).Magnitude > 60 then break end
        if os.clock() - lastAdjust > 0.3 then
            local cf = mobRoot.CFrame
            local directions = {cf.LookVector, -cf.LookVector, cf.RightVector, -cf.RightVector}
            local dir = directions[approach]
            local flat = Vector3.new(dir.X, 0, dir.Z)
            if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, 1) end
            local stand = mobRoot.Position + flat.Unit * 3 + Vector3.new(0, 0.5, 0)
            playerRoot.AssemblyLinearVelocity = Vector3.zero
            playerRoot.CFrame = CFrame.lookAt(stand, mobRoot.Position + Vector3.new(0, 1, 0))
            lastAdjust = os.clock()
            approach = approach % 4 + 1
        end
        clickNightAttack()
        task.wait(0.15)
    end
    local _, playerRoot = getRoot()
    if playerRoot and Game.dayNight == "Night" and not Game.bossPhase then
        playerRoot.AssemblyLinearVelocity = Vector3.zero
        playerRoot.CFrame = original
    end
end

local function treesFolder()
    local map = workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Trees")
end

local function nearestTree()
    local folder = treesFolder()
    local _, root = getRoot()
    if not folder or not root then
        return nil
    end
    local best, bestDist
    for _, tree in ipairs(folder:GetChildren()) do
        local base = tree:FindFirstChild("TrunkBase")
        if base and tree:GetAttribute("Biome") == Flags.Zone and (tonumber(tree:GetAttribute("HP")) or 0) > 0 and not Game.badTrees[tree] then
            local dist = (base.Position - root.Position).Magnitude
            if not bestDist or dist < bestDist then
                best, bestDist = tree, dist
            end
        end
    end
    return best
end

-- Explore nearby points when the currently streamed/eligible tree list is empty.
-- This runs at ANY unfinished progress value, not only at high percentages.
local SEARCH_OFFSETS = {
    Vector3.new(45, 0, 0), Vector3.new(0, 0, 45),
    Vector3.new(-45, 0, 0), Vector3.new(0, 0, -45),
    Vector3.new(90, 0, 45), Vector3.new(-90, 0, 45),
    Vector3.new(-90, 0, -45), Vector3.new(90, 0, -45),
    Vector3.new(0, 0, 115), Vector3.new(115, 0, 0),
    Vector3.new(0, 0, -115), Vector3.new(-115, 0, 0),
}

local function searchForMissingTrees()
    if unloaded or isLobbyPlace() or not Flags.AutoChop or Game.bossPhase then return end
    if os.clock() < (Game.treeSearchNextAt or 0) then return end

    -- Don't roam after the area is fully cleared or when the boss bar is visible.
    local hud = readBossProgress()
    if hud.name ~= nil or (hud.progress ~= nil and hud.progress >= 99.9) then
        Game.status = "Waiting for boss / area transition"
        return
    end
    local _, root = getRoot()
    if not root then return end
    local areaId = tostring(Flags.Zone) .. "|" .. tostring(hud.marker or "")
    if Game.treeSearchZone ~= Flags.Zone or Game.treeSearchLastArea ~= areaId then
        Game.treeSearchZone = Flags.Zone
        Game.treeSearchLastArea = areaId
        Game.treeSearchAnchor = root.Position
        Game.treeSearchStep = 0
    end
    -- A new sweep retries trees marked unresponsive on an earlier pass.
    local step = (Game.treeSearchStep or 0) + 1
    if step > #SEARCH_OFFSETS then
        step = 1
        Game.treeSearchAnchor = root.Position
        table.clear(Game.badTrees)
    end
    Game.treeSearchStep = step
    local anchor = Game.treeSearchAnchor or root.Position
    local destination = anchor + SEARCH_OFFSETS[step]
    Game.status = string.format("Searching %s for trees (%d/%d)", zoneLabel(Flags.Zone), step, #SEARCH_OFFSETS)
    -- Allow the nearby portion of the map to stream in after repositioning.
    -- Keep the player at their current height; never move if boss combat started.
    if not isLobbyPlace() and not Game.bossPhase and Flags.AutoChop then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(destination)
    end
    Game.treeSearchNextAt = os.clock() + 0.8
    task.wait(0.5)
    if not isLobbyPlace() and not Game.bossPhase and Flags.AutoChop then
        local tree = nearestTree()
        if tree then
            Game.status = "Tree found in " .. zoneLabel(Flags.Zone)
        end
    end
end

local function groundLogs()
    local folder = workspace:FindFirstChild("Logs")
    local out = {}
    if not folder then
        return out
    end
    local _, root = getRoot()
    if not root then
        return out
    end
    local dist = {}
    for _, log in ipairs(folder:GetChildren()) do
        local wood = log:FindFirstChild("Wood")
        if wood and wood:IsA("BasePart") and log:GetAttribute("ThrownBy") == nil and (Game.badLogs[log] or 0) < 2 then
            local d = (wood.Position - root.Position).Magnitude
            if d <= 250 then
                dist[log] = d
                table.insert(out, log)
            end
        end
    end
    table.sort(out, function(a, b)
        return dist[a] < dist[b]
    end)
    return out
end

local function sellSpots()
    local out = {}
    local map = workspace:FindFirstChild("Map")
    local main = map and map:FindFirstChild("SellSpot")
    if main then
        table.insert(out, main)
    end
    local huts = workspace:FindFirstChild("ForestHuts")
    if huts then
        for _, d in ipairs(huts:GetDescendants()) do
            if d.Name == "SellOutpost" then
                table.insert(out, d)
            end
        end
    end
    return out
end

local function nearestPad()
    local _, root = getRoot()
    if not root then
        return nil
    end
    local best, bestDist
    for _, spot in ipairs(sellSpots()) do
        local pad = spot:FindFirstChild("DepositPad")
        if pad and pad:IsA("BasePart") then
            local dist = (pad.Position - root.Position).Magnitude
            if not bestDist or dist < bestDist then
                best, bestDist = pad, dist
            end
        end
    end
    return best
end

local function farmActive()
    return Flags.AutoChop or Flags.AutoPickup or Flags.AutoSell
end

local function sellLogs()
    if Game.bossPhase or carried() <= 0 or not Remotes then
        return false
    end
    local pad = nearestPad()
    if not pad then
        return false
    end
    Game.status = "Selling"
    teleport(pad.Position + Vector3.new(0, 3, 0))
    task.wait(0.4)
    if unloaded or Game.bossPhase then
        return false
    end
    Remotes.DepositLogs:FireServer(false)
    Game.sells += 1
    task.wait(0.6)
    return true
end

local function pickupLogs()
    local limit = sellThreshold()
    local picked = false
    for _, log in ipairs(groundLogs()) do
        if unloaded or Game.bossPhase or not Flags.AutoPickup or pickupDisabledForZone() or carried() >= limit then
            break
        end
        local wood = log:FindFirstChild("Wood")
        if wood and log.Parent then
            Game.status = "Picking Up Logs"
            local before = carried()
            teleport(wood.Position + Vector3.new(0, 3, 0))
            task.wait(0.15)
            if unloaded or Game.bossPhase or pickupDisabledForZone() then break end
            Remotes.PickUpLog:FireServer(log)
            task.wait(0.2)
            if carried() > before or not log.Parent then
                picked = true
            else
                Game.badLogs[log] = (Game.badLogs[log] or 0) + 1
            end
        end
    end
    for log in pairs(Game.badLogs) do
        if not log.Parent then
            Game.badLogs[log] = nil
        end
    end
    return picked
end

local function chopTree(tree)
    local base = tree:FindFirstChild("TrunkBase")
    local _, root = getRoot()
    if not base or not root then
        return
    end
    Game.status = "Chopping " .. tostring(tree:GetAttribute("TreeType") or "Tree")
    local standAt = base.Position + Vector3.new(3, 2, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.lookAt(standAt, Vector3.new(base.Position.X, standAt.Y, base.Position.Z))
    task.wait(0.2)
    local lastHp = tonumber(tree:GetAttribute("HP")) or 0
    local stuck = 0
    local started = os.clock()
    while not unloaded and Flags.AutoChop and not Game.bossPhase and tree.Parent == treesFolder() and (tonumber(tree:GetAttribute("HP")) or 0) > 0 do
        if os.clock() - started > 60 then
            Game.badTrees[tree] = true
            return
        end
        local _, r = getRoot()
        if not r then
            return
        end
        if (r.Position - standAt).Magnitude > 6 then
            r.CFrame = CFrame.lookAt(standAt, Vector3.new(base.Position.X, standAt.Y, base.Position.Z))
        end
        if Game.bossPhase then return end
        Game.hitSeq += 1
        Remotes.Chop:FireServer(tree, base.Position + Vector3.new(1, 1, 0), 1, Game.hitSeq)
        task.wait(math.max(0.1, Flags.ChopDelay))
        local hp = tonumber(tree:GetAttribute("HP")) or 0
        if hp < lastHp then
            lastHp = hp
            stuck = 0
        else
            stuck += 1
            if stuck >= 15 then
                Game.badTrees[tree] = true
                return
            end
        end
    end
    if (tonumber(tree:GetAttribute("HP")) or 0) <= 0 then
        Game.trees += 1
        task.wait(1)
    end
end

local function stepFarm()
    -- Never roam, chop, pick up or sell in the lobby; preserve lobby-only workers.
    if isLobbyPlace() then
        Game.treeSearchStep = 0
        Game.treeSearchAnchor = nil
        Game.status = "In lobby; forest farming paused"
        return
    end
    if Game.bossPhase or not Remotes or not farmActive() or Game.busy then
        return
    end
    if not getRoot() then
        return
    end
    Game.busy = true
    local ok, err = pcall(function()
        if Game.bossPhase then
            Game.status = Game.bossDefeated and "Boss defeated; waiting for next zone" or "Boss combat active"
            return
        end
        if Flags.AutoChop and Flags.AutoFightMobs and Game.dayNight == "Night" then
            local mob = nearestNightMob(20)
            if mob then
                fightNightMob(mob)
                return
            end
        end
        local full = carried() >= sellThreshold()
        if Flags.AutoSell and (full or (carried() > 0 and not Flags.AutoChop and not (Flags.AutoPickup and not pickupDisabledForZone() and #groundLogs() > 0))) then
            sellLogs()
            return
        end
        if Flags.AutoPickup and not pickupDisabledForZone() and not full and #groundLogs() > 0 then
            pickupLogs()
            return
        end
        if Flags.AutoChop then
            if not zoneUnlocked(Flags.Zone) then
                Game.status = zoneLabel(Flags.Zone) .. " is locked"
                return
            end
            if full and not Flags.AutoSell then
                Game.status = "Bag full"
                return
            end
            local tree = nearestTree()
            if tree then
                Game.treeSearchStep = 0
                Game.treeSearchAnchor = nil
                Game.treeSearchNextAt = 0
                chopTree(tree)
            else
                searchForMissingTrees()
            end
            return
        end
        Game.status = "Idle"
    end)
    Game.busy = false
    if not ok then
        error(err, 0)
    end
end

local function stepCoins()
    if not Remotes then
        return
    end
    for _, spot in ipairs(sellSpots()) do
        local folder = spot:FindFirstChild("Cash")
        if folder then
            for _, coin in ipairs(folder:GetChildren()) do
                if unloaded or not Flags.AutoCoins then
                    return
                end
                if coin:GetAttribute("Owner") == LocalPlayer.UserId then
                    Remotes.CollectCash:FireServer(coin)
                end
            end
        end
    end
end

local function withLock(fn)
    local started = os.clock()
    while Game.busy and os.clock() - started < 70 and not unloaded do
        task.wait(0.1)
    end
    if Game.busy or unloaded then
        return nil
    end
    Game.busy = true
    local ok, a, b = pcall(fn)
    Game.busy = false
    if not ok then
        warn("[Deforestation] " .. tostring(a))
        return nil
    end
    return a, b
end

local function stationPosition(name)
    local map = workspace:FindFirstChild("Map")
    local cabin = map and map:FindFirstChild("LogCabin")
    local shop = cabin and cabin:FindFirstChild("Shop")
    local stations = shop and shop:FindFirstChild("Stations")
    local station = stations and stations:FindFirstChild(name)
    local anchor = station and station:FindFirstChild("PromptAnchor")
    return partPosition(anchor) or partPosition(station)
end

local function buyAtStation(stationName, invoke)
    local pos = stationPosition(stationName)
    if not pos then
        return false
    end
    return withLock(function()
        local _, root = getRoot()
        if not root then
            return false
        end
        local back = root.CFrame
        Game.status = "Buying"
        teleport(pos + Vector3.new(0, 1, 0))
        task.wait(0.4)
        local result = invoke()
        task.wait(0.2)
        local _, r = getRoot()
        if r and farmActive() == false then
            r.CFrame = back
        end
        return result
    end)
end

local function toolOwned(name)
    return LocalPlayer:GetAttribute("Owns" .. name) == true
end

local function buyTool(name)
    local def = Config and Config.Tools[name]
    local price = def and tonumber(def.Price)
    local station = TOOL_STATIONS[name] or ("Station_" .. name)
    if name == "Dynamite" then
        station = "Station_Explosives"
    end
    if not price or toolOwned(name) or cashValue() < price or not stationPosition(station) then
        return
    end
    if def.RequiresItem and backpackLevel() <= 0 then
        return
    end
    buyAtStation(station, function()
        local ok, result = pcall(Remotes.BuyTool.InvokeServer, Remotes.BuyTool, name)
        if ok and type(result) == "table" and result.Ok then
            Game.bought += 1
            notify("Bought " .. tostring(def.DisplayName or name), "Success")
        end
        return ok and result
    end)
end

local function stepTools()
    if not Remotes or not Config then
        return
    end
    for _, name in ipairs(Flags.BuyTools) do
        if unloaded or not Flags.AutoTools then
            return
        end
        buyTool(name)
    end
end

local function stepDynamite()
    if Remotes and Config then
        buyTool("Dynamite")
    end
end

local function nextUpgradePrice(id)
    local item = upgradeDef(id)
    if not item then
        return nil
    end
    local level = math.floor(tonumber(LocalPlayer:GetAttribute("Up_" .. id)) or 0)
    return item.Prices[level + 1], item
end

local function stepUpgrades()
    if not Remotes or not Config then
        return
    end
    for _, id in ipairs(Flags.BuyUpgrades) do
        if unloaded or not Flags.AutoUpgrades then
            return
        end
        local price, item = nextUpgradePrice(id)
        local _, section = upgradeDef(id)
        local needs = section and section.Requires
        if price and item and cashValue() >= price and (not needs or toolOwned(needs)) then
            local level = LocalPlayer:GetAttribute("Up_" .. id)
            Remotes.BuyUpgrade:FireServer(id)
            task.wait(0.5)
            if LocalPlayer:GetAttribute("Up_" .. id) ~= level then
                Game.bought += 1
            end
        end
    end
end

local function stepBackpack()
    if not Remotes or not Config then
        return
    end
    local price = nextUpgradePrice("GearBackpack")
    if not price or cashValue() < price then
        return
    end
    local level = backpackLevel()
    buyAtStation("Station_Backpack", function()
        Remotes.BuyUpgrade:FireServer("GearBackpack")
        task.wait(0.5)
        if backpackLevel() > level then
            Game.bought += 1
            notify("Backpack upgraded", "Success")
        end
        return true
    end)
end

local function vehicleDef(id)
    for _, v in ipairs(Config and Config.Vehicles.List or {}) do
        if v.Id == id then
            return v
        end
    end
    return nil
end

local function stepCars()
    if not Remotes or not Config then
        return
    end
    local map = workspace:FindFirstChild("Map")
    local garage = map and map:FindFirstChild("Garage")
    local enter = garage and garage:FindFirstChild("Enter")
    local pos = partPosition(enter)
    if not pos then
        return
    end
    for _, id in ipairs(Flags.BuyCars) do
        if unloaded or not Flags.AutoCars then
            return
        end
        local def = vehicleDef(id)
        local state = Game.carBuys[id] or 0
        if def and state >= 0 and state < 3 then
            local have = def.Currency == "Gems" and gemsValue() or cashValue()
            if (def.Currency == "Coins" or def.Currency == "Gems") and have >= def.Price then
                withLock(function()
                    Game.status = "Buying " .. id
                    teleport(pos + Vector3.new(0, 3, 0))
                    task.wait(0.4)
                    local ok, result = pcall(Remotes.BuyVehicle.InvokeServer, Remotes.BuyVehicle, id)
                    if ok and (result == true or (type(result) == "table" and result.Ok)) then
                        Game.carBuys[id] = -1
                        Game.bought += 1
                        notify("Bought " .. id, "Success")
                    else
                        Game.carBuys[id] = state + 1
                    end
                end)
            end
        end
    end
end

local Lobby = {
    saves = {},
    pad = nil,
    joining = false,
    classTries = {},
    wins = 0,
    onSavesChanged = nil,
}

local LobbyRemotes = ReplicatedStorage:FindFirstChild("Lobby") and ReplicatedStorage.Lobby:FindFirstChild("Remotes")
local LobbyConfig
pcall(function()
    LobbyConfig = require(ReplicatedStorage.Lobby.LobbyConfig)
end)

local function inLobby()
    local lobby = workspace:FindFirstChild("Lobby")
    return LobbyRemotes ~= nil and lobby ~= nil and lobby:FindFirstChild("LobbyPads") ~= nil
end

local function playerWins()
    return tonumber(LocalPlayer:GetAttribute("Wins")) or Lobby.wins or 0
end

local function difficultyWins(name)
    for _, d in ipairs(LobbyConfig and LobbyConfig.Difficulties or {}) do
        if d.Name == name then
            return d.Wins or 0
        end
    end
    return 0
end

local function idlePad()
    local pads = workspace.Lobby.LobbyPads
    for i = 1, 8 do
        local pad = pads:FindFirstChild("Pad" .. i)
        if pad and pad:GetAttribute("Status") == "Idle" then
            return pad
        end
