-- ============ HUNT / AIM LOOP ============
task.spawn(function()
    while not killed do
        task.wait(0.1)
        if not enabled then continue end
        if inventorySelling then continue end

        if state == "hunting" then
            local circle, dist, luck, stand = findBestCircleWithStand()
            if not circle then
                log("no reachable luck circle found")
                task.wait(0.5)
            else
                currentCircle = circle
                lastCircleName = circle.text
                log(string.format("target: %s (luck=%d) at %.0f studs", circle.text, luck, dist))

                local stay = false
                if STAY_ON_SAME_CIRCLE and sameCircle(circle, lastTargetCircle) then
                    local root = getRoot()
                    if root then
                        local dHere = horizDist(root.Position, circle.pos)
                        local nearStand = (not lastStandPos)
                            or horizDist(root.Position, lastStandPos) < STAY_MOVE_TOLERANCE
                        if dHere <= STAY_MAX_DIST and nearStand then stay = true end
                    end
                end

                if stay then
                    log("same circle as last cast, staying put")
                elseif stand then
                    noTeleport = false
                    lastStandPos = stand
                    log(string.format("teleporting to (%.1f, %.1f, %.1f)",
                        stand.X, stand.Y, stand.Z))
                    teleportTo(stand)
                    task.wait(POST_TELEPORT_WAIT)
                else
                    noTeleport = true
                    lastStandPos = nil
                    log(string.format("no ground near circle, casting from here (%.0f studs away)", dist))
                end
                lastTargetCircle = circle

                local hum = getHumanoid()
                if hum then
                    savedAutoRotate = hum.AutoRotate
                    hum.AutoRotate = false
                end

                faceTarget(circle.pos)
                setState("aiming")
            end
        end

        if state == "aiming" then
            if currentCircle then
                local circle = currentCircle
                local attempt = 0

                while enabled and not killed and state == "aiming" do
                    attempt = attempt + 1
                    local status, info, origin = castOnce(circle)
                    if status ~= "released" then break end
                    if not VERIFY_LANDING then break end

                    if not info.landing then
                        log("landing: no line found, can't verify")
                        lastLanding = "no line found"
                        break
                    end

                    local miss, along, lateral = evaluateLanding(circle, origin, info.landing)
                    local tol = circleHitRadius(circle)
                    local hit = miss <= tol
                    log(string.format("landing: %s | miss %.1f studs (tolerance %.1f) | %s %.1f | %s %.1f",
                        hit and "HIT" or "MISS", miss, tol,
                        along >= 0 and "long" or "short", math.abs(along),
                        lateral >= 0 and "right" or "left", math.abs(lateral)))
                    lastLanding = string.format("%s %.1f (%+.1f)", hit and "HIT" or "MISS", miss, along)

                    if ADAPTIVE_TRIM and not info.clamped then
                        holdTrim = math.clamp(
                            holdTrim - (along / STUDS_PER_SECOND) * TRIM_LEARN_RATE,
                            -TRIM_LIMIT, TRIM_LIMIT)
                    end

                    if hit or info.bite then break end
                    if not RECAST_ON_MISS or attempt > MAX_RECASTS then
                        log("giving up on this circle, fishing from here")
                        break
                    end

                    log("missed the circle -> resetting line and recasting")
                    if not resetLine() then
                        log("reset didn't finish, fishing from here")
                        break
                    end
                end

                restoreAutoRotate()
                lastQteTime = os.clock()
                if state == "aiming" then
                    log("waiting for bite")
                    setState("waiting")
                end
            else
                setState("idle")
            end
        end
    end
end)

