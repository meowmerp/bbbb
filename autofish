-- ============ SHUTDOWN ============
local function shutdown()
    if killed then return end
    killed = true
    enabled = false
    eUp()
    local cx, cy = getClickPoint()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    end)
    restoreAutoRotate()
    if fillConn then
        pcall(function() fillConn:Disconnect() end)
        fillConn = nil
    end
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(conns)
    state = "idle"
    updateGui()
    print("[Fisher] Killed and unloaded.")
    task.delay(0.15, function()
        pcall(function() gui:Destroy() end)
    end)
end

if getgenv then
    getgenv().AutoFisher.stop = shutdown
end

