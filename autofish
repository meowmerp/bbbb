-- ============ STATE ============
setState = function(s)
    if state == s then return end
    state = s
    if s == "idle" then idleSince = os.clock() end
    log("-> " .. s)
end

local function restoreAutoRotate()
    if savedAutoRotate ~= nil then
        local hum = getHumanoid()
        if hum then hum.AutoRotate = savedAutoRotate end
        savedAutoRotate = nil
    end
end

track(RunService.Heartbeat:Connect(function()
    if killed or not enabled then return end
    local now = os.clock()

    local ripple = findVisibleGui("Ripple")
    local reel   = findVisibleGui("Reel")

    if ripple or reel then lastQteTime = now end

    if reel then
        if state ~= "reeling" then
            if state == "holding" then eUp() end
            setState("reeling")
        end
        return
    end

    if ripple then
        if state ~= "holding" then
            local fill = getFillOf(ripple)
            local f = fill and fill.Size.X.Scale or 0
            if f < 0.3 then
                cachedRipple = ripple
                if fill ~= cachedFill then
                    cachedFill = fill
                    bindFill(fill)
                end
                eDown()
                setState("holding")
            end
        end
        return
    end

    if cachedRipple then
        cachedRipple = nil
        if fillConn then
            fillConn:Disconnect()
            fillConn = nil
        end
        cachedFill = nil
    end

    if state == "holding" then
        eUp()
        setState("waiting")
    elseif state == "reeling" then
        log("reel disappeared -> cast complete")
        setState("idle")
    elseif state == "waiting" then
        if now - lastQteTime > NO_QTE_TIMEOUT then
            log("no QTE for " .. NO_QTE_TIMEOUT .. "s, re-casting")
            setState("idle")
        end
    elseif state == "idle" then
        if AUTO_CAST and now - idleSince >= CAST_COOLDOWN then
            setState("hunting")
        end
    end
end))

-- ============ HUNT / AIM LOOP ============
task.spawn(function()
    while not killed do
        task.wait(0.1)
        if not enabled then continue end

        if state == "hunting" then
            local circle, dist, luck, stand = findBestCircleWithStand()
            if not circle then
                log("no reachable luck circle found")
                task.wait(0.5)
            else
                currentCircle = circle
                lastCircleName = circle.text
                log(string.format("target: %s (luck=%d) at %.0f studs", circle.text, luck, dist))

                local stay = false
                if STAY_ON_SAME_CIRCLE and sameCircle(circle, lastTargetCircle) then
                    local root = getRoot()
                    if root then
                        local dHere = horizDist(root.Position, circle.pos)
                        local nearStand = (not lastStandPos)
                            or horizDist(root.Position, lastStandPos) < STAY_MOVE_TOLERANCE
                        if dHere <= STAY_MAX_DIST and nearStand then stay = true end
                    end
                end

                if stay then
                    log("same circle as last cast, staying put")
                elseif stand then
                    noTeleport = false
                    lastStandPos = stand
                    log(string.format("teleporting to (%.1f, %.1f, %.1f)",
                        stand.X, stand.Y, stand.Z))
                    teleportTo(stand)
                    task.wait(POST_TELEPORT_WAIT)
                else
                    noTeleport = true
                    lastStandPos = nil
                    log(string.format("no ground near circle, casting from here (%.0f studs away)", dist))
                end
                lastTargetCircle = circle

                local hum = getHumanoid()
                if hum then
                    savedAutoRotate = hum.AutoRotate
                    hum.AutoRotate = false
                end

                faceTarget(circle.pos)
                setState("aiming")
            end
        end

        if state == "aiming" then
            if currentCircle then
                local circle = currentCircle
                local attempt = 0

                while enabled and not killed and state == "aiming" do
                    attempt = attempt + 1
                    local status, info, origin = castOnce(circle)
                    if status ~= "released" then break end

                    if not VERIFY_LANDING then break end

                    if not info.landing then
                        log("landing: no line found, can't verify")
                        lastLanding = "no line found"
                        break
                    end

                    local miss, along, lateral = evaluateLanding(circle, origin, info.landing)
                    local tol = circleHitRadius(circle)
                    local hit = miss <= tol
                    log(string.format("landing: %s | miss %.1f studs (tolerance %.1f) | %s %.1f | %s %.1f",
                        hit and "HIT" or "MISS", miss, tol,
                        along >= 0 and "long" or "short", math.abs(along),
                        lateral >= 0 and "right" or "left", math.abs(lateral)))
                    lastLanding = string.format("%s %.1f (%+.1f)", hit and "HIT" or "MISS", miss, along)

                    if ADAPTIVE_TRIM and not info.clamped then
                        holdTrim = math.clamp(
                            holdTrim - (along / STUDS_PER_SECOND) * TRIM_LEARN_RATE,
                            -TRIM_LIMIT, TRIM_LIMIT)
                    end

                    if hit or info.bite then break end
                    if not RECAST_ON_MISS or attempt > MAX_RECASTS then
                        log("giving up on this circle, fishing from here")
                        break
                    end

                    log("missed the circle -> resetting line and recasting")
                    if not resetLine() then
                        log("reset didn't finish, fishing from here")
                        break
                    end
                end

                restoreAutoRotate()
                lastQteTime = os.clock()
                if state == "aiming" then
                    log("waiting for bite")
                    setState("waiting")
                end
            else
                setState("idle")
            end
        end
    end
end)

-- Reel tapping loop
task.spawn(function()
    while not killed do
        task.wait(0.05)
        if enabled and state == "reeling" then
            log(string.format("reel: tapping E %d times", REEL_TAP_COUNT))
            for i = 1, REEL_TAP_COUNT do
                if killed or not enabled or state ~= "reeling" then break end
                eDown()
                task.wait(0.025)
                eUp()
                if i < REEL_TAP_COUNT then
                    task.wait(REEL_TAP_INTERVAL - 0.025)
                end
            end
            log("reel: done")
            while enabled and not killed and state == "reeling" do
                task.wait(0.05)
            end
        end
    end
end)

