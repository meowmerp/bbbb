-- ===== SELECT / SELL =====
local function selectCard(itemName)
    local card = findBagCard(itemName)
    if not card then return false, "no-card" end
    local btn = climbToButton(card)

    for _, m in ipairs(CLICK_METHODS) do
        if killed or not enabled then return false, "killed" end
        pcall(m.fn, btn)
        local deadline = os.clock() + SELL_SELECT_WAIT
        while os.clock() < deadline and not sellerConfirmsSelectedItem(itemName) do
            task.wait(0.05)
        end
        if sellerConfirmsSelectedItem(itemName) then
            return true, m.name
        end
    end
    return false, "all-methods-failed"
end

local function sellSelectedItem(itemName)
    local sellAllBtn, sellAllText = findSellAllButton()
    local sellBtn, sellText = findSellButton()

    local order = {}
    if sellAllBtn then
        order[#order+1] = { btn = sellAllBtn, label = "SELL ALL", text = sellAllText }
    end
    if sellBtn then
        order[#order+1] = { btn = sellBtn, label = "SELL", text = sellText }
    end

    if #order == 0 then return false, "no-button" end

    for _, entry in ipairs(order) do
        for _, m in ipairs(CLICK_METHODS) do
            if killed or not enabled then return false, "killed" end
            local wasPresent = findBagCard(itemName) ~= nil
            pcall(m.fn, entry.btn)
            task.wait(SELL_CLICK_WAIT)
            local nowPresent = findBagCard(itemName) ~= nil
            if wasPresent and not nowPresent then
                return true, entry.label .. " via " .. m.name
            end
            local panelName = getPanelItemName()
            if panelName and normalizeUiText(panelName) ~= normalizeUiText(itemName) then
                return true, entry.label .. " via " .. m.name
            end
        end
    end
    return false, "no-click-worked"
end

local function sellStashAtErica()
    if inventorySelling or killed or not enabled or state ~= "idle" then return end
    local root = getRoot()
    if not root then return end

    inventorySelling = true
    local returnCFrame = root.CFrame
    local openedSeller = false

    local saleOk, saleErr = pcall(function()
        setState("selling")
        log("going to Erica")

        local characterRoot = getRoot()
        if not characterRoot then error("character root missing") end
        characterRoot.CFrame = CFrame.lookAt(SELLER_STAND_POS, SELLER_FACE_POS)
        characterRoot.AssemblyLinearVelocity = Vector3.zero
        task.wait(SELLER_OPEN_WAIT)
        if killed or not enabled then return end

        eDown(); task.wait(0.12); eUp()

        if not waitForSellerGui(SELLER_GUI_TIMEOUT) then
            log("seller GUI did not open")
            return
        end
        openedSeller = true
        task.wait(PANEL_RENDER_WAIT)
        log("panel shows: " .. tostring(getPanelItemName()))

        for pass = 1, SELL_MAX_PASSES do
            if killed or not enabled then break end

            local present = {}
            for _, itemName in ipairs(SELL_ITEMS) do
                if findBagCard(itemName) then present[#present+1] = itemName end
            end
            log(string.format("pass %d: %d items present", pass, #present))
            if #present == 0 then break end

            local soldAny = false
            for _, itemName in ipairs(present) do
                if killed or not enabled then break end
                local ok1, m1 = selectCard(itemName)
                if ok1 then
                    local ok2, m2 = sellSelectedItem(itemName)
                    if ok2 then
                        log("SOLD " .. itemName .. " (" .. m2 .. ")")
                        soldAny = true
                    else
                        log("sell failed for " .. itemName .. " (" .. m2 .. ")")
                    end
                    task.wait(0.3)
                else
                    log("could not select " .. itemName .. " (" .. tostring(m1) .. ")")
                end
            end

            if not soldAny then
                log("pass " .. pass .. ": nothing sold, stopping")
                break
            end
        end

        task.wait(0.3)
    end)

    eUp()
    if openedSeller and sellerGuiIsOpen() then
        log("closing panel (Q twice)")
        pcall(closeSellerGui)
    end

    local currentRoot = getRoot()
    if currentRoot and returnCFrame then
        currentRoot.CFrame = returnCFrame
        currentRoot.AssemblyLinearVelocity = Vector3.zero
    end

    inventorySelling = false
    if not killed then setState("idle") end
    if not saleOk then log("seller error: " .. tostring(saleErr)) end

    if enabled and not killed then
        task.wait(0.5)
        local remaining = getStashCount()
        if remaining and remaining >= STASH_SELL_AT then
            enabled = false
            sellThresholdLatched = true
            setState("idle")
            log("stash still " .. remaining .. "/" .. STASH_CAPACITY .. " after allowed-item sale; AutoFish paused")
            updateGui()
        end
    end
end

local function checkStashAndMaybeSell(reason)
    if killed or not enabled or inventorySelling then return end

    local count = getStashCount()
    if count then
        lastStashText = tostring(count) .. "/" .. STASH_CAPACITY
    else
        lastStashText = "--/" .. STASH_CAPACITY
    end
    updateGui()

    if not count then return end
    if count < STASH_SELL_AT then
        sellThresholdLatched = false
        return
    end

    if sellThresholdLatched then
        if enabled then
            enabled = false
            eUp()
            restoreAutoRotate()
            setState("idle")
            log("stash remains at/above threshold; AutoFish paused")
            updateGui()
        end
        return
    end

    if not enabled then return end
    if state ~= "idle" then return end
    if findVisibleGui("Ripple") or findVisibleGui("Reel") then return end

    sellThresholdLatched = true
    if count >= STASH_CAPACITY then
        log("stash full at " .. count .. "/" .. STASH_CAPACITY .. " (" .. reason .. "); selling")
    else
        log("stash at " .. count .. "/" .. STASH_CAPACITY .. " (" .. reason .. "); selling")
    end
    task.spawn(sellStashAtErica)
end

track(RunService.Heartbeat:Connect(function()
    if killed or not enabled or inventorySelling then return end
    local now = os.clock()

    local ripple = findVisibleGui("Ripple")
    local reel   = findVisibleGui("Reel")

    if ripple or reel then lastQteTime = now end

