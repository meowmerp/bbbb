-- ============ INVENTORY / ERICA SELLER ============
local function normalizeUiText(value)
    return string.upper((value or ""):gsub("%s+", ""):gsub("[^%w]", ""))
end

local function isStashLabel(d)
    local full = d:GetFullName()
    return string.find(full, "fishing_stash", 1, true) ~= nil
        or string.find(full, "FishingStash", 1, true) ~= nil
end

local function getStashCount()
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and guiVisible(d) and isStashLabel(d) then
            local raw = d.Text or ""
            local stripped = raw:gsub("%s+", "")
            local cur, cap = stripped:match("(%d+)[/⁄](%d+)")
            if cap and tonumber(cap) == STASH_CAPACITY then
                return tonumber(cur)
            end
        end
    end
    return nil
end

local function visibleTextContains(fragment)
    local wanted = normalizeUiText(fragment)
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and guiVisible(d) then
            if string.find(normalizeUiText(d.Text), wanted, 1, true) then
                return d
            end
        end
    end
    return nil
end

local function findBagCard(itemName)
    local wanted = normalizeUiText(itemName)
    local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
    local bagYMin = vp.Y * 0.78
    local best, bestY = nil, -math.huge
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and guiVisible(d)
            and normalizeUiText(d.Text) == wanted then
            local pos = d.AbsolutePosition
            if pos.Y >= bagYMin and pos.Y > bestY then
                best, bestY = d, pos.Y
            end
        end
    end
    return best
end

local function climbToButton(g)
    local p = g
    while p and p ~= playerGui do
        if p:IsA("GuiButton") then return p end
        p = p.Parent
    end
    return g
end

local function findSellAllButton()
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and guiVisible(d) then
            local txt = (d.Text or ""):gsub("%s+", " ")
            if string.upper(txt):sub(1, 8) == "SELL ALL" then
                local btn = climbToButton(d)
                if btn and btn:IsA("GuiButton") then
                    return btn, txt
                end
            end
        end
    end
    return nil
end

local function findSellButton()
    for _, d in ipairs(playerGui:GetDescendants()) do
        if d:IsA("TextLabel") and guiVisible(d) and d.Name == "word" then
            local txt = (d.Text or ""):gsub("%s+", "")
            if string.upper(txt) == "SELL" then
                local btn = climbToButton(d)
                if btn and btn:IsA("GuiButton") then
                    return btn, d.Text
                end
            end
        end
    end
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and guiVisible(d) then
            local txt = (d.Text or ""):gsub("%s+", "")
            if string.upper(txt) == "SELL" then
                local btn = climbToButton(d)
                if btn and btn:IsA("GuiButton") then
                    return btn, d.Text
                end
            end
        end
    end
    return nil
end

local function findSellerPanelRoot()
    local title = visibleTextContains("SELL YOUR CATCH")
    if not title then return nil end
    local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
    local p = title.Parent
    while p and p ~= playerGui do
        if p:IsA("Frame") or p:IsA("CanvasGroup") or p:IsA("ScrollingFrame") then
            local s = p.AbsoluteSize
            if s.X >= vp.X * 0.20 and s.Y >= vp.Y * 0.25 then return p end
        end
        p = p.Parent
    end
    return nil
end

local function getPanelItemName()
    local panel = findSellerPanelRoot()
    if not panel then return nil end
    for _, d in ipairs(panel:GetDescendants()) do
        if d:IsA("TextLabel") and guiVisible(d) and d.Name == "name" and d.Text and d.Text ~= "" then
            return d.Text
        end
    end
    return nil
end

local function sellerConfirmsSelectedItem(itemName)
    local shown = getPanelItemName()
    if not shown then return false end
    return normalizeUiText(shown) == normalizeUiText(itemName)
end

local function sellerGuiIsOpen()
    return visibleTextContains("SELL YOUR CATCH") ~= nil
end

local function waitForSellerGui(timeout)
    local deadline = os.clock() + timeout
    while os.clock() < deadline do
        if sellerGuiIsOpen() then return true end
        if killed or not enabled then return false end
        task.wait(0.1)
    end
    return sellerGuiIsOpen()
end

-- ===== CLICK METHODS (firesignal first) =====
local function clickFiresignal(btn)
    pcall(function()
        if not firesignal then return end
        if btn.MouseButton1Down then firesignal(btn.MouseButton1Down) end
        if btn.MouseButton1Up then firesignal(btn.MouseButton1Up) end
        if btn.MouseButton1Click then firesignal(btn.MouseButton1Click) end
        if btn.Activated then firesignal(btn.Activated) end
    end)
end
local function clickFireSignal(btn)
    pcall(function() if btn.MouseButton1Down then btn.MouseButton1Down:Fire() end end)
    pcall(function() if btn.MouseButton1Up then btn.MouseButton1Up:Fire() end end)
    pcall(function() if btn.MouseButton1Click then btn.MouseButton1Click:Fire() end end)
    pcall(function() if btn.Activated then btn.Activated:Fire() end end)
end
local function clickVIM(btn)
    local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
    VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 1)
end
local function clickConnections(btn)
    pcall(function()
        if getconnections and btn.MouseButton1Click then
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                if c.Function then pcall(c.Function) end
            end
        end
    end)
    pcall(function()
        if getconnections and btn.Activated then
            for _, c in ipairs(getconnections(btn.Activated)) do
                if c.Function then pcall(c.Function) end
            end
        end
    end)
end
local function clickMouse1(btn)
    local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
    pcall(function()
        if mousemoverel then
            local delta = Vector2.new(c.X, c.Y) - UserInputService:GetMouseLocation()
            mousemoverel(delta.X, delta.Y)
            task.wait(0.1)
        end
    end)
    pcall(function()
        if mouse1press and mouse1release then
            mouse1press(); task.wait(0.05); mouse1release()
        end
    end)
end

local CLICK_METHODS = {
    { name = "firesignal",  fn = clickFiresignal },
    { name = "fireSignal",  fn = clickFireSignal },
