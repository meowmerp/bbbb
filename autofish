-- ============ FIGHT / FISH BUTTON ============
local function guiVisible(g)
    local cur = g
    while cur and cur ~= playerGui do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("LayerCollector") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function findText(word)
    for _, d in ipairs(playerGui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and guiVisible(d) then
            local t = string.upper((d.Text:gsub("%s+", "")))
            if t == word then return d end
        end
    end
    return nil
end

local function clickGui(g)
    local target = g
    local p = g
    while p and p ~= playerGui do
        if p:IsA("GuiButton") then
            target = p
            break
        end
        p = p.Parent
    end
    local c = target.AbsolutePosition + target.AbsoluteSize / 2
    local x, y = c.X, c.Y
    if CLICK_INSET then
        local inset = GuiService:GetGuiInset()
        x = x + inset.X
        y = y + inset.Y
    end
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function waitForFight(timeout)
    local deadline = os.clock() + timeout
    while os.clock() < deadline do
        if findText("FIGHT") then return true end
        if killed or not enabled then return false end
        task.wait(0.25)
    end
    return findText("FIGHT") ~= nil
end

local function resetLine()
    for i = 1, 2 do
        if killed or not enabled or state ~= "aiming" then return false end
        local b = findText("FIGHT") or findText("FISH")
        if not b then
            log("reset: no FIGHT/FISH button found")
            return false
        end
        log(string.format("reset click %d on '%s'", i, b.Text))
        clickGui(b)
        task.wait(RESET_CLICK_GAP)
    end
    return waitForFight(3)
end

-- ============ LUCK CIRCLES ============
local CIRCLE_NAMES = {
    Common = true, Rare = true, Epic = true, Legendary = true, Vaulted = true,
}

local function getLuckValue(text)
    local n = string.match(text, "%+(%d+)%%")
    return tonumber(n) or 0
end

local function findLuckCircles()
    local found = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BillboardGui") then
            local txt = nil
            for _, c in ipairs(d:GetDescendants()) do
                if c:IsA("TextLabel") and c.Text ~= "" then
                    txt = c.Text
                    break
                end
            end
            if txt and string.find(txt, LUCK_TEXT_MATCH, 1, true) then
                local parent = d.Parent
                if parent and parent:IsA("BasePart") then
                    found[#found + 1] = {
                        part = parent,
                        text = txt,
                        pos  = parent.Position,
                        luck = getLuckValue(txt),
                    }
                end
            end
        end
    end
    return found
end

local function isSolidGround(hit, circlePart)
    if not hit then return false end
    if hit.Normal.Y < 0.7 then return false end
    if hit.Material == Enum.Material.Water then return false end
    local name = hit.Instance.Name
    if CIRCLE_NAMES[name] then return false end
    if circlePart and (hit.Instance == circlePart) then return false end
    return true
end

local function findStandPos(circle)
    local root = getRoot()
    if not root then return nil end
    local myPos = root.Position
    local circlePos = circle.pos

    local baseDir = myPos - circlePos
    baseDir = Vector3.new(baseDir.X, 0, baseDir.Z)
    if baseDir.Magnitude < 0.1 then
        baseDir = Vector3.new(1, 0, 0)
    else
        baseDir = baseDir.Unit
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { lp.Character }

    for _, d in ipairs(STAND_DISTANCES) do
        for _, ang in ipairs(STAND_ANGLE_OFFSETS) do
            local cosA, sinA = math.cos(ang), math.sin(ang)
            local dir = Vector3.new(
                baseDir.X * cosA - baseDir.Z * sinA,
                0,
                baseDir.X * sinA + baseDir.Z * cosA
            )
            local want = circlePos + dir * d
            local origin = Vector3.new(want.X, circlePos.Y + 200, want.Z)
            local hit = workspace:Raycast(origin, Vector3.new(0, -800, 0), params)
            if isSolidGround(hit, circle.part) then
                return Vector3.new(hit.Position.X, hit.Position.Y + 3, hit.Position.Z)
            end
        end
    end
    return nil
end

local function findBestCircleWithStand()
    local root = getRoot()
    if not root then return nil end
    local myPos = root.Position

    local candidates = {}
    for _, c in ipairs(findLuckCircles()) do
        if c.luck >= MIN_LUCK_PERCENT then
            local d = (c.pos - myPos).Magnitude
            if d <= LUCK_MAX_DIST then
                candidates[#candidates + 1] = { circle = c, dist = d }
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.circle.luck ~= b.circle.luck then
            return a.circle.luck > b.circle.luck
        end
        return a.dist < b.dist
    end)

    for _, entry in ipairs(candidates) do
        local stand = findStandPos(entry.circle)
        if stand then
            return entry.circle, entry.dist, entry.circle.luck, stand
        end
        if entry.dist <= MAX_FALLBACK_CAST then
            return entry.circle, entry.dist, entry.circle.luck, nil
        end
    end
    return nil
end

local function teleportTo(pos)
    local root = getRoot()
    if not root then return end
    root.CFrame = CFrame.new(pos)
    root.AssemblyLinearVelocity = Vector3.zero
end

local function faceTarget(targetPos)
    local root = getRoot()
    if not root then return end
    local myPos = root.Position
    local flatTarget = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
    if (flatTarget - myPos).Magnitude < 0.1 then return end
    root.CFrame = CFrame.lookAt(myPos, flatTarget)
end

local function horizDist(a, b)
    local dx = a.X - b.X
    local dz = a.Z - b.Z
    return math.sqrt(dx*dx + dz*dz)
end

local function sameCircle(a, b)
    if not a or not b then return false end
    if a.part == b.part then return true end
    return horizDist(a.pos, b.pos) < 2
end

-- ============ LINE / LANDING CHECK ============
local LINE_CLASSES = { Beam = true, RopeConstraint = true, RodConstraint = true }

local function beginLineWatch()
    local snap = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if LINE_CLASSES[d.ClassName] then
            local a0, a1 = d.Attachment0, d.Attachment1
            if a0 and a1 then
                snap[d] = { a = a0.WorldPosition, b = a1.WorldPosition }
            else
                snap[d] = {}
            end
        end
    end
    local ctx = { newLines = {}, newParts = {} }
    local char = lp.Character
    local conn = workspace.DescendantAdded:Connect(function(d)
        if LINE_CLASSES[d.ClassName] then
            ctx.newLines[d] = true
        elseif d:IsA("BasePart") and not (char and d:IsDescendantOf(char)) then
            ctx.newParts[d] = true
        end
    end)
    return snap, ctx, conn
end

local function currentLanding(snap, ctx, origin)
    local bestEnd, bestd = nil, 0

    local function consider(a, b)
        local da, db = (a - origin).Magnitude, (b - origin).Magnitude
        if math.min(da, db) < NEAR_PLAYER then
            local farEnd = (da > db) and a or b
            local fd = horizDist(farEnd, origin)
            if fd > bestd then
                bestEnd, bestd = farEnd, fd
            end
        end
    end

    local function checkLine(d)
        if not d.Parent then return end
        local a0, a1 = d.Attachment0, d.Attachment1
        if not (a0 and a1) then return end
        if d.ClassName == "Beam" and not d.Enabled then return end
        local a, b = a0.WorldPosition, a1.WorldPosition
        local old = snap[d]
        local changed = (old == nil) or (old.a == nil)
            or (old.a - a).Magnitude > 0.5 or (old.b - b).Magnitude > 0.5
        if changed then consider(a, b) end
    end

    for d in pairs(snap) do checkLine(d) end
    for d in pairs(ctx.newLines) do checkLine(d) end

    for inst in pairs(ctx.newParts) do
        if inst.Parent then
            local s = inst.Size
            local m = math.max(s.X, s.Y, s.Z)
            local axis, o1, o2
            if s.X == m then
                axis = Vector3.new(1, 0, 0)
                o1, o2 = s.Y, s.Z
            elseif s.Y == m then
                axis = Vector3.new(0, 1, 0)
                o1, o2 = s.X, s.Z
            else
                axis = Vector3.new(0, 0, 1)
                o1, o2 = s.X, s.Y
            end
            if m > 5 and o1 < 0.6 and o2 < 0.6 then
                local dir = inst.CFrame:VectorToWorldSpace(axis)
                consider(inst.Position - dir * (m / 2), inst.Position + dir * (m / 2))
            end
        end
    end

    return bestEnd, bestd
end

local function circleHitRadius(circle)
    local r = DEFAULT_HIT_RADIUS
    local p = circle.part
    if p and p.Parent then
        local s = p.Size
        local half = math.max(s.X, s.Z) / 2
        if half >= 2 and half <= 80 then r = half end
    end
    return math.max(HIT_RADIUS_MIN, r * HIT_RADIUS_SCALE)
end

local function evaluateLanding(circle, origin, landing)
    local flatErr = Vector3.new(landing.X - circle.pos.X, 0, landing.Z - circle.pos.Z)
    local aim = Vector3.new(circle.pos.X - origin.X, 0, circle.pos.Z - origin.Z)
    local along, lateral = 0, 0
    if aim.Magnitude > 0.1 then
        local u = aim.Unit
        along = flatErr:Dot(u)
        lateral = flatErr:Dot(Vector3.new(-u.Z, 0, u.X))
    end
    return flatErr.Magnitude, along, lateral
end

local function castOnce(circle)
    faceTarget(circle.pos)
    task.wait(PRE_AIM_DELAY)

    local root = getRoot()
    if not root then return "aborted" end
    local origin = root.Position

    if not waitForFight(3) then
        log("WARNING: FIGHT button not showing (rod not out?)")
    end

    local dist2 = horizDist(origin, circle.pos)
    local rawHold = dist2 * SECONDS_PER_STUD + holdTrim
    local hold = math.clamp(rawHold, CAST_MIN_HOLD, CAST_MAX_HOLD)
    local clamped = (rawHold > CAST_MAX_HOLD) or (rawHold < CAST_MIN_HOLD)
    if dist2 > CAST_MAX_RANGE then
        log(string.format("WARNING: %.0f studs is beyond the %d stud max range, cast will fall short", dist2, CAST_MAX_RANGE))
    end
    log(string.format("dist %.0f studs -> hold %.2fs (trim %+.3f)", dist2, hold, holdTrim))

    local snap, ctx, conn
    if VERIFY_LANDING then
        snap, ctx, conn = beginLineWatch()
    end

    local cx, cy = getClickPoint()
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)

    local holdStart = os.clock()
    local holdEnd = holdStart + hold
    while os.clock() < holdEnd and enabled and not killed do
        faceTarget(circle.pos)
        task.wait(0.02)
    end

    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    local realHold = os.clock() - holdStart
    log(string.format("cast released (real hold %.2fs)", realHold))

    local info = { dist = dist2, hold = hold, realHold = realHold, clamped = clamped }

    if VERIFY_LANDING then
        local t0 = os.clock()
        local lastPos, stableSince = nil, nil
        while os.clock() - t0 < SETTLE_TIME and enabled and not killed and state == "aiming" do
            local endPos = currentLanding(snap, ctx, origin)
            if endPos then
                info.landing = endPos
                if lastPos and (endPos - lastPos).Magnitude < 0.3 then
                    stableSince = stableSince or os.clock()
                    if os.clock() - stableSince >= 0.5 and os.clock() - t0 >= 1.0 then
                        break
                    end
                else
                    stableSince = nil
                end
                lastPos = endPos
            end
            task.wait(0.1)
        end
        conn:Disconnect()
        info.bite = (state ~= "aiming")
    end

    return "released", info, origin
end

