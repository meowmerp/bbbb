                eDown()
                setState("holding")
            end
        end
        return
    end

    if cachedRipple then
        cachedRipple = nil
        if fillConn then
            fillConn:Disconnect()
            fillConn = nil
        end
        cachedFill = nil
    end

    if state == "holding" then
        eUp()
        setState("waiting")
    elseif state == "reeling" then
