-- ACTIVITY LOG LOGIC
local NON_ACTIVITY_TAGS: {[string]: boolean} = {
	["STUCK?"] = true,
	["RECOVER"] = true,
	["INFO"] = true,
}

local function logLine(tag: string, msg: string): ()
	local line = string.format("[%7.2f] [%s] %s", os.clock() - logT0, tag, msg)
	print(line)

	logTotalLines = logTotalLines + 1
	logBuffer[#logBuffer + 1] = line
	while #logBuffer > LOG_BUFFER_MAX do
		table.remove(logBuffer, 1)
	end

	logLineCount = logLineCount + 1
	lastLogLine  = line
	if not NON_ACTIVITY_TAGS[tag] then
		lastActivityTime = os.clock()
	end

	local mobName = extractMobName(line)
	if mobName then saveMobName(mobName) end
end

local function flushLog(): ()
	if not HAS_WRITE then return end
	pcall(function()
		if HAS_APPEND and isfile("activity_log.txt") and logTotalLines > logWrittenLines then
			local firstInBuffer = logTotalLines - #logBuffer + 1
			local fromIdx = (logWrittenLines + 1) - firstInBuffer + 1
			if fromIdx < 1 then fromIdx = 1 end
			if fromIdx <= #logBuffer then
				local chunk = table.create(#logBuffer - fromIdx + 1)
				for i = fromIdx, #logBuffer do
					chunk[#chunk + 1] = logBuffer[i]
				end
				appendfile("activity_log.txt", table.concat(chunk, "\n") .. "\n")
			end
			logWrittenLines = logTotalLines
		else
			writefile("activity_log.txt", table.concat(logBuffer, "\n"))
		end
	end)
end

local enemyCache: {EnemyEntry} = {}
local lastScan = 0

local function scanEnemies(): {EnemyEntry}
	if os.clock() - lastScan < 1.5 then return enemyCache end
	lastScan = os.clock()

	local list: {EnemyEntry} = {}
	local char = lp.Character
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("Humanoid") and d.Health > 0 then
			local model = d.Parent
			if model and model ~= char
				and not Players:GetPlayerFromCharacter(model) then
				local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
				if root then
					list[#list + 1] = { model = model, hum = d, root = root }
				end
			end
		end
	end
	enemyCache = list

	-- Update lastGoodPos here, now that the cache is fresh.
	-- This was previously done every frame; moving it here eliminates
	-- a full per-frame iteration over the enemy list.
	local root = cachedRoot
	if root and root.Parent then
		local pos = root.Position
		local best: EnemyEntry? = nil
		local bestD: number? = nil
		for _, e in ipairs(list) do
			if e.root.Parent and not isBlacklisted(e.model) then
				local d = (e.root.Position - pos).Magnitude
				if not bestD or d < bestD then
					best, bestD = e, d
				end
			end
		end
		if best and bestD and bestD < GOODPOS_MIN_DIST then
			lastGoodPos = pos
			lastGoodTime = os.clock()
		end
	end

	return list
end

local function nearestEnemy(pos: Vector3): (EnemyEntry?, number?)
	local best: EnemyEntry? = nil
	local bestD: number? = nil
	for _, e in ipairs(scanEnemies()) do
		if e.root.Parent then
			local d = (e.root.Position - pos).Magnitude
			if not bestD or d < bestD then best, bestD = e, d end
		end
	end
	return best, bestD
end

local function nearestValidMob(pos: Vector3): (EnemyEntry?, number?)
	local best: EnemyEntry? = nil
	local bestD: number? = nil
	for _, e in ipairs(scanEnemies()) do
		if e.root.Parent and not isBlacklisted(e.model) then
			local d = (e.root.Position - pos).Magnitude
			if not bestD or d < bestD then best, bestD = e, d end
		end
	end
	return best, bestD
end

