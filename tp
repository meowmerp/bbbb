-- Remote hook: remotes are NOT logged at all. They still count as
-- "farm is alive" so stuck detection doesn't false-fire on a boss.
do
	local hookOk, hookErr = pcall(function()
		local old
		old = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			if not killed and logRunning
				and (method == "FireServer" or method == "InvokeServer") then
				lastActivityTime = os.clock()
			end
			return old(self, ...)
		end)
	end)
	if not hookOk then
		warn("[FarmAssist] hookmetamethod unavailable: " .. tostring(hookErr))
	end
end

-- ============ MERGED HEARTBEAT ============
-- One Heartbeat drives both the Fall Freeze and the Activity Log.
-- Freeze logic runs first (matching original order), watcher second.
conns[#conns + 1] = RunService.Heartbeat:Connect(function()
	if killed then return end

	local root, hum = getRoot()
	local now = os.clock()

	-- ===== FALL FREEZE =====
	if freezeEnabled then
		if not root then
			anchored, lastPos = false, nil
		else
			local pos = root.Position
			if anchored then
				if lastPos and (pos - lastPos).Magnitude > MOVE_RELEASE then
					release(root)
					pushFreezeLog("released (farm moved you)")
				elseif now - frozenAt >= SETTLE_AFTER then
					if settleOnFloor(root) then
						release(root)
					else
						frozenAt = now + RETRY_AFTER
					end
				end
			elseif root.AssemblyLinearVelocity.Y < FALL_SPEED then
				root.AssemblyLinearVelocity = Vector3.zero
				root.Anchored = true
				anchored = true
				frozenAt = now
				catches = catches + 1
				pushFreezeLog(string.format("caught fall #%d at y=%.1f", catches, pos.Y))
			end
			lastPos = root.Position
		end
	end

	-- ===== ACTIVITY LOG =====
	if logRunning then
		if not root then
			wLastPos = nil
		else
			local pos = root.Position

			if wLastPos and (pos - wLastPos).Magnitude >= TELEPORT_DIST then
				local e, d = nearestEnemy(pos)
				logLine("TELEPORT", string.format("%s -> %s (%.0f studs) | nearest enemy: %s (%.1f away)",
					fmtV(wLastPos), fmtV(pos), (pos - wLastPos).Magnitude,
					e and e.model.Name or "none", d or 0))
			end
			wLastPos = pos

			if not wLastMoveCheckPos or (pos - wLastMoveCheckPos).Magnitude > STUCK_MOVE then
				wLastMoveCheckPos, wLastMoveTime = pos, now
			elseif now - wLastMoveTime >= STUCK_SECONDS
				and now - wLastStuckLog > 5
				and now - lastActivityTime >= RECOVER_LOG_SILENCE then
				wLastStuckLog = now

				local e, d = nearestEnemy(pos)
				local info = string.format(
					"not moving for %ds | pos %s | state %s | anchored %s | WalkSpeed %s | health %s",
					STUCK_SECONDS, fmtV(pos),
					hum and tostring(hum:GetState()) or "?",
					tostring(root.Anchored),
					hum and tostring(hum.WalkSpeed) or "?",
					hum and string.format("%.0f/%.0f", hum.Health, hum.MaxHealth) or "?")
				if e then
					info = info .. string.format(" | nearest enemy %s %.1f studs away, hp %.0f, parent %s",
						e.model.Name, d, e.hum.Health,
						e.model.Parent and e.model.Parent.Name or "nil")
				else
					info = info .. " | NO living enemies found in workspace"
				end
				logLine("STUCK?", info)

				if AUTO_RECOVER then
					local sinceStart = now - logT0
					local sinceLast  = now - lastAutoRecover

					if sinceStart < STARTUP_GRACE then
						logLine("RECOVER", string.format(
							"skipped (startup grace, %.1fs left)", STARTUP_GRACE - sinceStart))
					elseif sinceLast < STUCK_TELEPORT_COOLDOWN then
						logLine("RECOVER", string.format(
							"skipped (cooldown, %.1fs left)", STUCK_TELEPORT_COOLDOWN - sinceLast))
					else
						local mob, mobDist = nearestValidMob(pos)
						if not mob then
							if lastGoodPos and (now - lastGoodTime) < GOODPOS_MAX_AGE then
								root.CFrame = CFrame.new(lastGoodPos + Vector3.new(0, 3, 0))
								root.AssemblyLinearVelocity = Vector3.zero
								lastAutoRecover = now
								autoRecovers = autoRecovers + 1
								logLine("RECOVER", string.format(
									"no mobs nearby -> returned to last good spot %s (%.0fs ago) | attempt #%d",
									fmtV(lastGoodPos), now - lastGoodTime, autoRecovers))
							else
								logLine("RECOVER", "no valid mob and no recent good position")
							end
						elseif mobDist and mobDist > STUCK_TELEPORT_MAXDIST then
							logLine("RECOVER", string.format(
								"skipped (nearest valid mob %s too far: %.0f > %d)",
								mob.model.Name, mobDist, STUCK_TELEPORT_MAXDIST))
						else
							local mobPos = mob.root.Position
							local dir = Vector3.new(pos.X - mobPos.X, 0, pos.Z - mobPos.Z)
							if dir.Magnitude < 0.1 then
								dir = Vector3.new(1, 0, 0)
							else
								dir = dir.Unit
							end
							local targetPos = Vector3.new(
								mobPos.X + dir.X * STUCK_TELEPORT_RANGE,
								mobPos.Y + 3,
								mobPos.Z + dir.Z * STUCK_TELEPORT_RANGE)
							root.CFrame = CFrame.new(targetPos)
							root.AssemblyLinearVelocity = Vector3.zero
							lastAutoRecover = now
							autoRecovers = autoRecovers + 1
							logLine("RECOVER", string.format(
								"teleported to %s from %s (%.0f studs, target %s) | attempt #%d",
								fmtV(targetPos), mob.model.Name, mobDist,
								mob.model.Name, autoRecovers))
						end
					end
				end
			end
		end
	end
end)

local function watchChar(char: Model): ()
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	conns[#conns + 1] = hum.StateChanged:Connect(function(_, new)
		if not killed and logRunning then logLine("STATE", tostring(new)) end
	end)
	conns[#conns + 1] = hum.Died:Connect(function()
		if not killed and logRunning then logLine("EVENT", "You died") end
	end)
end
if lp.Character then task.spawn(watchChar, lp.Character) end
conns[#conns + 1] = lp.CharacterAdded:Connect(function(c)
	if logRunning then logLine("EVENT", "Character respawned") end
	task.spawn(watchChar, c)
end)

task.spawn(function()
	while not killed do
		task.wait(5)
		if killed then break end
		flushLog()
	end
end)

-- GUI REFRESH
local function refreshFreezeGui(): ()
	local r = getRoot()
	if freezeEnabled then
		dot.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
		mainLabel.Text = "Fall Freeze: ON"
	else
		dot.BackgroundColor3 = Color3.fromRGB(230, 70, 70)
		mainLabel.Text = "Fall Freeze: OFF"
	end

	if not r then
		stateLabel.Text = "State: no character"
		stateLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		posLabel.Text = "Y: --"
	else
		if anchored then
			local left = math.max(0, SETTLE_AFTER - (os.clock() - frozenAt))
			stateLabel.Text = string.format("State: FROZEN (floor check in %.1fs)", left)
			stateLabel.TextColor3 = Color3.fromRGB(255, 190, 80)
		elseif freezeEnabled then
			stateLabel.Text = "State: watching"
			stateLabel.TextColor3 = Color3.fromRGB(120, 190, 255)
		else
			stateLabel.Text = "State: paused"
			stateLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
		local p, v = r.Position, r.AssemblyLinearVelocity
		posLabel.Text = string.format("Pos: %.0f, %.1f, %.0f   fall speed: %.0f",
			p.X, p.Y, p.Z, v.Y)
	end
	statLabel.Text = string.format("Falls caught: %d   Floor placements: %d", catches, settles)
end

local function refreshLogGui(): ()
	if logRunning then
		wDot.BackgroundColor3 = Color3.fromRGB(70, 220, 100)
		wMain.Text = string.format("Activity Log: RUNNING  (%d lines)", logLineCount)
	else
		wDot.BackgroundColor3 = Color3.fromRGB(230, 70, 70)
		wMain.Text = string.format("Activity Log: PAUSED  (%d lines)", logLineCount)
	end
	wRecover.Text = string.format("Auto-recover: %d   (range %d studs)", autoRecovers, STUCK_TELEPORT_RANGE)

	-- Reuse the persistent tail buffer (no per-tick allocations)
	table.clear(tailBuffer)
	local startIdx = math.max(1, #logBuffer - 2)
	for i = startIdx, #logBuffer do
		tailBuffer[#tailBuffer + 1] = logBuffer[i]
	end
	wLast.Text = #tailBuffer > 0 and table.concat(tailBuffer, "\n") or "(no output yet)"

	if lastMobSeen ~= "" then
		wMobs.Text = string.format("Mobs known: %d   (last: %s)", knownMobsCount, lastMobSeen)
	else
		wMobs.Text = string.format("Mobs known: %d", knownMobsCount)
	end
end

task.spawn(function()
	while not killed do
		task.wait(0.1)
		if killed then break end
		pcall(refreshFreezeGui)
		pcall(refreshLogGui)
	end
end)

-- KILL
local function kill(): ()
	if killed then return end
	killed = true
	logRunning    = false
	freezeEnabled = false
	release(cachedRoot)
	for _, c in ipairs(conns) do c:Disconnect() end
	table.clear(conns)
	flushLog()
	dot.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
	mainLabel.Text = "Killed"
	wDot.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
	wMain.Text = "Activity Log: STOPPED"
	task.delay(1.2, function() gui:Destroy() end)
	print("[FarmAssist] Killed.")
end
if getgenv then
	getgenv().FallFreeze.kill   = kill
	getgenv().ActivityLog.stop  = kill
end

conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input)
	if killed or UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode == TOGGLE_KEY then
		local newState = not (freezeEnabled and logRunning)
		freezeEnabled = newState
		logRunning    = newState
		if newState then
			lastActivityTime  = os.clock()
			wLastMoveCheckPos = nil
			wLastPos          = nil
			wLastStuckLog     = 0
			pushFreezeLog("enabled (freeze + log)")
		else
			release(cachedRoot)
			pushFreezeLog("paused (freeze + log)")
		end
	elseif input.KeyCode == KILL_KEY then
		kill()
	end
end)

