            TweenService:Create(track, TweenInfo.new(0.15), { BackgroundColor3 = state and Theme.accent or Theme.track }):Play()
            TweenService:Create(knob, TweenInfo.new(0.15), { Position = UDim2.new(0, state and 18 or 2, 0.5, -8) }):Play()
            if fire then
                local flagKey = TOGGLE_FLAG_KEYS[label]

                -- Write the value from the actual UI toggle directly into Flags.
                -- Then run the feature callback and re-assert it in case a callback
                -- fails. Persistence does not depend on each callback saving itself.
                if flagKey then
                    Flags[flagKey] = state == true
                end

                local callbackOk, callbackErr = pcall(onChanged, state)
                if flagKey then
                    Flags[flagKey] = state == true
                end

                local saveOk, saveErr = saveConfig(true)
                if not callbackOk then
                    warn("[TheForest] Toggle callback failed for '" .. tostring(label) .. "': " .. tostring(callbackErr))
                end
                if saveOk then
                    print("[TheForest] Saved toggle " .. tostring(flagKey or label) .. "=" .. tostring(state) .. " to " .. CONFIG_FILE)
                else
                    warn("[TheForest] Toggle save failed for '" .. tostring(label) .. "': " .. tostring(saveErr))
                end
            end
        end
        btn.MouseButton1Click:Connect(function() 
            set(not state, true) 
        end)
        local hit = new("TextButton", { Size = UDim2.new(1, -40, 1, 0), BackgroundTransparency = 1, Text = "" }, row)
        hit.MouseButton1Click:Connect(function() 
            set(not state, true) 
        end)
    end

    local function addSlider(parent, label, minV, maxV, initial, step, fmt, onChanged)
        local container = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1 }, parent)
        new("TextLabel", { Size = UDim2.new(0.6, 0, 0, 16), BackgroundTransparency = 1, Text = label, Font = FONT_MED, TextSize = 12, TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Left }, container)
        local valLabel = new("TextLabel", { Size = UDim2.new(0.4, 0, 0, 16), Position = UDim2.new(0.6, 0, 0, 0), BackgroundTransparency = 1, Text = fmt(initial), Font = FONT_BOLD, TextSize = 12, TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Right }, container)
        local track = new("Frame", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 26), BackgroundColor3 = Theme.track, BorderSizePixel = 0 }, container)
        corner(track, 2)
        local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.accent, BorderSizePixel = 0 }, track)
        corner(fill, 2)
        local knob = new("Frame", { Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Theme.accent, BorderSizePixel = 0, ZIndex = 2 }, track)
        corner(knob, 6)
        local hit = new("TextButton", { Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "", ZIndex = 3, Active = true }, container)
        local raw, val = initial, initial
        local function render()
            local rel = (maxV > minV) and (raw - minV) / (maxV - minV) or 0
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, 0, 0.5, 0)
            valLabel.Text = fmt(val)
        end
        local function setRaw(v, fire)
            raw = math.clamp(v, minV, maxV)
            val = math.floor(raw / step + 0.5) * step
            render()
            if fire then 
                onChanged(val) 
            end
        end
        local dragging = false
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local w = math.max(1, track.AbsoluteSize.X)
                local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / w, 0, 1)
                setRaw(minV + (maxV - minV) * rel, true)
            end
        end)
        bind(UserInputService.InputChanged, function(i)
            if not dragging then 
                return 
            end
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                local w = math.max(1, track.AbsoluteSize.X)
                local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / w, 0, 1)
                setRaw(minV + (maxV - minV) * rel, true)
            end
        end)
        bind(UserInputService.InputEnded, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
                dragging = false 
            end
        end)
        setRaw(initial, false)
    end

