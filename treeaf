        pcall(function() 
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) 
        end) 
    end)
    makeBtn(miscCard, "Unload Script", function() 
        if unload then 
            unload() 
        end 
    end)
    new("TextLabel", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "Press '=' to instantly kill the script", Font = FONT_MED, TextSize = 11, TextColor3 = Theme.danger, TextXAlignment = Enum.TextXAlignment.Left }, miscCard)

    end
    buildTabContents()

    --=============================================================================
    -- Window logic & workers
    --=============================================================================

    local function getViewport(): Vector2
        local cam = workspace.CurrentCamera
        return (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
    end

    local function clampOffsets(x: number, y: number): (number, number)
        local vp = getViewport()
        local size = window.AbsoluteSize
        return math.clamp(x, 0, math.max(0, vp.X - size.X)), math.clamp(y, 0, math.max(0, vp.Y - size.Y))
    end

    local isDragging = false
    local dragStart: Vector2? = nil
    local dragStartPos: Vector2? = nil
    local activeDragTouch: InputObject? = nil

    local function stopDragging(): ()
        isDragging = false
        dragStart = nil
        dragStartPos = nil
        activeDragTouch = nil
    end

    local function ensureOnScreen(): ()
        if not window.Visible or isDragging then
            return
        end
        local abs = window.AbsolutePosition
        local cx, cy = clampOffsets(abs.X, abs.Y)
        if math.abs(cx - abs.X) > 0.5 or math.abs(cy - abs.Y) > 0.5 then
            window.Position = UDim2.fromOffset(cx, cy)
        end
    end

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        -- Ignore a press over the close button; it should close the window,
        -- not start a drag. Capture the absolute window position BEFORE
        -- converting away from the centered scale-based initial position.
        local pointer = Vector2.new(input.Position.X, input.Position.Y)
        local closePos = closeBtn.AbsolutePosition
        local closeSize = closeBtn.AbsoluteSize
        local overClose = pointer.X >= closePos.X and pointer.X <= closePos.X + closeSize.X
            and pointer.Y >= closePos.Y and pointer.Y <= closePos.Y + closeSize.Y
        if overClose then
            return
        end

        local abs = window.AbsolutePosition
        dragStart = pointer
        dragStartPos = Vector2.new(abs.X, abs.Y)
        activeDragTouch = input.UserInputType == Enum.UserInputType.Touch and input or nil
        window.Position = UDim2.fromOffset(abs.X, abs.Y)
        isDragging = true
    end)

    bind(UserInputService.InputChanged, function(input)
        if not isDragging or not dragStart or not dragStartPos then
            return
        end

        local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
        local isActiveTouchMove = activeDragTouch ~= nil and input == activeDragTouch
        if not isMouseMove and not isActiveTouchMove then
            return
        end

        local pointer = Vector2.new(input.Position.X, input.Position.Y)
        local delta = pointer - dragStart
        local x, y = clampOffsets(dragStartPos.X + delta.X, dragStartPos.Y + delta.Y)
        window.Position = UDim2.fromOffset(x, y)
    end)

    bind(UserInputService.InputEnded, function(input)
        if not isDragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or (activeDragTouch ~= nil and input == activeDragTouch) then
            stopDragging()
        end
    end)

    local prevMouseBehavior = Enum.MouseBehavior.Default
    local prevMouseIcon = true

    local function setWindowVisible(visible: boolean): ()
        closePopup()
        window.Visible = visible
        toggleBtn.Visible = not visible
        if visible then
            ensureOnScreen()
            prevMouseBehavior = UserInputService.MouseBehavior
            prevMouseIcon = UserInputService.MouseIconEnabled
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        else
            UserInputService.MouseBehavior = prevMouseBehavior
            UserInputService.MouseIconEnabled = prevMouseIcon
        end
    end

    toggleBtn.MouseButton1Click:Connect(function() 
        setWindowVisible(true) 
    end)
    closeBtn.MouseButton1Click:Connect(function() 
        setWindowVisible(false) 
    end)

    bind(UserInputService.InputBegan, function(input, gp)
        if unloaded then 
            return 
        end
        if input.KeyCode == Enum.KeyCode.Equals then
            if unload then 
                unload() 
            end
            return
        end
        if gp then 
            return 
        end
        if input.KeyCode == Enum.KeyCode.RightShift then
            setWindowVisible(not window.Visible)
        end
    end)

    bind(LocalPlayer.Idled, function() 
        if not unloaded and Flags.AntiAfk then 
            pulseAntiAfk() 
        end 
    end)
    bind(UserInputService.JumpRequest, function() 
        if not unloaded and Flags.InfJump then 
            setInfJump(true) 
        end 
    end)

    startWorker("status", 0.4, function()
        UIRefs.statusVal.Text = Game.status .. (zoneUnlocked(Flags.Zone) and "" or " (locked)")
        UIRefs.cashVal.Text = "$" .. short(cashValue()) .. "  Gems " .. short(gemsValue())
        UIRefs.logsVal.Text = carried() .. " / " .. capacity() .. (Flags.AutoSell and ("  (sell at " .. sellThreshold() .. ")") or "")
        UIRefs.zoneVal.Text = zoneLabel(Flags.Zone) .. (zoneUnlocked(Flags.Zone) and "" or " (locked)")
        UIRefs.cycleVal.Text = Game.dayNight or "Unknown"
        UIRefs.sessionVal.Text = Game.trees .. " trees, " .. Game.sells .. " sells, " .. Game.bought .. " buys"
    end)

    startWorker("daynight", 0.8, function()
        local detected = readDayNightHud()
        if detected and detected ~= Game.dayNight then
            Game.dayNight = detected
            notify("Cycle phase detected: " .. detected)
        end
    end)

    -- Run independently of Auto Chop, including immediately after execute, so
    -- the Zone dropdown follows the actual upper-right HUD area from startup.
    startWorker("areahudzone", 1.0, function()
        local areaState = readAreaHudState()
        syncZoneSelectionFromHud(areaState)
    end)

    startWorker("windowsafe", 1.0, ensureOnScreen)

    unload = function(): ()
        if unloaded then
            return
        end

        -- Keep the user's intended settings before cleanup resets active features.
        -- Invalidate any queued saves and make delayed saves no-op once unloaded.
        saveVersion += 1
        local snapshotOk, savedConfigText = pcall(function()
            return HttpService:JSONEncode(Flags)
        end)
        if not snapshotOk then
            local snapshotErr = savedConfigText
            savedConfigText = nil
            warn("[TheForest] Could not encode config during shutdown: " .. tostring(snapshotErr))
        end

        unloaded = true
        -- If the script is unloaded during a boss fight, release the held fire
        -- input and undo the temporary player-root anchor immediately.
        pcall(function()
            if Game.setAttackMouseDown then
                Game.setAttackMouseDown(false)
            end
            if Game.bossAnchoredRoot and Game.bossAnchoredRoot.Parent then
                Game.bossAnchoredRoot.AssemblyLinearVelocity = Vector3.zero
                Game.bossAnchoredRoot.AssemblyAngularVelocity = Vector3.zero
                Game.bossAnchoredRoot.Anchored = (Game.bossRootWasAnchored == true)
            end
        end)
        Game.bossAnchoredRoot = nil
        Game.bossRootWasAnchored = nil
        stopAllFeatures()
        for _, c in ipairs(connections) do
            pcall(function()
                c:Disconnect()
            end)
        end
        table.clear(connections)
        stopFly()
        local hum = getRoot()
        if hum then
            hum.WalkSpeed = 16
        end
        pcall(function()
            screenGui:Destroy()
        end)

        -- Write the snapshot AFTER cleanup. This prevents cleanup setters from
        -- replacing saved ON states with their temporary shutdown OFF states.
        if type(writefile) == "function" and type(savedConfigText) == "string" then
            local writeOk, writeErr = pcall(function()
                writefile(CONFIG_FILE, savedConfigText)
            end)
            if writeOk then
                local verifyOk = true
                local verifyErr = nil
                if type(readfile) == "function" then
                    local readOk, currentText = pcall(function()
                        return readfile(CONFIG_FILE)
                    end)
                    if not readOk or currentText ~= savedConfigText then
                        verifyOk = false
                        verifyErr = "read-back did not match shutdown snapshot"
                    end
                end
                if verifyOk then
                    print("[TheForest] Shutdown config saved and verified: " .. CONFIG_FILE)
                else
                    warn("[TheForest] Shutdown config verification failed: " .. tostring(verifyErr))
                end
            else
                warn("[TheForest] Shutdown config write failed: " .. tostring(writeErr))
            end
        else
            warn("[TheForest] Shutdown config could not be saved; writefile() or JSON encoding is unavailable")
        end

        notify("Script killed completely via kill switch.")
    end

    bind(LocalPlayer.CharacterAdded, bindCharacter)
    if LocalPlayer.Character then 
        bindCharacter(LocalPlayer.Character) 
    end
    if LobbyRemotes then
        pcall(function()
            bind(LobbyRemotes.OpenCreate.OnClientEvent, onOpenCreate)
            bind(LobbyRemotes.Saves.OnClientEvent, onSaves)
        end)
    end

    selectTab("main")
    setWindowVisible(true)

    if Flags.AntiGameplayPause then 
        setNoGameplayPaused(true) 
    end
    if Flags.AntiAfk then 
        setAntiAfk(true) 
    end
    if Flags.FreeCursorMenu then 
        setFreeCursorMenu(true) 
    end
    if Flags.InstantProximityPrompt then 
        setInstantProximityPrompt(true) 
    end
    if Flags.NoClip then 
        setNoClip(true) 
    end
    if Flags.InfJump then 
        setInfJump(true) 
    end
    if Flags.Fly then 
        setFly(true) 
    end
    if Flags.WalkSpeedEnabled then 
        setWalkSpeedEnabled(true) 
    end
    if Flags.AutoReconnect then 
        setAutoReconnect(true) 
    end
    if Flags.Disable3DRendering then 
        setDisable3D(true) 
    end
    if Flags.FpsBoost then 
        setFpsBoost(true) 
    end
    if Flags.NoCustomCursor then 
        setNoCustomCursor(true) 
    end

    for key in pairs(FARM_KEYS) do 
        if Flags[key] then 
            Setters.feature(key, true) 
        end 
    end
    for key in pairs(WORKER_STEPS) do 
        if Flags[key] then 
            Setters.feature(key, true) 
        end 
    end
    for key in pairs(BUY_KEYS) do 
        if Flags[key] then 
            Setters.feature(key, true) 
        end 
    end

    if not Remotes or not Config then
        notify("Game modules not found; farming/buying disabled")
    else
        notify("Loaded " .. SCRIPT_VERSION .. ". RightShift toggles the menu, '=' kills the script.")
    end

end, function(err)
    print("========================================")
    print("[FATAL ERROR] The script crashed!")
    print("Error details: " .. tostring(err))
    print("Traceback:")
    print(debug.traceback())
    print("========================================")
    pcall(function()
        game.StarterGui:SetCore("SendNotification", { Title = "Script Error", Text = "Check console.", Duration = 10 })
    end)
end)
