    local function tryBuyTool(name)
        if not Remotes or not Remotes.BuyTool then 
            return false 
        end
        local def = Config and Config.Tools and Config.Tools[name]
        local price = def and tonumber(def.Price)
        local station = TOOL_STATIONS[name] or ("Station_" .. name)
        if name == "Dynamite" then 
            station = "Station_Explosives" 
        end
        if not price or toolOwned(name) or cashValue() < price or not stationPosition(station) then 
            return false 
        end
        if def.RequiresItem and backpackLevel() <= 0 then 
            return false 
        end
        
        return buyAtStation(station, function()
            local ok, result = pcall(Remotes.BuyTool.InvokeServer, Remotes.BuyTool, name)
            if ok and type(result) == "table" and result.Ok then
                Game.bought += 1
                notify("Bought " .. tostring(def.DisplayName or name))
                if name == "Axe" then
                    task.wait(0.25)
                    if Game.pressWeaponSlot then
                        Game.pressWeaponSlot(2)
                    end
                    notify("Axe bought; pressed slot 2 to equip it.")
                end
                return true
            end
            return false
        end)
    end

    local function tryBuyUpgrade(id)
        if not Remotes or not Remotes.BuyUpgrade then 
            return false 
        end
        local price, item = nextUpgradePrice(id)
        local _, section = upgradeDef(id)
        local needs = section and section.Requires
        if price and item and cashValue() >= price and (not needs or toolOwned(needs)) then
            local level = LocalPlayer:GetAttribute("Up_" .. id)
            Remotes.BuyUpgrade:FireServer(id)
            task.wait(0.5)
            if LocalPlayer:GetAttribute("Up_" .. id) ~= level then 
                Game.bought += 1
                return true
            end
        end
        return false
    end

    local function tryBuyBackpack()
        if not Remotes or not Remotes.BuyUpgrade then 
