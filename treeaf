        if type(list) ~= "table" then 
            return 
        end
        table.clear(LobbyState.saves)
        for _, entry in ipairs(list) do
            if type(entry) == "table" and entry.Key then
                table.insert(LobbyState.saves, { label = saveLabel(entry), key = entry.Key })
            end
        end
        if LobbyState.onSavesChanged then 
            LobbyState.onSavesChanged() 
        end
