    local saveVersion = 0

    local function configValuesEqual(a, b)
        if type(a) ~= type(b) then
            return false
        end
        if type(a) ~= "table" then
            return a == b
        end
        for k, v in pairs(a) do
            if not configValuesEqual(v, b[k]) then
                return false
            end
        end
        for k in pairs(b) do
            if a[k] == nil then
                return false
            end
        end
        return true
    end

    local function writeConfigNow()
        if type(writefile) ~= "function" then
            return false, "executor does not provide writefile()"
        end

        local encodeOk, data = pcall(function()
            return HttpService:JSONEncode(Flags)
        end)
        if not encodeOk or type(data) ~= "string" then
            return false, "could not encode settings as JSON: " .. tostring(data)
        end

        local writeOk, writeErr = pcall(function()
            writefile(CONFIG_FILE, data)
        end)
        if not writeOk then
            return false, "writefile failed: " .. tostring(writeErr)
        end

        -- Verify that the exact file just written can be read back. This catches
        -- cases where the executor reports no error but the file was not updated.
        if type(readfile) == "function" then
            local readOk, savedText = pcall(function()
                return readfile(CONFIG_FILE)
            end)
            if not readOk or type(savedText) ~= "string" then
                return false, "write returned but readfile could not verify " .. CONFIG_FILE
            end
            local decodeOk, savedFlags = pcall(function()
                return HttpService:JSONDecode(savedText)
            end)
            if not decodeOk or type(savedFlags) ~= "table" then
                return false, "saved file is not valid JSON"
            end
            if not configValuesEqual(Flags, savedFlags) then
                return false, "file read-back does not match the current settings"
            end
        end

        return true
    end

    -- Debounce background saves, but never drop the newest change. Explicit saves
    -- (toggle clicks and the Save Config Now button) are synchronous and verified.
    local function saveConfig(force)
        saveVersion += 1
        local version = saveVersion

        if force then
            return writeConfigNow()
        end

        task.delay(1, function()
            -- Cleanup routines can call saveConfig() while unloading. Never let
            -- a delayed write overwrite the user's saved preferences afterward.
            if unloaded or version ~= saveVersion then
                return
            end
            local ok, err = writeConfigNow()
            if not ok then
                warn("[TheForest] Config autosave failed: " .. tostring(err))
            end
        end)
        return true
    end

    local function loadConfig()
        local loaded = false
        local fileExists = false

        -- isfile() can be missing or unreliable in some executor environments,
        -- so probe the known config path with readfile() as well.
        if type(isfile) == "function" then
            local existsOk, existsResult = pcall(function()
                return isfile(CONFIG_FILE)
            end)
            fileExists = existsOk and existsResult == true
        end

        if type(readfile) == "function" then
            local readOk, rawData = pcall(function()
                return readfile(CONFIG_FILE)
            end)
            if readOk and type(rawData) == "string" and #rawData > 0 then
                fileExists = true
                local decodeOk, data = pcall(function()
                    return HttpService:JSONDecode(rawData)
                end)
                if decodeOk and type(data) == "table" then
                    for k, v in pairs(data) do
                        if DEFAULT_FLAGS[k] ~= nil and v ~= nil then
                            if type(v) == "table" then
                                local copy = {}
                                for subK, subV in pairs(v) do
                                    copy[subK] = subV
                                end
                                Flags[k] = copy
                            else
                                Flags[k] = v
                            end
                        end
                    end
                    loaded = true
                    print("[TheForest] Loaded " .. CONFIG_FILE .. " (FreeCursorMenu=" .. tostring(Flags.FreeCursorMenu) .. ")")
                elseif fileExists then
                    warn("[TheForest] " .. CONFIG_FILE .. " exists but is not valid JSON; preserving it rather than overwriting it with defaults.")
                end
            end
        end

        -- Only fill missing keys. Values already present in the file, including
        -- false toggles, are retained exactly as saved.
        for k, v in pairs(DEFAULT_FLAGS) do
            if Flags[k] == nil then
                if type(v) == "table" then
                    local copy = {}
                    for subK, subV in pairs(v) do
                        copy[subK] = subV
                    end
                    Flags[k] = copy
                else
                    Flags[k] = v
                end
            end
        end

        -- Create the file on first launch, but never replace a file that could not
        -- be parsed; that file may contain the user's existing settings.
        if not loaded and not fileExists then
            local saved, err = saveConfig(true)
            if not saved then
                warn("[TheForest] Could not create " .. CONFIG_FILE .. ": " .. tostring(err))
            else
                print("[TheForest] Created initial config at " .. CONFIG_FILE)
            end
        end
    end
    loadConfig()

