    local function withLock(fn)
        local started = os.clock()
        while Game.busy and os.clock() - started < 70 and not unloaded do 
            task.wait(0.1) 
        end
        if Game.busy or unloaded then 
            return nil 
        end
        Game.busy = true
        local ok, a, b = pcall(fn)
        Game.busy = false
        if not ok then 
            warn(("[%s] %s"):format(GAME_NAME, tostring(a)))
            return nil 
        end
        return a, b
    end

