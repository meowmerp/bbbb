    local function stepBuyer()
        if Game.busy or unloaded then 
            return 
        end

        -- Axe is the mandatory first purchase. Do not spend on upgrades or
        -- any other shop items until the player owns it. This intentionally
        -- runs even when AutoTools is off, as long as the buyer worker is active.
        if not toolOwned("Axe") then
            Game.status = "Axe required first — waiting to buy Axe"
            local boughtAxe = tryBuyTool("Axe")
            if boughtAxe then
                notify("Axe purchased; other purchases are unlocked.")
            end
            return
        end
        
        if Flags.AutoTools then
            for name, active in pairs(Flags.BuyTools) do
                if active then
                    if tryBuyTool(name) then 
                        return 
                    end
                end
            end
        end
        
        if Flags.AutoUpgrades then
            for id, active in pairs(Flags.BuyUpgrades) do
                if active then
                    if tryBuyUpgrade(id) then 
                        return 
                    end
                end
            end
        end
        
        if Flags.AutoBackpack then
            if tryBuyBackpack() then 
                return 
            end
        end
        
        if Flags.AutoCars then
            for id, active in pairs(Flags.BuyCars) do
                if active then
                    if tryBuyCar(id) then 
                        return 
                    end
                end
            end
        end

        if Flags.AutoDynamite then
            if tryBuyTool("Dynamite") then 
                return 
            end
        end
        
        if Flags.AutoClasses and next(Flags.BuyClasses) then
            local stand = workspace:FindFirstChild("Lobby") and workspace.Lobby:FindFirstChild("LobbyClassStand")
            if stand and Remotes and Remotes.BuyClass then
                for id, active in pairs(Flags.BuyClasses) do
                    if active then
                        local classPrices = Config and Config.Classes and Config.Classes.Stock and Config.Classes.Stock.Prices
                        local price = tonumber(classPrices and classPrices[id])
                        local restock = tostring(workspace:GetAttribute("ClassRestockAt"))
                        if price and not classOwned(id) and classInStock(id) and gemsValue() >= price and LobbyState.classTries[id .. restock] == nil then
                            local bought = withLock(function()
                                local _, root = getRoot()
                                local back = root and root.CFrame
                                Game.status = "Buying class " .. id
                                teleport(stand:GetPivot().Position + Vector3.new(0, 4, 0))
                                task.wait(0.5)
                                local ok, result = pcall(Remotes.BuyClass.InvokeServer, Remotes.BuyClass, id)
                                if ok and type(result) == "table" and result.Ok then
                                    Game.bought += 1 
                                    notify("Bought class " .. id)
                                    return true
                                else
                                    LobbyState.classTries[id .. restock] = true
                                end
                                local _, r = getRoot()
                                if r and back then 
                                    r.CFrame = back 
                                end
                                return false
                            end)
                            if bought then 
                                return 
                            end
                        end
                    end
                end
            end
        end

        if Flags.AutoGemPerks and next(Flags.BuyGemPerks) then
            if Remotes and Remotes.BuyGemPerk and Config and Config.Shop then
                for id, active in pairs(Flags.BuyGemPerks) do
                    if active then
                        for _, perk in ipairs(Config.Shop.Perks) do
                            if perk.Id == id then
                                local level = math.floor(tonumber(LocalPlayer:GetAttribute("GemPerk_" .. id)) or 0)
                                local price = perk.Prices[level + 1]
                                if price and gemsValue() >= price then
                                    local ok, result = pcall(Remotes.BuyGemPerk.InvokeServer, Remotes.BuyGemPerk, id)
                                    if ok and type(result) == "table" and result.Ok then 
                                        Game.bought += 1 
                                        task.wait(0.5)
                                        return 
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

