    local function refreshSaves()
        if not inLobby() or LobbyState.joining then 
            return false 
        end
        return withLock(function()
            Game.status = "Reading saved runs"
            local padId = enterPad()
            if padId then 
                task.wait(1.5) 
            end
            leavePad(padId)
            Game.status = "Idle"
            return padId ~= nil
        end)
    end

    local function joinRun(saveKey)
        if not inLobby() or LobbyState.joining then 
            return false 
        end
        return withLock(function()
            LobbyState.joining = true
            Game.status = saveKey and "Loading saved run" or "Creating run"
            local padId = enterPad()
            local ok, result = false, nil
            if padId then
                if saveKey and LobbyRemotes.LoadParty then
                    ok, result = pcall(LobbyRemotes.LoadParty.InvokeServer, LobbyRemotes.LoadParty, padId, saveKey)
                elseif LobbyRemotes.CreateParty then
                    local diff = Flags.Difficulty
                    if difficultyWins(diff) > playerWins() then 
                        diff = "NORMAL" 
                    end
                    local size = math.clamp(math.floor(tonumber(Flags.PartySize) or 1), 1, (LobbyConfig and LobbyConfig.MaxParty) or 4)
                    ok, result = pcall(LobbyRemotes.CreateParty.InvokeServer, LobbyRemotes.CreateParty, padId, diff, size, "Forest")
                end
            end
            local success = ok and type(result) == "table" and result.Ok == true
            if success then
                Game.status = "Waiting for teleport"
                local gui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("LobbyParty")
                if gui then 
                    gui.Enabled = false 
                end
                LobbyState.joining = false
            else
                Game.status = "Join failed: " .. tostring(type(result) == "table" and result.Why or result)
                leavePad(padId)
                LobbyState.joining = false
            end
            return success
        end)
    end

    local function stepAutoJoin()
        if not inLobby() or LobbyState.joining then 
            return 
        end
        joinRun(nil)
        task.wait(5)
    end

    local function stepDaily()
        if not inLobby() then 
            return 
        end
        local today = math.floor(workspace:GetServerTimeNow() / 86400)
        if (tonumber(LocalPlayer:GetAttribute("DailyDay")) or 0) >= today then 
            return 
        end
        local booth = workspace.Lobby:FindFirstChild("RewardBooth")
        local zone = booth and booth:FindFirstChild("DailyReward") and booth.DailyReward:FindFirstChild("Zone")
        if not zone then 
            return 
        end
        withLock(function()
            local _, root = getRoot()
            local back = root and root.CFrame
            Game.status = "Claiming daily"
            local started = os.clock()
            while os.clock() - started < 6 and not unloaded and (tonumber(LocalPlayer:GetAttribute("DailyDay")) or 0) < today do
                teleport(zone.Position + Vector3.new(0, 3, 0))
                task.wait(0.3)
            end
            if (tonumber(LocalPlayer:GetAttribute("DailyDay")) or 0) >= today then 
                notify("Daily reward claimed") 
            end
            local _, r = getRoot()
            if r and back then 
                r.CFrame = back 
            end
            Game.status = "Idle"
        end)
    end


