    --=============================================================================

    local function treesFolder()
        local map = workspace:FindFirstChild("Map")
        return map and map:FindFirstChild("Trees")
    end

    local function nearestTree()
        local folder = treesFolder()
        local _, root = getRoot()
        if not folder or not root then 
            return nil 
        end
        local best, bestDist
        for _, tree in ipairs(folder:GetChildren()) do
            local base = tree:FindFirstChild("TrunkBase")
            if base and base:IsA("BasePart")
                and tree:GetAttribute("Biome") == Flags.Zone
                and (tonumber(tree:GetAttribute("HP")) or 0) > 0
                and not Game.badTrees[tree] then
                local dist = (base.Position - root.Position).Magnitude
                if not bestDist or dist < bestDist then 
                    best, bestDist = tree, dist 
                end
            end
        end
        return best
    end

    local function normalizeAreaName(value)
        return string.gsub(string.lower(tostring(value or "")), "[^%w]", "")
    end

    -- Resolve only exact known area labels (or a label combined with "AREA n/n").
    -- This avoids mistaking instructional text elsewhere in the UI for the active area.
    local function zoneKeyFromHudText(textValue)
        local candidate = string.lower(tostring(textValue or ""))
        local prefix = string.match(candidate, "^%s*(.-)%s*area%s*%d+%s*/%s*%d+")
        if prefix and prefix ~= "" then
            candidate = prefix
        end
        candidate = string.match(candidate, "^%s*(.-)%s*$") or candidate
        local normalized = normalizeAreaName(candidate)
        if normalized == "" then return nil end

        for _, key in ipairs(zoneOrder()) do
            if normalized == normalizeAreaName(zoneLabel(key)) or normalized == normalizeAreaName(key) then
                return key
            end
        end
        for key, label in pairs(ZONE_LABEL_FALLBACK) do
            if normalized == normalizeAreaName(label) or normalized == normalizeAreaName(key) then
                return key
            end
        end
        return nil
    end

    local function isTopRightHudText(inst)
        local ancestor = inst
        while ancestor and ancestor ~= game do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then
                return false
            end
            if ancestor:IsA("ScreenGui") and not ancestor.Enabled then
                return false
            end
            ancestor = ancestor.Parent
        end
        local cam = workspace.CurrentCamera
        local viewport = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        local ok, pos = pcall(function()
            return inst.AbsolutePosition
        end)
        if not ok or not pos then return false end
        -- The zone label shown above AREA n/n sits in the upper-right HUD region.
        return pos.X >= viewport.X * 0.52 and pos.Y <= viewport.Y * 0.32
    end

    -- Read the game's actual area HUD so the same logic works across area labels
    -- and progress values instead of hardcoding Oak Wood or a particular percent.
    local function readAreaHudState()
        local state = {
            percent = nil,
            marker = nil,
            bossName = nil, -- Active boss name read from the top health bar only.
            bossHintName = nil, -- Name mentioned by the area objective.
            bossBarPresent = false,
            bossHealth = nil,
            bossMaxHealth = nil,
            areaName = zoneLabel(Flags.Zone),
            detectedZone = nil,
        }
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local hudTextNodes = {}
        if playerGui then
            for _, inst in ipairs(playerGui:GetDescendants()) do
                if inst:IsA("TextLabel") or inst:IsA("TextButton") then
                    local textValue = inst.Text
                    if type(textValue) == "string" and textValue ~= "" then
                        table.insert(hudTextNodes, { inst = inst, text = textValue })
                        local lower = string.lower(textValue)
                        if not state.detectedZone and isTopRightHudText(inst) then
                            local hudZone = zoneKeyFromHudText(textValue)
                            if hudZone then
                                state.detectedZone = hudZone
                                state.areaName = zoneLabel(hudZone)
                            end
                        end
                        local pct = string.match(lower, "([%d%.]+)%%%s*cleared")
                        if pct then
                            local parsed = tonumber(pct)
                            if parsed ~= nil then
                                state.percent = parsed
                            end
                        end

                        local areaNum, areaTotal = string.match(lower, "area%s*(%d+)%s*/%s*(%d+)")
                        if areaNum and areaTotal then
                            state.marker = areaNum .. "/" .. areaTotal
                        end

                        -- Example HUD copy: "Clear it all to wake Old Barkback".
                        local expected = string.match(textValue, "[Ww]ake%s+([%w%s%-']+)")
                        if expected then
                            expected = string.match(expected, "^%s*(.-)%s*$")
                            if expected and expected ~= "" then
                                state.bossHintName = expected
                            end
                        end
                    end
                end
            end
        end

        -- Remove hidden/stale UI nodes before looking for an active boss bar.
        -- Some games leave old health-bar labels in PlayerGui after hiding them.
        for i = #hudTextNodes, 1, -1 do
            local ancestor = hudTextNodes[i].inst
            local visible = true
            while ancestor and ancestor ~= game do
                if ancestor:IsA("GuiObject") and not ancestor.Visible then
                    visible = false
                    break
                end
                if ancestor:IsA("ScreenGui") and not ancestor.Enabled then
                    visible = false
                    break
                end
                ancestor = ancestor.Parent
            end
            if not visible then
                table.remove(hudTextNodes, i)
            end
        end

        -- The live boss health bar is the source of truth for the active boss.
        -- Objective text ("Clear it all to wake ...") is only a hint. Read only
        -- a name paired with an HP fraction in the top 24% of the screen, so a
        -- world-space tag or menu label cannot become a boss target.
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
        if #hudTextNodes > 1 then
            local bestName, bestScore = nil, -math.huge
            for _, hpEntry in ipairs(hudTextNodes) do
                local hpCurrent, hpMax = string.match(hpEntry.text, "^%s*([%d,%.]+)%s*/%s*([%d,%.]+)%s*$")
                hpCurrent = hpCurrent and tonumber((string.gsub(hpCurrent, ",", ""))) or nil
                hpMax = hpMax and tonumber((string.gsub(hpMax, ",", ""))) or nil
                if hpCurrent and hpMax and hpMax >= 20 and hpCurrent >= 0 and hpCurrent <= hpMax then
                    local hpOk, hpPos, hpSize = pcall(function()
                        return hpEntry.inst.AbsolutePosition, hpEntry.inst.AbsoluteSize
                    end)
                    if hpOk and hpPos and hpSize and hpPos.Y >= 0 and hpPos.Y <= viewport.Y * 0.24 then
                        for _, nameEntry in ipairs(hudTextNodes) do
                            if nameEntry.inst ~= hpEntry.inst then
                                local candidate = string.match(nameEntry.text, "^%s*(.-)%s*$") or ""
                                local candidateLower = string.lower(candidate)
                                local isNameLike = #candidate >= 3 and #candidate <= 32
                                    and string.match(candidate, "^[%a][%a%s%-']+$") ~= nil
                                    and not string.find(candidateLower, "clear", 1, true)
                                    and not string.find(candidateLower, "wake", 1, true)
                                    and not string.find(candidateLower, "overview", 1, true)
                                    and not string.find(candidateLower, "chopping", 1, true)
                                    and not string.find(candidateLower, "logs", 1, true)
                                    and not string.find(candidateLower, "cash", 1, true)
                                    and not string.find(candidateLower, "area", 1, true)
                                if isNameLike then
                                    local nameOk, namePos, nameSize = pcall(function()
                                        return nameEntry.inst.AbsolutePosition, nameEntry.inst.AbsoluteSize
                                    end)
                                    if nameOk and namePos and nameSize and namePos.Y >= 0
                                        and namePos.Y <= viewport.Y * 0.22 then
                                        local verticalGap = hpPos.Y - (namePos.Y + nameSize.Y)
                                        local hpCenter = hpPos.X + hpSize.X * 0.5
                                        local nameCenter = namePos.X + nameSize.X * 0.5
                                        local horizontalGap = math.abs(hpCenter - nameCenter)
                                        if verticalGap >= -4 and verticalGap <= 48 and horizontalGap <= 220 then
                                            local score = 80 - math.abs(verticalGap) - horizontalGap * 0.15
                                            if string.find(candidate, " ", 1, true) then score += 16 end
                                            if candidate == string.upper(candidate) then score += 8 end
                                            if hpMax >= 100 then score += 12 end
                                            if score > bestScore then
                                                bestName, bestScore = candidate, score
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if bestName then
                state.bossName = bestName
                state.bossBarPresent = true
            end
        end

        -- Read the live boss HP from the same top HUD (name label directly above
        -- a fraction like 521/800). This is also a reliable death signal when the
        -- rig doesn't expose a Humanoid or HP attribute to the client.
        if state.bossName and #hudTextNodes > 1 then
            local expectedName = string.gsub(string.lower(tostring(state.bossName)), "[^%w]", "")
            local bestHealthScore = -math.huge
            for _, hpEntry in ipairs(hudTextNodes) do
                local hpCurrentText, hpMaxText = string.match(hpEntry.text, "^%s*([%d,%.]+)%s*/%s*([%d,%.]+)%s*$")
                local hpCurrent = hpCurrentText and tonumber((string.gsub(hpCurrentText, ",", ""))) or nil
                local hpMax = hpMaxText and tonumber((string.gsub(hpMaxText, ",", ""))) or nil
                if hpCurrent and hpMax and hpMax >= 20 and hpCurrent >= 0 and hpCurrent <= hpMax then
                    local hpOk, hpPos, hpSize = pcall(function()
                        return hpEntry.inst.AbsolutePosition, hpEntry.inst.AbsoluteSize
                    end)
                    if hpOk and hpPos and hpSize and hpPos.Y >= 0 and hpPos.Y <= viewport.Y * 0.24 then
                        for _, nameEntry in ipairs(hudTextNodes) do
                            local label = string.match(nameEntry.text, "^%s*(.-)%s*$") or ""
                            local labelNorm = string.gsub(string.lower(label), "[^%w]", "")
                            if labelNorm ~= "" and (labelNorm == expectedName
                                or string.find(labelNorm, expectedName, 1, true) ~= nil
                                or string.find(expectedName, labelNorm, 1, true) ~= nil) then
                                local nameOk, namePos, nameSize = pcall(function()
                                    return nameEntry.inst.AbsolutePosition, nameEntry.inst.AbsoluteSize
                                end)
                                if nameOk and namePos and nameSize then
                                    local verticalGap = hpPos.Y - (namePos.Y + nameSize.Y)
                                    local horizontalGap = math.abs((hpPos.X + hpSize.X * 0.5) - (namePos.X + nameSize.X * 0.5))
                                    if verticalGap >= -4 and verticalGap <= 48 and horizontalGap <= 220 then
                                        local score = 100 - math.abs(verticalGap) - horizontalGap * 0.15
                                        if score > bestHealthScore then
                                            bestHealthScore = score
                                            state.bossHealth = hpCurrent
                                            state.bossMaxHealth = hpMax
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        -- The HUD's AREA n/total marker distinguishes consecutive areas even
        -- when the selected biome/zone dropdown remains unchanged.
        state.key = tostring(Flags.Zone) .. "|" .. tostring(state.marker or "")
        return state
    end

    -- The top-right HUD is the source of truth for the current area. Keep the
    -- dropdown editable, and let users disable this sync for a manual override.
    local function syncZoneSelectionFromHud(areaState)
        if not Flags.AutoDetectZone or not areaState or not areaState.detectedZone then
            return false
        end
        local detectedZone = areaState.detectedZone
        if zoneIndex(detectedZone) == nil then return false end

        -- A post-boss zone advance is intentional: do not immediately snap back
        -- to the old HUD label while the game transitions to the next area.
        if Game.autoZoneAdvanceTarget then
            if detectedZone == Game.autoZoneAdvanceTarget then
                Game.autoZoneAdvanceTarget = nil
            elseif Flags.Zone == Game.autoZoneAdvanceTarget then
                return false
            else
                Game.autoZoneAdvanceTarget = nil
            end
        end

        if Flags.Zone == detectedZone then
            areaState.areaName = zoneLabel(detectedZone)
            areaState.key = tostring(Flags.Zone) .. "|" .. tostring(areaState.marker or "")
            if Game.lastHudAreaReport ~= detectedZone then
                Game.lastHudAreaReport = detectedZone
                print("[TheForest] Top-right HUD area detected: " .. zoneLabel(detectedZone))
            end
            return false
        end

        local previousZone = Flags.Zone
        Flags.Zone = detectedZone
        table.clear(Game.badTrees)
        Game.currentAreaKey = nil
        Game.lastProgressReport = nil
        if zoneDropdown then
            pcall(function() zoneDropdown.SetValue(detectedZone) end)
        end
        areaState.areaName = zoneLabel(detectedZone)
        areaState.key = tostring(Flags.Zone) .. "|" .. tostring(areaState.marker or "")
        saveConfig()
        Game.lastHudAreaReport = detectedZone
        print("[TheForest] Top-right HUD area detected: " .. zoneLabel(detectedZone)
            .. "; Zone dropdown updated from " .. zoneLabel(previousZone) .. ".")
        notify("HUD area matched: " .. zoneLabel(detectedZone) .. ". Zone dropdown updated.")
        return true
    end

    -- Read the game's explicit phase label when available. The game has four
    -- phases (Day -> Dusk -> Night -> Dawn -> Day), so Dusk/Dawn must not be
    -- collapsed into Night/Day. Avoid broad tutorial text and hidden menu labels.
    local function readDayNightHud()
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return nil end

        local bestState, bestScore = nil, -1
        for _, inst in ipairs(playerGui:GetDescendants()) do
            if (inst:IsA("TextLabel") or inst:IsA("TextButton")) and inst.Visible then
                -- A child may be Visible while an ancestor ScreenGui/frame is hidden.
                local hierarchyVisible = true
                local ancestor = inst.Parent
                while ancestor and ancestor ~= playerGui do
                    if ancestor:IsA("GuiObject") and not ancestor.Visible then
                        hierarchyVisible = false
                        break
                    end
                    if ancestor:IsA("ScreenGui") and not ancestor.Enabled then
                        hierarchyVisible = false
                        break
                    end
                    ancestor = ancestor.Parent
                end

                local positionOk, labelY = pcall(function() return inst.AbsolutePosition.Y end)
                -- Only inspect the upper HUD strip. This avoids reading a stale
                -- "Cycle: Night" value from this script's own Overview panel.
                local inTopHud = positionOk and labelY <= 180
                local raw = string.lower(tostring(inst.Text or ""))
                if hierarchyVisible and inTopHud and raw ~= "" then
                    local instructional = string.find(raw, "minute", 1, true)
                        or string.find(raw, "minions", 1, true)
                        or string.find(raw, "monsters", 1, true)
                        or string.find(raw, "climb", 1, true)
                        or string.find(raw, "replant", 1, true)
                        or string.find(raw, "thieves", 1, true)
                        or string.find(raw, "biters", 1, true)
                        or string.find(raw, "day and night", 1, true)
                    if not instructional and #raw <= 48 then
                        local normalized = string.gsub(raw, "[^%a%d: ]", " ")
                        normalized = string.gsub(normalized, "%s+", " ")
                        normalized = string.match(normalized, "^%s*(.-)%s*$") or normalized
                        local first = string.match(normalized, "^(%a+)") or ""
                        local state = nil

                        -- Check transitional phases first and only accept whole words.
                        if first == "dusk" or first == "dusktime"
                            or string.find(normalized, "%f[%a]dusk%f[%A]") then
                            state = "Dusk"
                        elseif first == "dawn" or first == "dawntime"
                            or string.find(normalized, "%f[%a]dawn%f[%A]") then
                            state = "Dawn"
                        elseif first == "night" or first == "nighttime"
                            or string.find(normalized, "%f[%a]night%f[%A]")
                            or string.find(normalized, "%f[%a]nighttime%f[%A]") then
                            state = "Night"
                        elseif first == "day" or first == "daytime"
                            or string.find(normalized, "%f[%a]day%f[%A]")
                            or string.find(normalized, "%f[%a]daytime%f[%A]") then
                            state = "Day"
                        end

                        if state then
                            local score = (#normalized <= 12) and 6 or 1
                            score += 3 -- candidates already restricted to the upper HUD strip
                            if normalized == "day" or normalized == "dusk"
                                or normalized == "night" or normalized == "dawn" then
                                score += 4
                            end
                            if score > bestScore then
                                bestState, bestScore = state, score
                            end
                        end
                    end
                end
            end
        end
        if bestState then
            return bestState
        end

        -- If the HUD phase is an icon with no readable text, use Lighting.ClockTime
        -- as a fallback. Dusk and dawn get their own windows so night-only behavior
        -- is not enabled during those transitions.
        local clockOk, clockTime = pcall(function()
            return Lighting.ClockTime
        end)
        if clockOk and type(clockTime) == "number" then
            if clockTime >= 6 and clockTime < 18 then
                return "Day"
            elseif clockTime >= 18 and clockTime < 19 then
                return "Dusk"
            elseif clockTime >= 5 and clockTime < 6 then
                return "Dawn"
            else
                return "Night"
            end
        end
        return nil
    end

    -- Initialize the cycle immediately during script execution instead of waiting
    -- for the background worker's first polling interval.
    Game.dayNight = readDayNightHud() or "Unknown"
    notify("Initial cycle detection: " .. Game.dayNight)

    local function normalizedName(value)
        return string.gsub(string.lower(tostring(value or "")), "[^%w]", "")
    end

    local function modelHealth(model)
        if not model or not model.Parent then
            return 0
        end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid then
            return humanoid.Health
        end
        local hp = tonumber(model:GetAttribute("HP"))
        if hp == nil then hp = tonumber(model:GetAttribute("Health")) end
        if hp == nil then
            local hpValue = model:FindFirstChild("HP") or model:FindFirstChild("Health")
            if hpValue and (hpValue:IsA("NumberValue") or hpValue:IsA("IntValue")) then
                hp = hpValue.Value
            end
        end
        return hp
    end

    local function modelRootPart(model)
        if not model then return nil end
        local root = model:FindFirstChild("HumanoidRootPart")
            or model.PrimaryPart
            or model:FindFirstChild("RootPart")
            or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
        if root and root:IsA("BasePart") then
            return root
        end
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") then
                return child
            end
        end
        return nil
    end

    -- Match the HUD name, model display-name fields, and generic boss models.
    -- Important: generic models must still be considered when a preferred HUD
    -- name exists; otherwise a model named "Boss"/"BossNPC" is never found.
    local function findActiveBoss(preferredName)
        preferredName = preferredName or Game.areaBossName
        local preferred = normalizedName(preferredName)
        local preferredCore = string.gsub(preferred, "^the", "")
        local _, playerRoot = getRoot()
        local bestModel, bestScore = nil, -math.huge

        -- Do not let short nested-model names such as "Old" or UI models such
        -- as "OldBarkbackHealthBar" masquerade as the live boss. Only accept a
        -- name that exactly matches the HUD name or contains the full HUD name.
        local function matchesPreferred(value)
            local normalized = normalizedName(value)
            if normalized == "" or preferred == "" then return false, 0 end
            if normalized == preferred or (preferredCore ~= "" and normalized == preferredCore) then
                return true, 2
            end
            if #preferred >= 6 and #normalized >= #preferred
                and string.find(normalized, preferred, 1, true) ~= nil then
                return true, 1
            end
            if #preferredCore >= 6 and #normalized >= #preferredCore
                and string.find(normalized, preferredCore, 1, true) ~= nil then
                return true, 1
            end
            return false, 0
        end

        local function isUiOrEffectModel(value)
            local n = normalizedName(value)
            for _, token in ipairs({ "healthbar", "bossbar", "healthui", "billboard", "nameplate", "nametag", "indicator", "displaygui", "effect", "vfx" }) do
                if string.find(n, token, 1, true) ~= nil then return true end
            end
            return false
        end

        local function explicitRigRoot(model)
            local humanoid = model:FindFirstChildOfClass("Humanoid")
                or model:FindFirstChildWhichIsA("Humanoid", true)
            local root = model:FindFirstChild("HumanoidRootPart", true)
                or model:FindFirstChild("RootPart", true)
                or model:FindFirstChild("PrimaryPart", true)
                or model:FindFirstChild("UpperTorso", true)
                or model:FindFirstChild("Torso", true)
                or model.PrimaryPart
                or (humanoid and humanoid.RootPart)
            if root and root:IsA("BasePart") then return root, humanoid end
            return nil, humanoid
        end

        local function consider(model, kind, strength)
            if not model or not model:IsA("Model") or model == LocalPlayer.Character
                or not model.Parent or isUiOrEffectModel(model.Name) then
                return
            end
            local targetRoot, humanoid = explicitRigRoot(model)
            -- A real NPC rig should expose either a Humanoid or a stable named
            -- root part. Do not use the first arbitrary BasePart in a building,
            -- accessory, or HUD model as a teleport destination.
            if not targetRoot then return end
            local hp = modelHealth(model)
            if hp ~= nil and hp <= 0 then return end
            local distance = playerRoot and (targetRoot.Position - playerRoot.Position).Magnitude or 1000
            local score = strength - distance
            if humanoid then score += 2500 end
            if targetRoot.Name == "HumanoidRootPart" or targetRoot.Name == "RootPart" then score += 1000 end
            local boxOk, _, boxSize = pcall(function() return model:GetBoundingBox() end)
            if boxOk and boxSize and typeof(boxSize) == "Vector3" then
                -- Only a tiny tie-breaker: huge buildings should never beat a rig match.
                score += math.min(boxSize.Magnitude, 80) * 0.1
            end
            if score > bestScore then
                bestModel, bestScore = model, score
            end
        end

        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("Model") then
                local candidate = normalizedName(inst.Name)
                local namedMatch, nameStrength = matchesPreferred(candidate)
                local displayMatch = false
                local displayStrength = 0
                local genericMatch = string.find(candidate, "boss", 1, true) ~= nil
                    or string.find(candidate, "barkback", 1, true) ~= nil

                local function inspectDisplay(value)
                    if value == nil then return end
                    local display = normalizedName(value)
                    local match, strength = matchesPreferred(display)
                    if match then
                        displayMatch = true
                        displayStrength = math.max(displayStrength, strength)
                    end
                    if string.find(display, "boss", 1, true) ~= nil
                        or string.find(display, "barkback", 1, true) ~= nil then
                        genericMatch = true
                    end
                end
                for _, attributeName in ipairs({ "DisplayName", "BossName", "NPCType", "MobType", "EnemyType", "MonsterType" }) do
                    inspectDisplay(inst:GetAttribute(attributeName))
                end
                local hum = inst:FindFirstChildOfClass("Humanoid")
                    or inst:FindFirstChildWhichIsA("Humanoid", true)
                if hum and hum.DisplayName and hum.DisplayName ~= "" then
                    inspectDisplay(hum.DisplayName)
                end

                if namedMatch then
                    consider(inst, "name", nameStrength == 2 and 20000 or 16000)
                elseif displayMatch then
                    consider(inst, "display", displayStrength == 2 and 18000 or 15000)
                elseif genericMatch and preferred == "" then
                    -- Only use generic Boss/Barkback names when the HUD has not
                    -- supplied an identifying name. If it has, substring-only
                    -- generic matches tend to hit unrelated props and nameplates.
                    consider(inst, "generic", 6000)
                elseif genericMatch and (hum ~= nil) then
                    -- A properly-rigged generic BossNPC is a fallback when the
                    -- HUD gives a specific name that the rig does not expose.
                    consider(inst, "generic-rig", 5500)
                end
            elseif (inst:IsA("TextLabel") or inst:IsA("TextButton")) and preferred ~= "" then
                -- World-space boss name tags often live under the model rather
                -- than using the same name. Follow the tag upward and accept the
                -- nearest ancestor that is genuinely an NPC rig, never a shed or
                -- arbitrary map model that merely contains the label.
                local labelMatch = matchesPreferred(inst.Text)
                if labelMatch then
                    local ancestor = inst.Parent
                    while ancestor and ancestor ~= workspace do
                        if ancestor:IsA("Model") and ancestor ~= LocalPlayer.Character then
                            local rootPart, humanoid = explicitRigRoot(ancestor)
                            if (rootPart or humanoid) and not isUiOrEffectModel(ancestor.Name) then
                                consider(ancestor, "world-name-tag", 17000)
                                break
                            end
                        end
                        ancestor = ancestor.Parent
                    end
                end
            end
        end

        return bestModel
    end

    local MOB_NAME_PARTS = { "sprout", "biter", "thief", "monster", "minion" }

    local function isBossModel(model)
        if not model or not model:IsA("Model") then
            return false
        end
        local candidate = normalizedName(model.Name)
        local preferred = normalizedName(Game.areaBossName)
        if candidate == "" then
            return false
        end
        if string.find(candidate, "boss", 1, true)
            or string.find(candidate, "barkback", 1, true) then
            return true
        end
        -- The HUD announces boss names (for example, "Old Barkback") that do
        -- not necessarily include the word "boss". Keep those out of the mob
        -- interception branch too.
        if preferred ~= "" and (candidate == preferred
            or string.find(candidate, preferred, 1, true) ~= nil
            or string.find(preferred, candidate, 1, true) ~= nil) then
            return true
        end
        for _, attributeName in ipairs({ "MobType", "MonsterType", "EnemyType", "NPCType", "Type", "DisplayName" }) do
            local attributeValue = model:GetAttribute(attributeName)
            if attributeValue ~= nil then
                local typed = normalizedName(attributeValue)
                if string.find(typed, "boss", 1, true) or string.find(typed, "barkback", 1, true) then
                    return true
                end
                if preferred ~= "" and typed ~= "" and (typed == preferred
                    or string.find(typed, preferred, 1, true) ~= nil
                    or string.find(preferred, typed, 1, true) ~= nil) then
                    return true
                end
            end
        end
        return false
    end

    local function isLiveMob(model)
        if not model or not model:IsA("Model") or not model.Parent or model == LocalPlayer.Character then
            return false
        end
        if isBossModel(model) then
            return false
        end
        local candidate = normalizedName(model.Name)
        -- Some NPC rigs have generic Model names and expose the type separately.
        for _, attributeName in ipairs({ "MobType", "MonsterType", "EnemyType", "NPCType", "Type", "DisplayName" }) do
            local attributeValue = model:GetAttribute(attributeName)
            if attributeValue ~= nil then
                candidate ..= normalizedName(attributeValue)
            end
        end
        for _, childName in ipairs({ "MobType", "MonsterType", "EnemyType", "NPCType", "Type", "DisplayName" }) do
            local valueObject = model:FindFirstChild(childName)
            if valueObject and (valueObject:IsA("StringValue")) then
                candidate ..= normalizedName(valueObject.Value)
            end
        end
        if candidate == "" or string.find(candidate, "boss", 1, true)
            or string.find(candidate, "barkback", 1, true) then
            return false
        end
        local nameMatch = false
        for _, part in ipairs(MOB_NAME_PARTS) do
            if string.find(candidate, part, 1, true) then
                nameMatch = true
                break
            end
        end
        if not nameMatch then return false end

        local folder = treesFolder()
        if folder and model:IsDescendantOf(folder) then return false end
        local hp = modelHealth(model)
        if hp ~= nil and hp <= 0 then return false end
        return modelRootPart(model) ~= nil
    end

    local function findNearestMob(maxDistance)
        maxDistance = maxDistance or 90
        local _, root = getRoot()
        if not root then return nil end

        -- Reuse a live nearby target between scans so we don't walk the entire
        -- workspace hierarchy on every 0.1-second farm tick.
        if isLiveMob(Game.cachedMob) then
            local mobRoot = modelRootPart(Game.cachedMob)
            if mobRoot and (mobRoot.Position - root.Position).Magnitude <= maxDistance then
                if os.clock() - Game.lastMobScanAt < 0.4 then
                    return Game.cachedMob
                end
            else
                Game.cachedMob = nil
            end
        else
            Game.cachedMob = nil
        end
        if os.clock() - Game.lastMobScanAt < 0.4 then return nil end
        Game.lastMobScanAt = os.clock()

        local best, bestDistance = nil, maxDistance
        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("Model") and isLiveMob(inst) then
                local mobRoot = modelRootPart(inst)
                local distance = mobRoot and (mobRoot.Position - root.Position).Magnitude or math.huge
                if distance <= bestDistance then
                    best, bestDistance = inst, distance
                end
            end
        end
        Game.cachedMob = best
        return best
    end

    local function groundLogs()
        local folder = workspace:FindFirstChild("Logs")
        local out = {}
        if not folder then 
            return out 
        end
        local _, root = getRoot()
        if not root then 
            return out 
        end
        local dist = {}
        for _, log in ipairs(folder:GetChildren()) do
            local wood = log:FindFirstChild("Wood")
            if wood and wood:IsA("BasePart") and log:GetAttribute("ThrownBy") == nil and (Game.badLogs[log] or 0) < 2 then
                local d = (wood.Position - root.Position).Magnitude
                if d <= 250 then 
                    dist[log] = d 
                    table.insert(out, log) 
                end
            end
        end
        table.sort(out, function(a, b) 
            return dist[a] < dist[b] 
        end)
        return out
    end

    local function sellSpots()
        local out = {}
        local tagged = CollectionService:GetTagged("SellOutpost")
        if #tagged > 0 then
            for _, inst in ipairs(tagged) do 
                table.insert(out, inst) 
            end
        else
            local huts = workspace:FindFirstChild("ForestHuts")
            if huts then
                for _, d in ipairs(huts:GetDescendants()) do
                    if d.Name == "SellOutpost" then 
                        table.insert(out, d) 
                    end
                end
            end
        end
        local map = workspace:FindFirstChild("Map")
        local main = map and map:FindFirstChild("SellSpot")
        if main then 
            table.insert(out, main) 
        end
        return out
    end

    local function nearestPad()
        local _, root = getRoot()
        if not root then 
            return nil 
        end
        local best, bestDist
        for _, spot in ipairs(sellSpots()) do
            local pad = spot:FindFirstChild("DepositPad")
            if pad and pad:IsA("BasePart") then
                local dist = (pad.Position - root.Position).Magnitude
                if not bestDist or dist < bestDist then 
                    best, bestDist = pad, dist 
                end
            end
        end
        return best
    end

    local function stationPosition(name)
        local map = workspace:FindFirstChild("Map")
        local cabin = map and map:FindFirstChild("LogCabin")
        local shop = cabin and cabin:FindFirstChild("Shop")
        local stations = shop and shop:FindFirstChild("Stations")
        local station = stations and stations:FindFirstChild(name)
        local anchor = station and station:FindFirstChild("PromptAnchor")
        return partPosition(anchor) or partPosition(station)
    end

