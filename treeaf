    local function farmActive() 
        return Flags.AutoChop or Flags.AutoPickup or Flags.AutoSell 
    end

    local function equipTool(name)
        local humanoid, root = getRoot()
        local character = LocalPlayer.Character
        if not character or not humanoid or not root then
            return nil
        end

        local tool = character:FindFirstChild(name)
        if tool and tool:IsA("Tool") then
            return tool
        end

        local backpack = LocalPlayer:FindFirstChild("Backpack")
        tool = backpack and backpack:FindFirstChild(name)
        if tool and tool:IsA("Tool") then
            local equipped = pcall(function()
                humanoid:EquipTool(tool)
            end)
            if not equipped then
                return nil
            end
            task.wait(0.3)
            local current = character:FindFirstChild(name)
            return current and current:IsA("Tool") and current or nil
        end
        return nil
    end

    local function sellLogs()
        if carried() <= 0 or not Remotes then 
            return false 
        end
        local pad = nearestPad()
        if not pad then 
            return false 
        end
        Game.status = "Selling"
        teleport(pad.Position + Vector3.new(0, 3, 0))
        task.wait(0.4)
        if unloaded then 
            return false 
        end
        Remotes.DepositLogs:FireServer(false)
        Game.sells += 1
        task.wait(0.6)
        return true
    end

    local function pickupLogs()
        local limit = sellThreshold()
        local picked = false
        for _, log in ipairs(groundLogs()) do
            if unloaded or not Flags.AutoPickup or carried() >= limit then 
                break 
            end
            local wood = log:FindFirstChild("Wood")
            if wood and wood:IsA("BasePart") and log.Parent then
                Game.status = "Picking Up Logs"
                local before = carried()
                teleport(wood.Position + Vector3.new(0, 3, 0))
                task.wait(0.15)
                if not Remotes then 
                    return picked 
                end
                Remotes.PickUpLog:FireServer(log)
                task.wait(0.2)
                if carried() > before or not log.Parent then 
                    picked = true 
                else 
                    Game.badLogs[log] = (Game.badLogs[log] or 0) + 1 
                end
            end
        end
        for log in pairs(Game.badLogs) do 
            if not log.Parent then 
                Game.badLogs[log] = nil 
            end 
        end
        return picked
    end

    local function chopTree(tree)
        local base = tree:FindFirstChild("TrunkBase")
        local _, root = getRoot()
        if not base or not base:IsA("BasePart") or not root then 
            return 
        end
        
        local standAt = base.Position + Vector3.new(3, 2, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.lookAt(standAt, Vector3.new(base.Position.X, standAt.Y, base.Position.Z))
        task.wait(0.2)
        if not Remotes then 
            return 
        end

        local lastHp = tonumber(tree:GetAttribute("HP")) or 0
        local stuck = 0
        local started = os.clock()

        while not unloaded and Flags.AutoChop and tree.Parent == treesFolder() and (tonumber(tree:GetAttribute("HP")) or 0) > 0 do
            if os.clock() - started > 60 then 
                Game.badTrees[tree] = true 
                return 
            end
            
            local _, r = getRoot()
            if not r then 
                return 
            end
            if (r.Position - standAt).Magnitude > 6 then
                r.CFrame = CFrame.lookAt(standAt, Vector3.new(base.Position.X, standAt.Y, base.Position.Z))
            end

            -- Standard chopping only; no automatic tool switching.
            Game.status = "Chopping " .. tostring(tree:GetAttribute("TreeType") or "Tree")
            Game.hitSeq += 1
            Remotes.Chop:FireServer(tree, base.Position + Vector3.new(1, 1, 0), 1, Game.hitSeq)
            task.wait(math.max(0.1, Flags.ChopDelay))

            local hp = tonumber(tree:GetAttribute("HP")) or 0
            if hp < lastHp then
                lastHp = hp
                stuck = 0
            else
                stuck += 1
                if stuck >= 15 then 
                    Game.badTrees[tree] = true 
                    return 
                end
            end
        end
        if (tonumber(tree:GetAttribute("HP")) or 0) <= 0 then
            Game.trees += 1
            task.wait(1)
        end
    end

    local function equipAxe()
        local humanoid, root = getRoot()
        local character = LocalPlayer.Character
        if not character or not humanoid or not root then
            return nil
        end

        -- Some versions of the game give the equipped axe a different internal
        -- name (or don't expose it as a Backpack tool). Prefer the tool already
        -- in the character instead of requiring its Name to contain "Axe".
        local heldTool = character:FindFirstChildOfClass("Tool")
        if heldTool then
            return heldTool
        end

        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local containers = { backpack }
        for _, container in ipairs(containers) do
            if container then
                local exact = container:FindFirstChild("Axe")
                if exact and exact:IsA("Tool") then
                    local ok = pcall(function() humanoid:EquipTool(exact) end)
                    if not ok then return nil end
                    task.wait(0.1)
                    return character:FindFirstChildOfClass("Tool")
                end
            end
        end
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") and string.find(string.lower(item.Name), "axe", 1, true) then
                    local ok = pcall(function() humanoid:EquipTool(item) end)
                    if not ok then return nil end
                    task.wait(0.1)
                    return character:FindFirstChildOfClass("Tool")
                end
            end
        end
        -- The game may handle an attack on mouse click alone, so callers still
        -- attempt the click even when no Tool instance is exposed locally.
        return nil
    end

    Game.aimCameraAt = function(targetPosition)
        local camera = workspace.CurrentCamera
        if not camera or not targetPosition then return end
        pcall(function()
            local cameraPosition = camera.CFrame.Position
            camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
        end)
    end

    Game.clickAttack = function()
        -- Use the viewport center because the camera is aimed at the target. A
        -- hard-coded point such as (800, 400) can land on the open script menu.
        local character = LocalPlayer.Character
        local heldTool = character and character:FindFirstChildOfClass("Tool")
        if heldTool then
            pcall(function() heldTool:Activate() end)
        end
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1600, 900)
        local point = Vector2.new(math.floor(viewport.X * 0.5), math.floor(viewport.Y * 0.5))
        local clickSucceeded = pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(point)
        end)
        if not clickSucceeded then
            pcall(function()
                local virtualInput = game:GetService("VirtualInputManager")
                virtualInput:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
                task.wait(0.04)
                virtualInput:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
            end)
        end
    end

    Game.getBossHeadPosition = function(boss, boxCf, boxSize, targetRoot)
        -- Prefer the boss's actual Head part so our hover height and aim point
        -- are level with its head, not above the model's bounding box.
        local head = nil
        pcall(function()
            local candidate = boss:FindFirstChild("Head", true)
            if candidate and candidate:IsA("BasePart") then
                head = candidate
            end
        end)
        if head then
            return head.Position
        end

        -- Some custom NPC rigs do not expose a part named Head. In that case,
        -- aim near the upper quarter of the model and keep the player at that
        -- same height as a practical fallback.
        if boxCf and boxSize then
            return boxCf.Position + Vector3.new(0, boxSize.Y * 0.22, 0)
        end
        return targetRoot and targetRoot.Position or Vector3.zero
    end

    Game.getPlayerHeadOffset = function(playerRoot)
        -- The HumanoidRootPart sits below the player's eye/head level. Aligning
        -- the root itself with the boss's aim point makes the player look too high.
        -- Measure the actual head-to-root offset so the player's head/shot level
        -- lines up with the boss point being aimed at.
        local character = LocalPlayer.Character
        local head = character and character:FindFirstChild("Head", true)
        if playerRoot and head and head:IsA("BasePart") then
            return head.Position.Y - playerRoot.Position.Y
        end
        return 1.5
    end

    Game.placeAtBossWeakpoint = function(boss, resetDirection)
        local _, playerRoot = getRoot()
        local targetRoot = modelRootPart(boss)
        if not playerRoot or not targetRoot then
            return false
        end

        local boxCf, boxSize
        local ok = pcall(function()
            boxCf, boxSize = boss:GetBoundingBox()
        end)
        if not ok or not boxCf or not boxSize then
            boxCf = targetRoot.CFrame
            boxSize = targetRoot.Size
        end

        -- Choose one stable approach direction in FRONT of the boss. Roblox's
        -- LookVector is the boss's forward-facing direction; keep the player's
        -- approach horizontal so the avatar doesn't pitch upward toward the aim point.
        if resetDirection or not Game.bossApproachDirection then
            local look = targetRoot.CFrame.LookVector
            local horizontalLook = Vector3.new(look.X, 0, look.Z)
            if horizontalLook.Magnitude < 0.05 then
                horizontalLook = Vector3.new(0, 0, -1)
            end
            Game.bossApproachDirection = horizontalLook.Unit
        end

        local horizontal = Game.bossApproachDirection
        local frontDistance = 10
        local aimPoint = Game.getBossHeadPosition(boss, boxCf, boxSize, targetRoot)
        local headOffset = Game.getPlayerHeadOffset(playerRoot)

        -- Put the player's HEAD at the same height as the exact point the camera
        -- and gun are aiming at. The root itself must therefore be lower by the
        -- player's measured head-to-root offset (not at aimPoint.Y).
        local destination = Vector3.new(
            boxCf.Position.X + horizontal.X * frontDistance,
            aimPoint.Y - headOffset,
            boxCf.Position.Z + horizontal.Z * frontDistance
        )
        local flatFacingPoint = Vector3.new(aimPoint.X, destination.Y, aimPoint.Z)

        if Game.bossAnchoredRoot ~= playerRoot then
            Game.bossAnchoredRoot = playerRoot
            Game.bossRootWasAnchored = playerRoot.Anchored
        end
        pcall(function()
            playerRoot.AssemblyLinearVelocity = Vector3.zero
            playerRoot.AssemblyAngularVelocity = Vector3.zero
            playerRoot.Anchored = true
            playerRoot.CFrame = CFrame.lookAt(destination, flatFacingPoint)
        end)

        Game.bossAimPoint = aimPoint
        Game.bossLockedBossPosition = targetRoot.Position
        -- Keep a return point in the same boss area so a death does not send
        -- the player back to the tree-farming spawn. This is refreshed while
        -- the boss is alive and is used after CharacterAdded.
        Game.bossReturnPosition = targetRoot.Position + Vector3.new(0, 3, 0)
        Game.bossNextRepositionAt = os.clock() + 0.8
        Game.aimCameraAt(aimPoint)
        return true
    end

    -- Simulate the game's ordinary hotbar keys rather than searching Backpack
    -- for a Tool instance; in this game slot 5 is the gun and slot 2 is the axe.
    Game.pressWeaponSlot = function(slot)
        local keyCode = slot == 5 and Enum.KeyCode.Five or Enum.KeyCode.Two
        local ok = pcall(function()
            local virtualInput = game:GetService("VirtualInputManager")
            virtualInput:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.06)
            virtualInput:SendKeyEvent(false, keyCode, false, game)
        end)
        if not ok then
            local keyNumber = slot == 5 and 0x35 or 0x32
            if type(keypress) == "function" and type(keyrelease) == "function" then
                ok = pcall(function()
                    keypress(keyNumber)
                    task.wait(0.06)
                    keyrelease(keyNumber)
                end)
            end
        end
        if not ok then
            warn("[TheForest] Could not send hotbar key " .. tostring(slot) .. "; check whether the executor supports keyboard input.")
        end
        return ok
    end

    -- Keep the left mouse button held down through the boss encounter. The
    -- matching release is performed on every exit path from runBossEncounter.
    Game.setAttackMouseDown = function(isDown)
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1600, 900)
        local point = Vector2.new(math.floor(viewport.X * 0.5), math.floor(viewport.Y * 0.5))
        local ok = pcall(function()
            local virtualInput = game:GetService("VirtualInputManager")
            virtualInput:SendMouseButtonEvent(point.X, point.Y, 0, isDown, game, 0)
        end)
        if not ok then
            pcall(function()
                VirtualUser:CaptureController()
                if isDown then
                    VirtualUser:Button1Down(point, camera and camera.CFrame or CFrame.new())
                else
                    VirtualUser:Button1Up(point, camera and camera.CFrame or CFrame.new())
                end
            end)
        end
        return ok
    end

    local function runBossEncounter(boss, areaKey)
        local bossName = boss and boss.Name or Game.areaBossName or "Boss"
        Game.status = "Boss: 10 studs away (front/head-level)"
        notify("Boss encounter started: " .. tostring(bossName) .. "; selecting slot 5 and following 10 studs in front at head level.")
        warn("[TheForest] Boss hover tracking enabled: following 10 studs in front at head level without falling.")

        local lastMissingTargetWarning = 0
        local bossMissingSince = nil
        local bossBarMissingSince = nil
        local outcome = "stopped"
        Game.bossApproachDirection = nil
        Game.bossLockedBossPosition = nil
        Game.bossNextRepositionAt = 0
        Game.bossPlayerDied = false
        Game.bossEncounterActive = true
        Game.bossAnchoredRoot = nil
        Game.bossRootWasAnchored = nil
        local previousWindowVisible = Game.overlayWindow and Game.overlayWindow.Visible
        if Game.overlayWindow then
            Game.overlayWindow.Visible = false
        end
        Game.pressWeaponSlot(5)
        task.wait(0.15)
        -- Wait for a visible top boss bar and a matching model before firing.
        Game.setAttackMouseDown(false)

        local loopOk, loopErr = pcall(function()
            while not unloaded and Flags.AutoChop and Game.areaCompleteKey == areaKey do
                if Game.bossPlayerDied then
                    outcome = "player-died"
                    break
                end
                local currentState = readAreaHudState()
                if currentState.key ~= areaKey
                    or (currentState.percent ~= nil and currentState.percent < 99.9) then
                    outcome = "area-changed"
                    break
                end

                -- The top health bar is authoritative. Release fire immediately
                -- whenever it disappears; don't keep shooting/teleporting at a
                -- stale model, nameplate, stump, or building.
                if not currentState.bossBarPresent or not currentState.bossName then
                    Game.setAttackMouseDown(false)
                    bossBarMissingSince = bossBarMissingSince or os.clock()
                    if os.clock() - bossBarMissingSince >= 1.8 then
                        local stillTracked = findActiveBoss(Game.areaBossName or bossName)
                        local trackedHp = stillTracked and modelHealth(stillTracked) or nil
                        if not stillTracked or (trackedHp ~= nil and trackedHp <= 0) then
                            outcome = "defeated"
                        else
                            outcome = "boss-bar-lost"
                        end
                        break
                    end
                    task.wait(0.12)
                else
                    bossBarMissingSince = nil
                    Game.areaBossName = currentState.bossName
                    if currentState.bossHealth ~= nil and currentState.bossHealth <= 0 then
                        Game.setAttackMouseDown(false)
                        outcome = "defeated"
                        break
                    end

                    local liveBoss = findActiveBoss(currentState.bossName)
                    if not liveBoss then
                        Game.setAttackMouseDown(false)
                        bossMissingSince = bossMissingSince or os.clock()
                        if os.clock() - bossMissingSince >= 1.8 then
                            outcome = "boss-target-missing"
                            break
                        end
                        task.wait(0.12)
                    else
                        bossMissingSince = nil
                        boss = liveBoss
                        bossName = currentState.bossName
                        local hp = modelHealth(boss)
                        if hp ~= nil and hp <= 0 then
                            Game.setAttackMouseDown(false)
                            outcome = "defeated"
                            break
                        end
                        local _, root = getRoot()
                        local targetRoot = modelRootPart(boss)
                        if not root or not targetRoot then
                            Game.setAttackMouseDown(false)
                            if os.clock() - lastMissingTargetWarning > 3 then
                                lastMissingTargetWarning = os.clock()
                                warn("[TheForest] Boss bar is visible, but its matching world model/root could not be found. Firing is paused to avoid attacking unrelated objects.")
                            end
                            task.wait(0.15)
                        else
                            -- Hold fire only while both the live bar and the
                            -- corresponding model are present in the current scan.
                            -- placeAtBossWeakpoint records the original Anchored
                            -- state before it anchors the root, then follows the
                            -- boss on every pass to prevent falling.
                            Game.setAttackMouseDown(true)
                            -- Follow the boss continuously instead of only
                            -- repositioning after it has moved several studs.
                            -- placeAtBossWeakpoint recalculates the boss's current
                            -- bounding-box position and head height on every pass,
                            -- then keeps the player's root anchored and zeros its
                            -- velocity. The approach direction stays stable, so the
                            -- player follows the boss without orbiting chaotically.
                            Game.placeAtBossWeakpoint(boss, false)
                            task.wait(0.08)
                        end
                    end
                end
            end
        end)

        Game.setAttackMouseDown(false)
        if Game.bossAnchoredRoot and Game.bossAnchoredRoot.Parent then
            pcall(function()
                Game.bossAnchoredRoot.AssemblyLinearVelocity = Vector3.zero
                Game.bossAnchoredRoot.AssemblyAngularVelocity = Vector3.zero
                Game.bossAnchoredRoot.Anchored = (Game.bossRootWasAnchored == true)
            end)
        end
        Game.bossAnchoredRoot = nil
        Game.bossRootWasAnchored = nil
        Game.bossEncounterActive = false
        Game.bossApproachDirection = nil
        Game.bossLockedBossPosition = nil
        Game.bossNextRepositionAt = 0
        if Game.overlayWindow and previousWindowVisible ~= nil then
            Game.overlayWindow.Visible = previousWindowVisible
        end
        if not loopOk then
            warn("[TheForest] Boss attack loop stopped safely: " .. tostring(loopErr))
            return "stopped"
        end
        if outcome == "defeated" then
            Game.pressWeaponSlot(2)
            task.wait(0.12)
            notify(tostring(bossName) .. " defeated; released fire and switched back to Axe (slot 2).")
        end
        return outcome
    end

    local function placeNearMob(mob, approachIndex)
        local _, playerRoot = getRoot()
        local targetRoot = modelRootPart(mob)
        if not playerRoot or not targetRoot then return false end

        -- Stay at melee range and face the model's root rather than swinging at
        -- its old position. Rotate around the target when hits stop registering.
        local directions = {
            targetRoot.CFrame.LookVector,
            -targetRoot.CFrame.LookVector,
            targetRoot.CFrame.RightVector,
            -targetRoot.CFrame.RightVector,
        }
        local direction = directions[((tonumber(approachIndex) or 1) - 1) % #directions + 1]
        local horizontal = Vector3.new(direction.X, 0, direction.Z)
        if horizontal.Magnitude < 0.05 then horizontal = Vector3.new(0, 0, 1) end
        horizontal = horizontal.Unit

        local closeDistance = math.max(2.2, targetRoot.Size.Z * 0.5 + 1.1)
        local destination = targetRoot.Position + horizontal * closeDistance + Vector3.new(0, 0.35, 0)
        playerRoot.AssemblyLinearVelocity = Vector3.zero
        local targetPosition = targetRoot.Position + Vector3.new(0, 0.8, 0)
        playerRoot.CFrame = CFrame.lookAt(destination, targetPosition)
        Game.aimCameraAt(targetPosition)
        return true
    end

    local function attackMobWithAxe(mob, areaKey)
        local mobName = mob and mob.Name or "Night Monster"
        Game.status = "Defending against " .. tostring(mobName) .. " with Axe"
        if Game.lastMobNotice ~= mob then
            Game.lastMobNotice = mob
            notify("Mob detected nearby: " .. tostring(mobName) .. ". Moving into axe range and attacking.")
        end

        local startedAt = os.clock()
        local lastKnownHealth = modelHealth(mob)
        local lastDamageAt = os.clock()
        local lastWarningAt = 0
        local nextPositionAdjustAt = 0
        local approachIndex = 1
        local lastApproachChangeAt = os.clock()

        while not unloaded and Flags.AutoChop do
            -- Nearby-mob interception is active only during the Night phase (not Dusk/Dawn). If the HUD flips
            -- to Day during combat, stop intercepting and return to farming.
            if Game.dayNight ~= "Night" then
                Game.cachedMob = nil
                Game.lastMobNotice = nil
                return "daytime"
            end
            if isBossModel(mob) then
                -- Bosses are handled only by the separate area-completion phase.
                Game.cachedMob = nil
                Game.lastMobNotice = nil
                return "boss-excluded"
            end
            if not isLiveMob(mob) then
                -- If it was removed or its health reached zero, allow replication
                -- a moment before resuming tree chopping.
                task.wait(0.25)
                if not isLiveMob(mob) then
                    Game.cachedMob = nil
                    Game.lastMobNotice = nil
                    notify(tostring(mobName) .. " is no longer active; resuming the area routine.")
                    return "defeated"
                end
            end

            -- If a target has been moved away, don't chase it around the map.
            local _, playerRoot = getRoot()
            local targetRoot = modelRootPart(mob)
            if not playerRoot or not targetRoot then
                task.wait(0.15)
                continue
            end
            if (targetRoot.Position - playerRoot.Position).Magnitude > 110 then
                Game.cachedMob = nil
                Game.lastMobNotice = nil
                return "out-of-range"
            end

            if os.clock() - lastApproachChangeAt > 2.5 and os.clock() - lastDamageAt > 2.5 then
                approachIndex = approachIndex % 4 + 1
                lastApproachChangeAt = os.clock()
                nextPositionAdjustAt = 0
            end
            if os.clock() >= nextPositionAdjustAt then
                placeNearMob(mob, approachIndex)
                nextPositionAdjustAt = os.clock() + 0.22
            end

            equipAxe()
            -- placeNearMob faces the character toward the current target. Attack
            -- via a normal click even if the executor does not expose an Axe Tool.
            Game.clickAttack()

            local currentHealth = modelHealth(mob)
            if currentHealth ~= nil then
                if lastKnownHealth == nil or currentHealth < lastKnownHealth then
                    lastKnownHealth = currentHealth
                    lastDamageAt = os.clock()
                elseif currentHealth > 0 and os.clock() - lastDamageAt > 2 then
                    approachIndex = approachIndex % 4 + 1
                    lastApproachChangeAt = os.clock()
                    lastDamageAt = os.clock()
                    nextPositionAdjustAt = 0
                    if os.clock() - lastWarningAt > 6 then
                        lastWarningAt = os.clock()
                        warn("[TheForest] Axe hits have not reduced " .. tostring(mobName) .. " health yet; cycling melee positions and retrying.")
                    end
                end
                if currentHealth <= 0 then
                    Game.cachedMob = nil
                    Game.lastMobNotice = nil
                    notify(tostring(mobName) .. " defeated; resuming the area routine.")
                    return "defeated"
                end
            elseif os.clock() - startedAt > 90 then
                warn("[TheForest] Could not confirm whether " .. tostring(mobName) .. " was defeated (no exposed health value). Returning to the farm loop.")
                Game.cachedMob = nil
                Game.lastMobNotice = nil
                return "unconfirmed"
            end
            task.wait(0.16)
        end
        return "stopped"
    end

    local function advanceToNextZone()
        if Game.zoneAdvancePending then return end
        local oldZone = Flags.Zone
        local oldIndex = zoneIndex(oldZone)
        local order = zoneOrder()
        if not oldIndex or #order == 0 then
            warn("[TheForest] Cannot advance to the next zone: zone order is unavailable.")
            return
        end

        Game.zoneAdvancePending = true
        Game.status = "Boss defeated; waiting for the next area to unlock"
        task.spawn(function()
            local deadline = os.clock() + 10
            while not unloaded and os.clock() < deadline do
                -- Respect manual changes made while waiting for server unlock state.
                if Flags.Zone ~= oldZone then
                    Game.zoneAdvancePending = false
                    return
                end

                local nextZone = nil
                local liveOrder = zoneOrder()
                for i = oldIndex + 1, #liveOrder do
                    if zoneUnlocked(liveOrder[i]) then
                        nextZone = liveOrder[i]
                        break
                    end
                end

                if nextZone then
                    Flags.Zone = nextZone
                    Game.autoZoneAdvanceTarget = nextZone
                    table.clear(Game.badTrees)
                    Game.currentAreaKey = nil
                    Game.areaCompleteKey = nil
                    Game.areaCompletedAt = nil
                    Game.bossDefeatedKey = nil
                    Game.cachedBoss = nil
                    Game.lastBossNotice = nil
                    Game.cachedMob = nil
                    Game.lastMobNotice = nil
                    if zoneDropdown then
                        pcall(function() zoneDropdown.SetValue(nextZone) end)
                    end
                    local saved, saveErr = saveConfig(true)
                    if not saved then
                        warn("[TheForest] Moved to " .. zoneLabel(nextZone) .. " but could not save config: " .. tostring(saveErr))
                    end
                    Game.status = "Advanced to " .. zoneLabel(nextZone)
                    notify("Boss defeated; Zone dropdown advanced to " .. zoneLabel(nextZone) .. ". Auto Chop will use trees from that zone.")
                    Game.zoneAdvancePending = false
                    return
                end
                task.wait(0.25)
            end

            if not unloaded then
                notify("Boss defeated, but no next unlocked zone appeared. Kept Zone set to " .. zoneLabel(oldZone) .. ".")
            end
            Game.zoneAdvancePending = false
        end)
    end

    local function stepFarm()
        if not Remotes or not farmActive() or Game.busy then
            return
        end
        if not getRoot() then
            return
        end
        Game.busy = true
        local ok, err = pcall(function()
            local areaState = readAreaHudState()
            syncZoneSelectionFromHud(areaState)
            -- syncZoneSelectionFromHud may have changed Flags.Zone, so rebuild
            -- the key after it runs instead of keeping the old dropdown value.
            areaState.key = tostring(Flags.Zone) .. "|" .. tostring(areaState.marker or "")
            local areaKey = areaState.key

            if Game.currentAreaKey ~= areaKey then
                Game.currentAreaKey = areaKey
                Game.areaCompleteKey = nil
                Game.areaCompletedAt = nil
                Game.bossDefeatedKey = nil
                Game.cachedBoss = nil
                Game.lastBossScanAt = 0
                Game.lastBossNotice = nil
                Game.areaBossName = areaState.bossName or areaState.bossHintName
                Game.bossSearchWarningShown = false
            elseif areaState.bossBarPresent and areaState.bossName then
                if Game.areaBossName ~= areaState.bossName then
                    Game.cachedBoss = nil
                    Game.lastBossScanAt = 0
                end
                Game.areaBossName = areaState.bossName
            elseif areaState.bossHintName and not Game.areaBossName then
                Game.areaBossName = areaState.bossHintName
            end

            -- A real progress percentage is the primary gate. If the HUD doesn't
            -- expose it, retain the old no-tree wait instead of falsely claiming
            -- the zone reached 100%.
            if areaState.percent ~= nil then
                local rounded = math.floor(areaState.percent * 10 + 0.5) / 10
                if Game.lastProgressReport ~= tostring(areaKey) .. "=" .. tostring(rounded) then
                    Game.lastProgressReport = tostring(areaKey) .. "=" .. tostring(rounded)
                    Game.status = zoneLabel(Flags.Zone) .. " progress: " .. tostring(rounded) .. "%"
                end
                if areaState.percent >= 99.9 and Game.areaCompleteKey ~= areaKey then
                    Game.areaCompleteKey = areaKey
                    Game.areaCompletedAt = os.clock()
                    Game.bossDefeatedKey = nil
                    Game.cachedBoss = nil
                    Game.lastBossScanAt = 0
                    Game.lastBossNotice = nil
                    Game.bossSearchWarningShown = false
                    notify(zoneLabel(Flags.Zone) .. " reached " .. tostring(rounded) .. "% cleared. Auto Chop paused for the boss encounter.")
                elseif areaState.percent < 99.9 and Game.areaCompleteKey == areaKey then
                    -- The area progress reset, or a new clear cycle began.
                    Game.areaCompleteKey = nil
                    Game.areaCompletedAt = nil
                    Game.bossDefeatedKey = nil
                    Game.cachedBoss = nil
                    Game.lastBossNotice = nil
                    Game.bossSearchWarningShown = false
                end
            end

            -- Once this area's HUD reaches 100%, pause tree chopping and wait for
            -- the boss named by the HUD. After its defeat, remain paused until the
            -- progress resets or the AREA n/total marker changes.
            if Game.areaCompleteKey == areaKey then
                if Game.bossDefeatedKey == areaKey then
                    Game.status = Game.zoneAdvancePending
                        and "Boss defeated; waiting for next zone unlock"
                        or "Area complete; boss defeated; Auto Chop paused"
                    return
                end

                -- Never lock onto a model from the area objective hint alone.
                -- The live top-screen boss name + HP bar must be present first.
                if not areaState.bossBarPresent or not areaState.bossName then
                    Game.cachedBoss = nil
                else
                    Game.areaBossName = areaState.bossName
                    if os.clock() - Game.lastBossScanAt >= 0.5 then
                        Game.lastBossScanAt = os.clock()
                        Game.cachedBoss = findActiveBoss(areaState.bossName)
                    elseif Game.cachedBoss and not Game.cachedBoss.Parent then
                        Game.cachedBoss = nil
                    end
                end

                local boss = Game.cachedBoss
                if boss then
                    if Game.lastBossNotice ~= boss then
                        Game.lastBossNotice = boss
                        local targetRoot = modelRootPart(boss)
                        local where = targetRoot and string.format(" (target %.1f, %.1f, %.1f)", targetRoot.Position.X, targetRoot.Position.Y, targetRoot.Position.Z) or ""
                        notify("Boss target locked: " .. tostring(boss.Name) .. where .. ". Starting gun encounter (slot 5).")
                        warn("[TheForest] Boss target locked to model '" .. tostring(boss.Name) .. "'" .. where)
                    end
                    local outcome = runBossEncounter(boss, areaKey)
                    if outcome == "defeated" then
                        Game.cachedBoss = nil
                        Game.bossDefeatedKey = areaKey
                        Game.status = tostring(boss.Name) .. " defeated; moving to next unlocked zone"
                        if Flags.AutoAdvanceZone then
                            notify(tostring(boss.Name) .. " defeated. Looking for the next unlocked zone.")
                            advanceToNextZone()
                        else
                            notify(tostring(boss.Name) .. " defeated. Auto Advance Zone is disabled; keeping the current selection.")
                        end
                    elseif outcome == "area-changed" then
                        Game.cachedBoss = nil
                    elseif outcome == "player-died" then
                        Game.cachedBoss = nil
                        Game.lastBossNotice = nil
                        Game.status = "Respawned after boss death; returning to boss area"
                        notify("Died during boss fight. Returning to the boss area and waiting for it to respawn.")
                    elseif outcome == "boss-bar-lost" then
                        Game.cachedBoss = nil
                        Game.status = "Boss bar missing; firing stopped, waiting for bar"
                        warn("[TheForest] Boss health bar disappeared from the top HUD; released fire and paused boss targeting.")
                    elseif outcome == "boss-target-missing" then
                        Game.cachedBoss = nil
                        Game.status = "Boss bar visible, but matching world model not found"
                        warn("[TheForest] Boss bar is visible but no matching boss rig was found. Firing stayed released to avoid targeting unrelated objects.")
                    elseif outcome == "stopped" then
                        Game.status = "Boss encounter paused"
                    end
                else
                    local waitingFor = Game.areaBossName and (" " .. tostring(Game.areaBossName)) or ""
                    Game.status = "Area complete; waiting for boss" .. waitingFor
                    if not Game.bossSearchWarningShown and Game.areaCompletedAt
                        and os.clock() - Game.areaCompletedAt >= 5 then
                        Game.bossSearchWarningShown = true
                        warn("[TheForest] Area is complete but no boss model matched the HUD name " .. tostring(Game.areaBossName) .. ". Search includes model names, display-name attributes, and world-space name tags.")
                    end
                end
                return
            end

            -- Keep tree farming as the default. Only interrupt it at night when
            -- a non-boss mob is already within 20 studs of the character. The
            -- encounter routine teleports into melee range, attacks, then returns
            -- here so the normal tree/pickup/sell cycle can continue.
            if Flags.AutoChop and Flags.AutoFightMobs and Game.dayNight == "Night" then
                local mob = findNearestMob(20)
                if mob and not isBossModel(mob) then
                    local outcome = attackMobWithAxe(mob, areaKey)
                    if outcome == "defeated" then
                        Game.status = "Night mob defeated; resuming tree chopping"
                    elseif outcome == "unconfirmed" then
                        Game.status = "Night mob attack unconfirmed; resuming farm loop"
                    elseif outcome == "daytime" then
                        Game.status = "Day detected; resuming tree chopping"
                    elseif outcome == "boss-excluded" then
                        Game.status = "Boss ignored by night-mob routine"
                    end
                    return
                end
            end

            local full = carried() >= sellThreshold()
            if Flags.AutoSell and (full or (carried() > 0 and not Flags.AutoChop and not (Flags.AutoPickup and #groundLogs() > 0))) then
                sellLogs()
                return
            end
            if Flags.AutoPickup and not full and #groundLogs() > 0 then
                pickupLogs()
                return
            end
            if Flags.AutoChop then
                if not zoneUnlocked(Flags.Zone) then
                    Game.status = zoneLabel(Flags.Zone) .. " is locked"
                    return
                end
                if full and not Flags.AutoSell then
                    Game.status = "Bag full"
                    return
                end
                local tree = nearestTree()
                if tree then
                    Game.lastBossNotice = nil
                    chopTree(tree)
                else
                    Game.status = "No trees in " .. zoneLabel(Flags.Zone) .. " (waiting for area progress/boss)"
                end
                return
            end
            Game.status = "Idle"
        end)
        Game.busy = false
        if not ok then
            error(err, 0)
        end
    end

