    function Setters.feature(key, value)
        Flags[key] = value == true
        saveConfig()
        if FARM_KEYS[key] then
            setWorker("Farm", farmActive(), 0.1, stepFarm)
            if not farmActive() then 
                Game.status = "Idle" 
            end
            return
        end
        if BUY_KEYS[key] then
            local anyBuy = false
            for k in pairs(BUY_KEYS) do 
                if Flags[k] then 
                    anyBuy = true 
                end 
            end
            setWorker("Buyer", anyBuy, 2, stepBuyer)
            return
        end
        local spec = WORKER_STEPS[key]
        if spec then 
            setWorker(key, Flags[key], spec[1], spec[2]) 
        end
    end

