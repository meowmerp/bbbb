    local function nextUpgradePrice(id)
        local item = upgradeDef(id)
        if not item then 
            return nil 
        end
        local level = math.floor(tonumber(LocalPlayer:GetAttribute("Up_" .. id)) or 0)
        return item.Prices[level + 1], item
    end

    local function capacity()
        local item = upgradeDef("GearBackpack")
        local level = backpackLevel()
        local bag = (item and item.Capacity and level > 0) and item.Capacity[math.min(level, #item.Capacity)] or 0
        local total = bag + 5
        
        if LocalPlayer:GetAttribute("InfiniteBackpack") or LocalPlayer:GetAttribute("InfBackpack") or LocalPlayer:GetAttribute("HasInfiniteBackpack") then
            return 999999
        end
        
        if carried() > total and total <= 5 then
            return 999999
        end
        
        return total
    end

