    local function setAutoReconnect(value)
        Flags.AutoReconnect = value == true
        if reconnectConn then 
            reconnectConn:Disconnect() 
            reconnectConn = nil 
        end
        if reconnectFailedConn then 
            reconnectFailedConn:Disconnect() 
            reconnectFailedConn = nil 
        end
        if not Flags.AutoReconnect then 
            reconnectToken += 1 
            return 
        end
        -- Some executors cannot connect to ErrorMessageChanged because it
        -- requires RobloxScript capability. Treat it as an optional signal so
        -- a restricted connection cannot abort the whole script on startup.
        local errorSignalOk, errorSignal = pcall(function()
            return GuiService.ErrorMessageChanged
        end)
        if errorSignalOk and errorSignal then
            local connectOk, connectionOrErr = pcall(function()
                return bind(errorSignal, function()
                    if unloaded or not Flags.AutoReconnect then
                        return
                    end
                    local token = reconnectToken + 1
                    reconnectToken = token
                    task.delay(1.5, function()
                        if unloaded or not Flags.AutoReconnect or reconnectToken ~= token then
                            return
                        end
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                        end)
                    end)
                end)
            end)
            if connectOk then
                reconnectConn = connectionOrErr
            else
                warn("[TheForest] Auto Reconnect: ErrorMessageChanged is unavailable in this executor; using teleport-failure fallback.")
            end
        else
            warn("[TheForest] Auto Reconnect: ErrorMessageChanged is unavailable; using teleport-failure fallback.")
        end

        -- Keep the supported teleport-failure fallback, but guard it too so
        -- an executor limitation in this optional feature cannot stop startup.
        local failedConnectOk, failedConnectionOrErr = pcall(function()
            return bind(TeleportService.TeleportInitFailed, function(player)
                if player ~= LocalPlayer or unloaded or not Flags.AutoReconnect then
                    return
                end
                task.delay(2, function()
                    if unloaded or not Flags.AutoReconnect then
                        return
                    end
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, LocalPlayer)
                    end)
                end)
            end)
        end)
        if failedConnectOk then
            reconnectFailedConn = failedConnectionOrErr
        else
            warn("[TheForest] Auto Reconnect fallback unavailable: " .. tostring(failedConnectionOrErr))
        end
    end

