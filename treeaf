    local function addDropdown(parent, label, placeholder, options, initial, isMulti, onChanged)
        local container = new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1 }, parent)
        if label then
            new("TextLabel", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = label, Font = FONT_MED, TextSize = 12, TextColor3 = Theme.muted, TextXAlignment = Enum.TextXAlignment.Left }, container)
        end
        local btn = new("TextButton", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 20), BackgroundColor3 = Theme.track, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, container)
        corner(btn, 6)
        local btnStroke = new("UIStroke", { Color = Theme.track }, btn)
        local text = new("TextLabel", { Size = UDim2.new(1, -28, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Text = "", Font = FONT_MED, TextSize = 12, TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, btn)
        local chev = new("TextLabel", { Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -22, 0, 0), BackgroundTransparency = 1, Text = "v", Font = FONT_BOLD, TextSize = 11, TextColor3 = Theme.muted }, btn)

        local currentOptions = options or {}

        local selected = {}
        if isMulti then
            if type(initial) == "table" then
                for k, v in pairs(initial) do
                    if type(k) == "string" and v == true then 
                        selected[k] = true
                    elseif type(v) == "string" then 
                        selected[v] = true 
                    end
                end
            end
        else
            if type(initial) == "string" and initial ~= "" then 
                selected[initial] = true 
            end
        end

        local function refreshText()
            local names = {}
            for _, o in ipairs(currentOptions) do 
                if selected[o.id] then 
                    table.insert(names, o.label) 
                end 
            end
            if #names == 0 then
                text.Text = placeholder or "None"
                text.TextColor3 = Theme.muted
            else
                local shown = names[1]
                if #names >= 2 then 
                    shown = names[1] .. ", " .. names[2] 
                end
                if #names > 2 then 
                    shown = shown .. " +" .. (#names - 2) 
                end
                text.Text = shown
                text.TextColor3 = Theme.text
            end
        end
        refreshText()

        btn.MouseButton1Click:Connect(function()
            if activePopup and activePopup.Name == label then 
                closePopup() 
                return 
            end
            closePopup()
            activePopupClose = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 901, Text = "" }, popupLayer)
            activePopupClose.MouseButton1Click:Connect(closePopup)

            local showSearch = isMulti or #currentOptions > 6
            local listH = math.clamp(#currentOptions * 28 + 8, 36, 168)
            local y0 = 8
            if showSearch then 
                y0 += 36 
            end
            if isMulti then 
                y0 += 34 
            end
            local totalH = y0 + listH + 4

            local pos = btn.AbsolutePosition
            local w = btn.AbsoluteSize.X
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local y = pos.Y + btn.AbsoluteSize.Y + 4
            if y + totalH > vp.Y - 8 then 
                y = math.max(8, pos.Y - totalH - 4) 
            end

            local popup = new("Frame", {
                Name = label, Size = UDim2.fromOffset(w, totalH), Position = UDim2.fromOffset(pos.X, y),
                BackgroundColor3 = Theme.bg, BorderSizePixel = 0, ZIndex = 902,
            }, popupLayer)
            corner(popup, 8)
            new("UIStroke", { Color = Theme.accent }, popup)
            activePopup = popup
            btnStroke.Color = Theme.accent
            chev.Text = "^"

            local items = {}
            local searchBox = nil
            local cy = 8

            if showSearch then
                local sf = new("Frame", { Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, cy), BackgroundColor3 = Theme.track, BorderSizePixel = 0 }, popup)
                corner(sf, 6)
                searchBox = new("TextBox", {
                    Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0),
                    BackgroundTransparency = 1, Text = "", PlaceholderText = "Search...",
                    PlaceholderColor3 = Theme.muted, TextColor3 = Theme.text,
                    Font = FONT_MED, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                }, sf)
                cy += 36
            end

            local function paint(e)
                local on = selected[e.id] == true
                if isMulti then
                    e.box.BackgroundColor3 = on and Theme.accent or Theme.track
                    e.mark.Visible = on
                else
                    e.bar.Visible = on
                end
                e.lbl.TextColor3 = on and Theme.accent or Theme.text
            end

            local function bulk(state)
                for _, e in ipairs(items) do
                    if e.row.Visible then 
                        selected[e.id] = state
                        paint(e) 
                    end
                end
                refreshText()
                if isMulti then
                    local map = {}
                    for k, v in pairs(selected) do 
                        if v then 
                            map[k] = true 
                        end 
                    end
                    onChanged(map)
                else
                    local arr = {}
                    for k, v in pairs(selected) do 
                        if v then 
                            table.insert(arr, k) 
                        end 
                    end
                    onChanged(arr[1])
                end
            end

            if isMulti then
                local half = UDim2.new(0.5, -12, 0, 26)
                local selAll = new("TextButton", { Size = half, Position = UDim2.fromOffset(8, cy), BackgroundColor3 = Theme.track, BorderSizePixel = 0, Text = "Select all", Font = FONT_MED, TextSize = 12, TextColor3 = Theme.text }, popup)
                corner(selAll, 6)
                selAll.MouseButton1Click:Connect(function() 
                    bulk(true) 
                end)
                local clr = new("TextButton", { Size = half, Position = UDim2.new(0.5, 4, 0, cy), BackgroundColor3 = Theme.track, BorderSizePixel = 0, Text = "Clear all", Font = FONT_MED, TextSize = 12, TextColor3 = Theme.text }, popup)
                corner(clr, 6)
                clr.MouseButton1Click:Connect(function() 
                    bulk(false) 
                end)
                cy += 34
            end

            local list = new("ScrollingFrame", {
                Size = UDim2.new(1, -8, 0, listH), Position = UDim2.fromOffset(4, cy),
                BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.accent,
                CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            }, popup)
            new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
            new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, list)

            for idx, o in ipairs(currentOptions) do
                local row = new("TextButton", { Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = idx }, list)
                local e = { id = o.id, row = row, lower = string.lower(o.label) }
                if isMulti then
                    e.box = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 8, 0.5, -8), BackgroundColor3 = Theme.track, BorderSizePixel = 0 }, row)
                    corner(e.box, 4)
                    new("UIStroke", { Color = Theme.track }, e.box)
                    e.mark = new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "✓", Font = FONT_BOLD, TextSize = 12, TextColor3 = Theme.bg, Visible = false }, e.box)
                else
                    e.bar = new("Frame", { Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Theme.accent, BorderSizePixel = 0, Visible = false }, row)
                    corner(e.bar, 2)
                end
                e.lbl = new("TextLabel", { Size = UDim2.new(1, isMulti and -36 or -20, 1, 0), Position = UDim2.fromOffset(isMulti and 32 or 14, 0), BackgroundTransparency = 1, Text = o.label, Font = FONT_MED, TextSize = 12, TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
                paint(e)
                table.insert(items, e)

                row.MouseButton1Click:Connect(function()
                    if isMulti then
                        selected[e.id] = not selected[e.id]
                        paint(e)
                        refreshText()
                        local map = {}
                        for k, v in pairs(selected) do 
                            if v then 
                                map[k] = true 
                            end 
                        end
                        onChanged(map)
                    else
                        for k in pairs(selected) do 
                            selected[k] = nil 
                        end
                        selected[e.id] = true
                        refreshText()
                        onChanged(e.id)
                        closePopup()
                    end
                end)
            end

            if searchBox then
                searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                    local q = string.lower(searchBox.Text)
                    for _, e in ipairs(items) do 
                        e.row.Visible = (q == "") or (string.find(e.lower, q, 1, true) ~= nil) 
                    end
                end)
            end
        end)

        local dd = {}
        function dd.SetOptions(newOptions)
            currentOptions = newOptions or {}
            local valid = {}
            for _, o in ipairs(currentOptions) do 
                valid[o.id] = true 
            end
            for id in pairs(selected) do 
                if not valid[id] then 
                    selected[id] = nil 
                end 
            end
            if activePopup and activePopup.Name == label then 
                closePopup() 
            end
            refreshText()
        end
        function dd.SetValue(value)
            table.clear(selected)
            local exists = false
            for _, option in ipairs(currentOptions) do
                if option.id == value then
                    exists = true
                    break
                end
            end
            if exists then selected[value] = true end
            if activePopup and activePopup.Name == label then
                closePopup()
            end
            refreshText()
        end
        return dd
    end

