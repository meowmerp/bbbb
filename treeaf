    local function bindCharacter(character)
        task.defer(function()
            if unloaded then 
                return 
            end
            applyWalkSpeed()
            if Flags.Fly then 
                setFly(true) 
            end
        end)
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if humanoid then
            bind(humanoid:GetPropertyChangedSignal("WalkSpeed"), function()
                if Flags.WalkSpeedEnabled and not unloaded then
                    if humanoid.WalkSpeed ~= Flags.WalkSpeed then 
                        humanoid.WalkSpeed = Flags.WalkSpeed 
                    end
                end
            end)
            bind(humanoid.Died, function()
                if Game.bossEncounterActive and Game.bossReturnPosition then
                    Game.bossPlayerDied = true
                    Game.bossRespawnTeleportPending = true
                    notify("Boss defeated your character; saved the boss-area return point for respawn.")
                end
            end)
        end
        if Game.bossRespawnTeleportPending and Game.bossReturnPosition then
            task.spawn(function()
                local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 8)
                local newHumanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
                if not unloaded and root and root:IsA("BasePart") and newHumanoid and newHumanoid.Health > 0 then
                    task.wait(0.25)
                    local returnPosition = Game.bossReturnPosition
                    if returnPosition then
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.CFrame = CFrame.new(returnPosition)
                        Game.status = "Returned to boss area; waiting for boss respawn"
                        notify("Teleported back to the boss area. Waiting for the boss to respawn.")
                    end
                end
                Game.bossRespawnTeleportPending = false
            end)
        end
    end

